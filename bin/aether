#!/bin/bash
set -e

VERSION="1.5.0"

# Pre-1.0 locations. Kept only so migration and uninstall can find and clear
# what an older install left behind; nothing writes here any more.
LEGACY_HOOK_DIR="$HOME/.local/share/aether"
LEGACY_GLOBAL_MANIFEST="$HOME/.claude/aether.manifest"
LEGACY_LOCAL_MANIFEST=".claude/aether.manifest"
LEGACY_LOCAL_HOOKS=".claude/hooks"

# Fallback only. The live list comes from _plugins_available(), which reads the
# manifests, so a new plugin appears in `aether status` by existing.
PLUGINS="bonsai whetstone temper cairn"

usage() {
  cat << 'EOF'
aether — manage your aether suite install

Usage:
  aether install [plugin...] [global] [--claude-md] [--no-bonsai]
                                        Install the suite, or named plugins
  aether status                         Show install state for all plugins
  aether status --notes                 Nudges the hook's budget held back
  aether config show [section]          Resolved values, where each came from
  aether config explain <section>.<key> One key in full
  aether check [path...] [--all] [--raw]
                                        Run this project's [project] commands,
                                        per monorepo area
  aether project for <file...>          Which areas those files belong to
  aether plan [status|path|hash]        The plan the gate sees, and its critique state
  aether doctor [--fix] [--deep]        Check the install, config and trust
  aether docs                           Check the docs against the code and config
                                        against what the manifests declare
  aether config doctor                  Just the config and trust half
  aether config set <section>.<key> <v> [global]
  aether config path|edit [global]      Print or open the config file
  aether migrate                        Move a pre-1.0 layout into ~/.aether/
  aether trust [status|list|forget|prune]
                                        Allow this project's [project] commands
                                        and rules.md to be used
  aether rules                          Print the prose the critics will read
  aether enable  [local|global]         Enable all plugins (default: local)
  aether disable [local|global]         Disable all plugins
  aether update                         git pull the clone and re-run its installer
  aether version                        Print the installed version
  aether uninstall [global] [--claude-md]  Remove suite hook, CLI, optional CLAUDE.md block
  aether help                           Show this message

Examples:
  aether status
  aether config show temper
  aether config set temper.auto_nudge_lines 400 global
  aether disable global
  aether enable local
  aether uninstall global --claude-md
EOF
}

_config_get() {
  local file="$1" key="$2"
  [ -f "$file" ] && grep "^$key:" "$file" | sed "s/^$key: *//" | head -1 || true
}

_config_set() {
  local file="$1" key="$2" value="$3"
  if [ -f "$file" ] && grep -q "^$key:" "$file"; then
    awk -v k="$key" -v v="$value" '$0 ~ "^"k":" {print k": "v; next} {print}' \
      "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  else
    mkdir -p "$(dirname "$file")"
    printf '%s: %s\n' "$key" "$value" >> "$file"
  fi
}

_hook_registered() {
  [ -f "$(_settings global)" ] && grep -q "enforce-suite" "$(_settings global)" 2>/dev/null
}

_manifest_get() {
  local key="$1"
  local manifest=""
  for m in "$LEGACY_GLOBAL_MANIFEST" "$(_manifest_for global)" \
           "$LEGACY_LOCAL_MANIFEST"  "$(_manifest_for local)"; do
    [ -f "$m" ] && manifest="$m"
  done
  [ -z "$manifest" ] && return 0
  grep "^$key=" "$manifest" | sed "s/^$key=//" | head -1 || true
}

# ═══════════════════════════════════════════════════════════════════════════
# ENGINE
#
# One implementation of install and uninstall, driven by plugins/<name>/
# aether.plugin. Replaces five installers and five uninstallers that expressed
# the same five operations — copy a file, copy a tree, symlink, upsert a JSON
# key, splice a sentinel block — over per-plugin data.
#
# Uninstall reads the same manifest in reverse, which is what makes the
# install/uninstall asymmetries structurally impossible rather than merely
# fixed. Four had drifted: temper's uninstaller never removed its commands,
# cairn's never removed its permissions.
# ═══════════════════════════════════════════════════════════════════════════

# ── Where the clone is ───────────────────────────────────────────────────────
# Running from the clone (install.sh execs us) the repo is two levels up.
# Running installed, the manifest recorded it.
_repo_root() {
  local here
  # An explicit override wins: it makes the engine testable without a real
  # install, and lets a shim name a clone it was not copied out of.
  [ -n "${AETHER_REPO:-}" ] && [ -d "$AETHER_REPO/plugins" ] \
    && { printf '%s' "$AETHER_REPO"; return 0; }
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  if [ -d "$here/../plugins" ]; then
    (cd "$here/.." && pwd -P); return 0
  fi
  local recorded; recorded=$(_manifest_get "repo") || recorded=""
  [ -n "$recorded" ] && [ -d "$recorded/plugins" ] && { printf '%s' "$recorded"; return 0; }
  return 1
}

# ── Manifest reader ──────────────────────────────────────────────────────────
# Plain grep/sed, deliberately: no python3, node or jq is needed to work out
# what to install. Only the settings.json steps need an interpreter, which is
# the same degradation the hand-written installers had.
# Plain awk per lookup. A variant that loaded every manifest into one shell
# variable and answered with parameter expansion was tried and reverted: it cut
# awk invocations from 225 to 73 for `aether config show` and made it 2.5×
# SLOWER, because `${all#*"$needle"}` over a 400-line string, ~150 times, is
# quadratic in bash. Fewer processes is not the same as less work.
_mf() {
  local plugin="$1" key="$2" repo
  repo=$(_repo_root) || return 1
  local f="$repo/plugins/$plugin/aether.plugin"
  [ -f "$f" ] || return 1
  awk -v k="$key" 'index($0, k ":") == 1 {
    v = substr($0, length(k) + 2); sub(/^[[:space:]]+/, "", v); print v; exit }' "$f"
}


# Every plugin with a manifest in the clone. Replaces the hardcoded
# PLUGINS="bonsai whetstone temper cairn", so a new plugin appears in
# `aether status` by existing.
_plugins_available() {
  local repo; repo=$(_repo_root) || return 0
  local d
  for d in "$repo"/plugins/*/aether.plugin; do
    [ -f "$d" ] || continue
    basename "$(dirname "$d")"
  done
}

# ── Scope resolver ───────────────────────────────────────────────────────────
# The single place a scope becomes a path. Scope handling was got wrong twice
# in the previous release — `aether uninstall` and all three plugin `update`s —
# because every call site re-derived these by hand.
# ── Sectioned config ─────────────────────────────────────────────────────────
# The reader lives in hooks/aether-config.sh because the gates need it too, and
# they cannot source anything out of the clone. One parser, two callers.
for _lib in "$(dirname "${BASH_SOURCE[0]}")/../hooks/aether-config.sh" \
            "${AETHER_HOME:-$HOME/.aether}/hooks/aether-config.sh" \
            ".aether/hooks/aether-config.sh"; do
  # shellcheck source=/dev/null
  [ -f "$_lib" ] && { . "$_lib"; break; }
done
if ! command -v aether_cfg_get >/dev/null 2>&1; then
  # Degrade rather than die: an install can still place files, it just cannot
  # read anyone's settings. The paths must still resolve or nothing works.
  printf 'aether: cannot find aether-config.sh; config values fall back to defaults.\n' >&2
  aether_root()       { [ "$1" = global ] && printf '%s' "${AETHER_HOME:-$HOME/.aether}" || printf '.aether'; }
  aether_cfg_file()   { printf '%s/config' "$(aether_root "$1")"; }
  aether_rules_file() { printf '%s/rules.md' "$(aether_root "$1")"; }
  aether_cfg_read()   { :; }
  aether_cfg_get()    { :; }
fi
# Preload once, here, in the top-level shell. Every _cfg_get call site wraps it
# in $( ), which forks — so without this the dump was rebuilt for every key, and
# `aether config show` re-read both files ~36 times. Subshells inherit the
# variables, so one preload here serves all of them; a write invalidates it and
# the next read rebuilds.
command -v aether_cfg_preload >/dev/null 2>&1 && aether_cfg_preload

_cfg_read() { aether_cfg_read "$@"; }
_cfg_get()  { aether_cfg_get  "$@"; }

# Two roots, same name and same shape: ~/.aether globally, .aether in a project.
# $AETHER_HOME overrides the global one, for anyone who prefers ~/.config/aether.
#
# The split is deliberate. .claude/ holds what Claude Code itself reads —
# commands it globs, settings.json, skills, CLAUDE.md, and plan mode's plans/.
# .aether/ holds what aether owns. Hook *scripts* move here because settings.json
# references them by absolute path, so they can live anywhere; that also retires
# ~/.local/share/aether and fixes an asymmetry where the global hook and the
# local hook had different parents.
_root()         { aether_root "$1"; }
_hook_dir()     { printf '%s/hooks' "$(_root "$1")"; }
_gates_dir()    { printf '%s/hooks/gates' "$(_root "$1")"; }
_plugin_hooks() { printf '%s/hooks/plugin-hooks' "$(_root "$1")"; }
_cfg_file()     { aether_cfg_file "$1"; }
_rules_file()   { aether_rules_file "$1"; }
_out_dir()      { printf '%s/out' "$(_root "$1")"; }
_manifest_for() { printf '%s/manifest' "$(_root "$1")"; }
_trust_file()   { printf '%s/trusted' "$(_root global)"; }

# Claude Code's own directories, unchanged.
_claude_dir()   { [ "$1" = global ] && printf '%s' "$HOME/.claude"        || printf '.claude'; }
_commands_dir() { printf '%s/commands' "$(_claude_dir "$1")"; }
_settings()     { printf '%s/settings.json' "$(_claude_dir "$1")"; }
_claude_md()    { [ "$1" = global ] && printf '%s' "$HOME/.claude/CLAUDE.md" || printf './CLAUDE.md'; }
_cli_dir()      { [ "$1" = global ] && printf '%s' "$HOME/.local/bin"     || printf '.bin'; }


# _cfg_set <file> <section> <key> <value> [doc]
# Rewrites only the line it targets, so comments, ordering and unrelated
# sections survive. Creates the section if absent. When creating a key (never
# when updating one) it writes the doc line above it, so a file explains itself
# to whoever opens it next.
_cfg_set() {
  command -v aether_cfg_invalidate >/dev/null 2>&1 && aether_cfg_invalidate
  local file="$1" section="$2" key="$3" value="$4" doc="${5:-}"
  _dry && { printf '    would set %s%s: %s in %s\n' \
    "${section:+[$section] }" "$key" "$value" "$file"; return 0; }
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || : > "$file"
  # v and doc come through the environment, not -v. `awk -v` performs escape
  # processing on its argument, so a value containing a backslash was silently
  # rewritten: critical_paths lost the backslash from `\.sql` and `\.env`, and a
  # regex like `\d+` in [git] ticket became `d+`. That corrupted `config set` and,
  # worse, migration — which carries the pre-1.0 critical_paths across verbatim.
  AETHER_V="$value" AETHER_DOC="$doc" \
  awk -v sec="$section" -v k="$key" '
    BEGIN { v = ENVIRON["AETHER_V"]; doc = ENVIRON["AETHER_DOC"] }
    function emit() {
      if (doc != "") print "# " doc
      print k ": " v
      done = 1
    }
    # One line of lookahead. A comment is only a key\x27s documentation if it sits
    # directly above it, so it is held for exactly one line before being flushed.
    function flush() { if (prev != "") { print prev; prev = "" } }
    { sub(/\r$/, "") }            # normalise CRLF, as the reader does
    # Blank lines are held so an inserted key lands at the end of its section
    # rather than after the blank line that separates it from the next one.
    /^[[:space:]]*$/ { flush(); if (!done) { held = held $0 "\n"; next } }
    /^\[.*\]$/ {
      flush()
      if (cur == sec && !done) emit()
      printf "%s", held; held = ""
      cur = substr($0, 2, length($0) - 2)
      print; next
    }
    {
      printf "%s", held; held = ""
      line = $0; sub(/^[[:space:]]+/, "", line)
      if (line ~ /^#/) { flush(); prev = $0; next }
      if (!done && cur == sec && index(line, k ":") == 1) {
        # Replace the old doc line rather than stranding it above the next key.
        if (doc != "") { print "# " doc; prev = "" } else flush()
        print k ": " v; done = 1; next
      }
      flush()
      print
    }
    END {
      flush()
      if (!done && cur == sec) { emit(); printf "%s", held; held = "" }
      printf "%s", held
      if (!done) {
        if (sec != "") { if (NR > 0) print ""; print "[" sec "]" }
        emit()
      }
    }' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# _cfg_unset <file> <section> <key> — delete one line, leave the rest alone
_cfg_unset() {
  command -v aether_cfg_invalidate >/dev/null 2>&1 && aether_cfg_invalidate
  local file="$1" section="$2" key="$3"
  [ -f "$file" ] || return 0
  _dry && { printf '    would unset %s%s in %s\n' "${section:+[$section] }" "$key" "$file"; return 0; }
  awk -v sec="$section" -v k="$key" '
    { sub(/\r$/, "") }
    /^\[.*\]$/ { cur = substr($0, 2, length($0) - 2); print; next }
    {
      line = $0; sub(/^[[:space:]]+/, "", line)
      if (cur == sec && index(line, k ":") == 1 && line !~ /^#/) next
      print
    }' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# ── Primitives ───────────────────────────────────────────────────────────────
# Non-fatal by design. These run under `set -e`, partway through an install; a
# single unwritable file must not abort and leave a half-configured machine.

# DRY_RUN is honoured in the primitives rather than at each call site: all
# mutation funnels through these five plus the JSON helpers, so one guard each
# covers the engine.
_dry() { [ "${DRY_RUN:-false}" = true ]; }

# Announce a completed step. Under --dry-run the same message is marked as not
# applied, because "✓ hook registered" in a dry run is simply untrue.
_ok() {
  if _dry; then printf '  · %s — not applied\n' "$*"
  else printf '  ✓ %s\n' "$*"; fi
}

# Replaces by rename, never in place.
#
# `cp` truncates and rewrites the destination, and bash reads a script
# incrementally as it executes. So `aether update` — which runs from
# ~/.local/bin/aether and copies a new bin/aether over it — shifted the byte
# offsets under the interpreter, and bash resumed mid-token:
# `syntax error near unexpected token ';;'`, from inside the dispatcher's case,
# after the install had otherwise finished successfully.
#
# A rename swaps the directory entry and leaves the original inode alone, so a
# process already executing the old file runs to completion on it. This is why
# every copy goes through a temp file in the destination directory — same
# filesystem, so the rename is atomic.
_op_copy() {
  local src="$1" dst="$2" tmp
  _dry && { printf '  [dry-run] copy %s\n' "$dst"; return 0; }
  mkdir -p "$(dirname "$dst")" 2>/dev/null || true
  tmp="$dst.aether-tmp.$$"
  if cp "$src" "$tmp" 2>/dev/null; then
    [ -x "$src" ] && chmod +x "$tmp" 2>/dev/null || true
    if mv -f "$tmp" "$dst" 2>/dev/null; then return 0; fi
  fi
  rm -f "$tmp" 2>/dev/null || true
  printf '  ! could not write %s\n' "$dst"; return 1
}

_op_copy_tree() {
  local src="$1" dst="$2"
  _dry && { printf '  [dry-run] copy tree %s\n' "$dst"; return 0; }
  mkdir -p "$dst" 2>/dev/null || true
  if command -v rsync >/dev/null 2>&1; then
    rsync -r "$src/" "$dst/" 2>/dev/null && return 0
  else
    cp -R "$src/." "$dst/" 2>/dev/null && return 0
  fi
  printf '  ! could not copy tree to %s\n' "$dst"; return 1
}

_op_link() {
  local src="$1" dst="$2"
  _dry && { printf '  [dry-run] link %s\n' "$dst"; return 0; }
  mkdir -p "$(dirname "$dst")" 2>/dev/null || true
  ln -sf "$src" "$dst" 2>/dev/null && return 0
  printf '  ! could not link %s\n' "$dst"; return 1
}

_op_rm() {
  local target="$1"
  [ -e "$target" ] || return 0
  _dry && { printf '  [dry-run] remove %s\n' "$target"; return 0; }
  rm -rf "$target" 2>/dev/null && { printf '  ✓ removed %s\n' "$target"; return 0; }
  printf '  ! could not remove %s\n' "$target"; return 1
}

# Splice a sentinel-delimited block into a markdown file, replacing any existing
# one. Replacing rather than skipping is what lets a template change reach an
# existing install — skipping froze the block at whatever version wrote it first.
_op_splice() {
  local file="$1" marker="$2" content_file="$3" wrap="$4"
  _dry && { printf '  [dry-run] write %s block into %s\n' "$marker" "$file"; return 0; }
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  [ -f "$file" ] || : > "$file"
  if grep -q "<!-- ${marker}:start -->" "$file" 2>/dev/null; then
    awk "/<!-- ${marker}:start -->/{skip=1} !skip{print} /<!-- ${marker}:end -->/{skip=0}" \
      "$file" > "$file.tmp" 2>/dev/null && mv "$file.tmp" "$file"
  fi
  # Drop trailing blank lines before re-appending. The removal above takes the
  # block but not the blank line that separated it, and the append below adds a
  # fresh one — so every re-install grew CLAUDE.md by exactly one line, forever.
  # Stripping first makes the whole operation idempotent.
  awk '{ l[NR] = $0 }
       END { last = NR
             while (last > 0 && l[last] ~ /^[[:space:]]*$/) last--
             for (i = 1; i <= last; i++) print l[i] }' \
    "$file" > "$file.tmp" 2>/dev/null && mv "$file.tmp" "$file"
  {
    # One separating blank line, and only when there is something to separate from.
    [ -s "$file" ] && printf '\n'
    if [ "$wrap" = wrap ]; then
      printf '<!-- %s:start -->\n' "$marker"
      cat "$content_file"
      printf '<!-- %s:end -->\n' "$marker"
    else
      cat "$content_file"
    fi
  } >> "$file"
}

_op_unsplice() {
  local file="$1" marker="$2"
  [ -f "$file" ] || return 0
  _dry && { printf '  [dry-run] remove %s block from %s\n' "$marker" "$file"; return 0; }
  grep -q "<!-- ${marker}:start -->" "$file" 2>/dev/null || return 0
  awk "/<!-- ${marker}:start -->/{skip=1} !skip{print} /<!-- ${marker}:end -->/{skip=0}" \
    "$file" > "$file.tmp" 2>/dev/null && mv "$file.tmp" "$file"
  printf '  ✓ removed %s block from %s\n' "$marker" "$file"
}

# ── Hook registration ────────────────────────────────────────────────────────
# Generalised from _json_register_suite_hook: any phase, any matcher. The old
# installers each had their own variant with the phase and matcher hardcoded,
# which is how cairn ended up with a python3-only _json_add_post_hook that
# silently never fired on a node-or-jq-only machine.
_json_register_hook() {
  local file="$1" phase="$2" matcher="$3" path="$4" prepend="${5:-}"
  _dry && return 0
  # Deregister any other registration of a script with this basename first.
  # A hook that moved leaves its old entry behind, and both then fire: a machine
  # that once had cairn installed standalone ended up running post-cairn.sh
  # twice, from ~/.local/share/cairn/ and from the new location. Keying on the
  # basename makes registration idempotent across every relocation, rather than
  # needing a list of the places a script has ever lived.
  _json_drop_hooks_matching "$file" "/$(basename "$path")" 2>/dev/null || true
  command -v python3 >/dev/null 2>&1 || { command -v node >/dev/null 2>&1 || return 1; }
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$phase" "$matcher" "$path" "$prepend" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, phase, matcher, path, prepend = sys.argv[1:6]
with open(f) as fh: s = json.load(fh)
lst = s.setdefault("hooks", {}).setdefault(phase, [])
# Drop any previous registration of this exact script, whatever its matcher —
# a plugin that changes its matcher must not leave the old entry behind.
for e in lst:
    e["hooks"] = [h for h in e.get("hooks", []) if h.get("command") != path]
lst[:] = [e for e in lst if e.get("hooks")]
entry = next((e for e in lst if e.get("matcher") == matcher), None)
if entry is None:
    entry = {"matcher": matcher, "hooks": []}
    lst.insert(0, entry) if prepend else lst.append(entry)
entry["hooks"].append({"type": "command", "command": path})
print(json.dumps(s, indent=2))
PYEOF
  else
    node - "$file" "$phase" "$matcher" "$path" "$prepend" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, phase, matcher, path, prepend] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
s.hooks = s.hooks || {}; const lst = s.hooks[phase] = s.hooks[phase] || [];
for (const e of lst) e.hooks = (e.hooks || []).filter(h => h.command !== path);
s.hooks[phase] = lst.filter(e => e.hooks.length);
let entry = s.hooks[phase].find(e => e.matcher === matcher);
if (!entry) { entry = { matcher, hooks: [] }; prepend ? s.hooks[phase].unshift(entry) : s.hooks[phase].push(entry); }
entry.hooks.push({ type: "command", command: path });
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
  fi
}

_json_deregister_hook() {
  local file="$1" needle="$2"
  _dry && return 0
  [ -f "$file" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$file" "$needle" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, needle = sys.argv[1], sys.argv[2]
with open(f) as fh: s = json.load(fh)
for phase in ("PreToolUse", "PostToolUse"):
    lst = s.get("hooks", {}).get(phase, [])
    for e in lst:
        e["hooks"] = [h for h in e.get("hooks", []) if needle not in h.get("command", "")]
    if phase in s.get("hooks", {}):
        s["hooks"][phase] = [e for e in lst if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
}

# Install and register every hook a manifest declares.
# A suite_owned hook is skipped under the suite: enforce-suite.sh sources that
# gate instead, so registering it too would double-fire every check.
_engine_hooks() {
  local plugin="$1" scope="$2" suite_mode="$3" proot="$4"
  local settings; settings=$(_settings "$scope")
  local hookdir;  hookdir="$(_plugin_hooks "$scope")"
  local strategy; strategy=$(_mf "$plugin" hooks.strategy); strategy="${strategy:-copy}"
  local n line
  for n in 1 2 3 4; do
    line=$(_mf "$plugin" "hook.$n") || true
    [ -n "$line" ] || continue
    # Split on " | ". The separator is a bracket expression, not \| — BSD awk
    # reads a backslash-escaped pipe in -F as alternation and returns five
    # fields instead of three. Spacing is variable in the manifests, so the
    # separator requires at least one space on each side: a matcher's escaped
    # pipes (Bash\|Write) have none, so they survive. The matcher keeps them until
    # the sed below unescapes them.
    local phase matcher script flags _fs=' +[|] +'
    phase=$(printf   '%s' "$line" | awk -v FS="$_fs" '{print $1}')
    matcher=$(printf '%s' "$line" | awk -v FS="$_fs" '{print $2}' | sed 's/\\|/|/g')
    script=$(printf  '%s' "$line" | awk -v FS="$_fs" '{print $3}')
    flags=$(printf   '%s' "$line" | awk -v FS="$_fs" '{print $4}')
    case " $flags " in *" suite_owned "*) [ "$suite_mode" = 1 ] && continue ;; esac
    local target
    if [ "$strategy" = link ]; then
      target="$proot/$script"
      chmod +x "$target" 2>/dev/null || true
    else
      target="$hookdir/$(basename "$script")"
      _op_copy "$proot/$script" "$target" || continue
    fi
    local prepend=""; case " $flags " in *" prepend "*) prepend=1 ;; esac
    _json_register_hook "$settings" "$phase" "$matcher" "$target" "$prepend" \
      && _ok "$(printf '%s %s hook registered' "$plugin" "$phase")"
  done
}

# ── Per-plugin install ───────────────────────────────────────────────────────
# suite_mode=1 means enforce-suite.sh will source this plugin's gate, so its own
# PreToolUse registration and its own CLAUDE.md block are both skipped.
_engine_install() {
  local plugin="$1" scope="$2" suite_mode="${3:-0}" repo
  repo=$(_repo_root) || { printf '  ✗ cannot locate the aether clone\n'; return 1; }
  local proot="$repo/plugins/$plugin"

  # Scope support — bonsai is global-only; every path it writes is $HOME-rooted.
  local scopes; scopes=$(_mf "$plugin" scopes)
  case " $scopes " in *" $scope "*) ;; *)
    printf '  %s: skipped — no %s scope\n' "$plugin" "$scope"; return 0 ;;
  esac

  # Prerequisites, before anything is written.
  local req; req=$(_mf "$plugin" requires)
  local missing=""
  for r in $req; do command -v "$r" >/dev/null 2>&1 || missing="$missing $r"; done
  if [ -n "$missing" ]; then
    printf '  %s: skipped — needs%s\n' "$plugin" "$missing"
    printf '          install them, then: aether install %s\n' "$plugin"
    return 2
  fi

  # Build.
  local build; build=$(_mf "$plugin" build)
  if [ -n "$build" ] && [ -f "$proot/$build" ]; then
    # The one escape hatch that runs arbitrary commands, so it needs its own
    # guard: --dry-run was invoking bonsai's `uv sync` and `npm run build` for
    # real, which writes to ~/.cache and ~/.npm. The five primitives are guarded
    # centrally; this is not one of them.
    if _dry; then
      printf '  [dry-run] would run %s\n' "$build"
    else
      printf '  %s: building, this takes a minute...\n' "$plugin"
      bash "$proot/$build" >/dev/null 2>&1 \
        || { printf '  ✗ %s build failed\n' "$plugin"; return 1; }
    fi
  fi

  local cdir; cdir=$(_commands_dir "$scope")
  local asset_failed=0

  # Commands, and the ones this plugin used to ship. An orphaned command file is
  # not inert: it stays in the palette and still runs the stale copy.
  local c
  for c in $(_mf "$plugin" legacy_commands); do
    [ -f "$cdir/$c" ] || continue
    cp "$cdir/$c" "$cdir/$c.bak" 2>/dev/null && _op_rm "$cdir/$c" >/dev/null \
      && printf '  ✓ removed superseded %s (kept a .bak)\n' "$cdir/$c" \
      || printf '  ! Could not remove superseded %s\n' "$cdir/$c"
  done
  for c in $(_mf "$plugin" commands); do
    _op_copy "$proot/.claude/commands/$c" "$cdir/$c" || asset_failed=1
  done

  # Skills.
  local s
  for s in $(_mf "$plugin" skills); do
    _op_copy_tree "$proot/skills/$s" "$(_claude_dir "$scope")/skills/$s" || true
  done

  # CLI.
  local cli; cli=$(_mf "$plugin" cli)
  if [ -n "$cli" ]; then
    local cli_scopes; cli_scopes=$(_mf "$plugin" cli.scopes); cli_scopes="${cli_scopes:-local global}"
    case " $cli_scopes " in *" $scope "*)
      if [ "$(_mf "$plugin" cli.strategy)" = link ]; then
        _op_link "$proot/bin/$cli" "$(_cli_dir "$scope")/$cli" || asset_failed=1
      else
        _op_copy "$proot/bin/$cli" "$(_cli_dir "$scope")/$cli" || asset_failed=1
      fi ;;
    esac
  fi

  # CLAUDE.md — skipped under the suite, whose unified block supersedes it.
  if [ "$suite_mode" = 0 ] && [ "${WITH_CLAUDE_MD:-false}" = true ]; then
    local tpl; tpl=$(_mf "$plugin" template)
    if [ -n "$tpl" ] && [ -f "$proot/$tpl" ]; then
      local wrap=nowrap
      [ "$(_mf "$plugin" template.has_own_sentinels)" = false ] && wrap=wrap
      _op_splice "$(_claude_md "$scope")" "$(_mf "$plugin" template.sentinel)" "$proot/$tpl" "$wrap"
      _ok "$(printf '%s CLAUDE.md block written' "$plugin")"
    fi
  fi

  _engine_hooks "$plugin" "$scope" "$suite_mode" "$proot"

  # A missing command file or CLI is a real failure, not a warning. The old
  # installers reported success unconditionally, which is how a total failure
  # still printed a green tick.
  if [ "$asset_failed" -ne 0 ]; then
    printf '  ✗ %s failed to install — an asset could not be written\n' "$plugin"
    return 1
  fi
  _ok "$(printf '%s installed' "$plugin")"
  return 0
}

# ── Per-plugin uninstall ─────────────────────────────────────────────────────
# Same manifest, read in reverse.
_engine_uninstall() {
  local plugin="$1" scope="$2" repo
  repo=$(_repo_root) || return 1
  local cdir; cdir=$(_commands_dir "$scope")
  local c

  for c in $(_mf "$plugin" commands) $(_mf "$plugin" legacy_commands); do
    _op_rm "$cdir/$c" >/dev/null 2>&1 && printf '  ✓ removed %s\n' "$cdir/$c"
  done
  for s in $(_mf "$plugin" skills); do
    _op_rm "$(_claude_dir "$scope")/skills/$s"
  done
  local cli; cli=$(_mf "$plugin" cli)
  [ -n "$cli" ] && _op_rm "$(_cli_dir "$scope")/$cli"
  _json_deregister_hook "$(_settings "$scope")" "enforce-$plugin.sh" 2>/dev/null || true
  _json_deregister_hook "$(_settings "$scope")" "post-$plugin.sh" 2>/dev/null || true
  _op_rm "$(_plugin_hooks "$scope")/enforce-$plugin.sh" >/dev/null 2>&1 || true
  _op_rm "$(_plugin_hooks "$scope")/post-$plugin.sh" >/dev/null 2>&1 || true

  local sentinel; sentinel=$(_mf "$plugin" template.sentinel)
  [ -n "$sentinel" ] && _op_unsplice "$(_claude_md "$scope")" "$sentinel"
  for sentinel in $(_mf "$plugin" template.legacy_sentinels); do
    _op_unsplice "$(_claude_md "$scope")" "$sentinel"
  done
  return 0
}

# ── settings.json helpers ────────────────────────────────────────────────────
# Ported verbatim from install.sh. _json_backend / AETHER_JSON_BACKEND is the
# only 3-interpreter chain in the suite with test coverage — the per-plugin
# installers each had their own, and cairn's was python3-only, so its
# PostToolUse hook silently never registered on a node-or-jq-only machine.

_backup() {
  local file="$1"
  [ -f "$file" ] || return 0
  cp "$file" "$file.bak"
}

_json_backend() {
  if [ -n "${AETHER_JSON_BACKEND:-}" ]; then printf '%s' "$AETHER_JSON_BACKEND"; return 0; fi
  if   command -v python3 &>/dev/null; then printf 'python3'
  elif command -v node    &>/dev/null; then printf 'node'
  elif command -v jq      &>/dev/null; then printf 'jq'
  else printf 'none'; fi
}

# _json_drop_hooks_matching <settings> <substring>
#
# Removes any hook, in EITHER phase, whose command contains the substring, and
# drops entries left with no hooks. _json_remove_stale_hooks only ever cleaned
# PreToolUse, so upgrading left a PostToolUse entry pointing into the retired
# ~/.local/share/aether/ — a script Claude Code would then try to run on every
# Bash, Write and Edit call.
# _json_probe <settings.json> <claude.json>
#
# Everything the doctor needs out of both files, in one pass per backend, as
# tab-separated lines:
#
#   hook<TAB>phase<TAB>matcher<TAB>command
#   perm<TAB>value
#   mcp<TAB>name<TAB>command<TAB>arg arg …
#
# One reader rather than three, because three would mean nine backend branches
# for the same traversal. With no interpreter the doctor says so and skips the
# checks that need it, which is the same degradation the installer has.
_json_probe() {
  local settings="$1" claudejson="$2"
  case "$(_json_backend)" in
   python3)
    python3 - "$settings" "$claudejson" <<'PYEOF'
import json, sys
def load(p):
    try:
        with open(p) as fh: return json.load(fh)
    except Exception: return {}
s, c = load(sys.argv[1]), load(sys.argv[2])
for phase, entries in (s.get("hooks") or {}).items():
    for e in entries or []:
        for h in e.get("hooks") or []:
            print("hook\t%s\t%s\t%s" % (phase, e.get("matcher", ""), h.get("command", "")))
for v in ((s.get("permissions") or {}).get("allow") or []):
    print("perm\t%s" % v)
for name, cfg in (c.get("mcpServers") or {}).items():
    print("mcp\t%s\t%s\t%s" % (name, cfg.get("command", ""), " ".join(cfg.get("args") or [])))
PYEOF
    ;;
   node)
    node - "$settings" "$claudejson" <<'JSEOF'
const fs = require("fs");
const load = p => { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch (e) { return {}; } };
const [s, c] = [load(process.argv[2]), load(process.argv[3])];
for (const [phase, entries] of Object.entries(s.hooks || {}))
  for (const e of entries || [])
    for (const h of e.hooks || [])
      console.log(`hook\t${phase}\t${e.matcher || ""}\t${h.command || ""}`);
for (const v of (s.permissions || {}).allow || []) console.log(`perm\t${v}`);
for (const [name, cfg] of Object.entries(c.mcpServers || {}))
  console.log(`mcp\t${name}\t${cfg.command || ""}\t${(cfg.args || []).join(" ")}`);
JSEOF
    ;;
   jq)
    # Each `|| true`, and an explicit `return 0`: ~/.claude.json does not exist
    # until bonsai installs, and jq exits non-zero on a missing file. Without this
    # the caller read that as "cannot inspect settings.json" and skipped every hook
    # check — so on a jq-only machine the doctor quietly checked nothing. python3
    # and node swallow the missing file in their loaders.
    jq -r '(.hooks // {}) | to_entries[] as $p | $p.value[]? as $e | $e.hooks[]? |
           "hook\t" + $p.key + "\t" + ($e.matcher // "") + "\t" + (.command // "")' \
       "$settings" 2>/dev/null || true
    jq -r '((.permissions // {}).allow // [])[] | "perm\t" + .' "$settings" 2>/dev/null || true
    jq -r '((.mcpServers // {}) | to_entries[]) |
           "mcp\t" + .key + "\t" + (.value.command // "") + "\t" + ((.value.args // []) | join(" "))' \
       "$claudejson" 2>/dev/null || true
    return 0
    ;;
   *) return 1 ;;
  esac
}

_json_drop_hooks_matching() {
  local file="$1" needle="$2"
  _dry && return 0
  [ -f "$file" ] || return 0
  case "$(_json_backend)" in
   python3)
    python3 - "$file" "$needle" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, needle = sys.argv[1], sys.argv[2]
with open(f) as fh: s = json.load(fh)
for phase in ("PreToolUse", "PostToolUse"):
    entries = s.get("hooks", {}).get(phase)
    if not entries: continue
    for e in entries:
        e["hooks"] = [h for h in e.get("hooks", []) if needle not in h.get("command", "")]
    s["hooks"][phase] = [e for e in entries if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" "$needle" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, needle] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
for (const phase of ["PreToolUse", "PostToolUse"]) {
  const entries = (s.hooks || {})[phase];
  if (!entries) continue;
  for (const e of entries) e.hooks = (e.hooks || []).filter(h => !(h.command || "").includes(needle));
  s.hooks[phase] = entries.filter(e => e.hooks && e.hooks.length);
}
console.log(JSON.stringify(s, null, 2));
JSEOF
    ;;
   jq)
    # `.hooks` is absent in a settings.json that has only permissions, and
    # with_entries on null is an error, not a no-op — so guard on the type and
    # rewrite the two phases in place rather than rebuilding the object.
    jq --arg n "$needle" '
      if (.hooks | type) == "object" then
        .hooks |= with_entries(
          if (.key == "PreToolUse" or .key == "PostToolUse")
          then .value |= ([ .[] | .hooks |= [ .[] | select((.command // "") | contains($n) | not) ] ]
                          | map(select((.hooks | length) > 0)))
          else . end)
      else . end' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *) return 1 ;;
  esac
}

_json_remove_stale_hooks() {
  local file="$1"
  _dry && return 0
  case "$(_json_backend)" in
   python3)
    python3 - "$file" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f = sys.argv[1]
with open(f) as fh: s = json.load(fh)
STALE = ["enforce-cairn", "enforce-temper", "enforce-whetstone",
         "enforce-bonsai", "enforce-suite"]
entries = s.get("hooks", {}).get("PreToolUse", [])
for entry in entries:
    entry["hooks"] = [
        h for h in entry.get("hooks", [])
        if not any(kw in h.get("command", "") for kw in STALE)
    ]
if "hooks" in s and "PreToolUse" in s["hooks"]:
    s["hooks"]["PreToolUse"] = [e for e in entries if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const f = process.argv[2];
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
const STALE = ["enforce-cairn", "enforce-temper", "enforce-whetstone",
               "enforce-bonsai", "enforce-suite"];
if (s.hooks && s.hooks.PreToolUse) {
  s.hooks.PreToolUse = s.hooks.PreToolUse
    .map(e => ({ ...e, hooks: (e.hooks || []).filter(
      h => !STALE.some(kw => (h.command || "").includes(kw))) }))
    .filter(e => e.hooks.length);
}
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
    ;;
   jq)
    jq '
      def stale: ["enforce-cairn","enforce-temper","enforce-whetstone","enforce-bonsai","enforce-suite"];
      if (.hooks.PreToolUse | type) == "array" then
        .hooks.PreToolUse |= (
          map(.hooks |= (map(select(.command as $c | (stale | any(. as $k | $c | contains($k))) | not))))
          | map(select((.hooks | length) > 0))
        )
      else . end
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *)
    printf '  Could not clean stale hooks (install python3, node, or jq).\n'
    return 1
    ;;
  esac
}

# The union of every suite_owned PreToolUse matcher the manifests declare.
#
# It was hardcoded here, which meant widening a plugin's matcher in its manifest did
# nothing: `suite_owned` hooks are replaced by the suite hook, and the suite hook used
# this string. whetstone adding ExitPlanMode is the case that exposed it. Derived now,
# for the same reason PLUGINS= and the config schema are — one place to be correct.
#
# The order is fixed rather than first-seen, so the string is stable across a change to
# the plugin set and a test can assert it. Unknown tools are appended alphabetically.
_suite_matcher() {
  local repo plugin f line seen="" tool known="Bash Write Edit MultiEdit ExitPlanMode" out=""
  repo=$(_repo_root) || { printf 'Bash|Write|Edit|MultiEdit'; return 0; }
  for plugin in $(_plugins_available); do
    f="$repo/plugins/$plugin/aether.plugin"; [ -f "$f" ] || continue
    while IFS= read -r line; do
      case "$line" in *suite_owned*) ;; *) continue ;; esac
      case "$line" in *PreToolUse*) ;; *) continue ;; esac
      # field 2 of "hook.N: PreToolUse | <matcher> | script | flags"
      line=$(printf '%s' "$line" | awk -F' +[|] +' '{print $2}')
      seen="$seen $(printf '%s' "$line" | tr -d '\\' | tr '|' ' ')"
    done <<EOHK
$(grep '^hook\.' "$f" 2>/dev/null)
EOHK
  done
  for tool in $known; do
    case " $seen " in *" $tool "*) out="$out|$tool" ;; esac
  done
  for tool in $(printf '%s\n' $seen | sort -u); do
    case " $known " in *" $tool "*) continue ;; esac
    [ -n "$tool" ] && out="$out|$tool"
  done
  [ -n "$out" ] && printf '%s' "${out#|}" || printf 'Bash|Write|Edit|MultiEdit'
}

_json_register_suite_hook() {
  local file="$1" hook_path="$2"
  _dry && return 0
  local matcher; matcher=$(_suite_matcher)
  case "$(_json_backend)" in
   python3)
    python3 - "$file" "$hook_path" "$matcher" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, hook_path, matcher = sys.argv[1], sys.argv[2], sys.argv[3]
with open(f) as fh: s = json.load(fh)
hooks = s.setdefault("hooks", {})
pre = hooks.setdefault("PreToolUse", [])
entry = next((e for e in pre if e.get("matcher") == matcher), None)
if entry is None:
    entry = {"matcher": matcher, "hooks": []}
    pre.append(entry)
if not any(h.get("command") == hook_path for h in entry["hooks"]):
    entry["hooks"].append({"type": "command", "command": hook_path})
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" "$hook_path" "$matcher" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, hookPath, matcher] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
s.hooks = s.hooks || {};
s.hooks.PreToolUse = s.hooks.PreToolUse || [];
let entry = s.hooks.PreToolUse.find(e => e.matcher === matcher);
if (!entry) { entry = { matcher, hooks: [] }; s.hooks.PreToolUse.push(entry); }
entry.hooks = entry.hooks || [];
if (!entry.hooks.some(h => h.command === hookPath)) {
    entry.hooks.push({ type: "command", command: hookPath });
}
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
    ;;
   jq)
    jq --arg p "$hook_path" --arg m "$matcher" '
      .hooks.PreToolUse |= (
        if . == null then [{"matcher":$m,"hooks":[{"type":"command","command":$p}]}]
        else
          if any(.[]; .matcher == $m) then
            map(if .matcher == $m then
              .hooks |= if any(.[]; .command == $p) then . else . + [{"type":"command","command":$p}] end
            else . end)
          else . + [{"matcher":$m,"hooks":[{"type":"command","command":$p}]}]
          end
        end
      )' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *)
    printf '  Could not register hook (install python3, node, or jq).\n'
    printf '  Add a PreToolUse hook pointing to %s manually.\n' "$hook_path"
    return 1
    ;;
  esac
}

# Permissions, aggregated from the manifests of the plugins actually installed,
# plus the suite's own. legacy_permissions are removed — bonsai's underscore
# spelling matched no tool, so the permission it granted was inert.
_json_sync_perms() {
  local file="$1" add="$2" drop="$3"
  _dry && return 0
  case "$(_json_backend)" in
   python3)
    python3 - "$file" "$add" "$drop" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, add, drop = sys.argv[1], sys.argv[2].split(), sys.argv[3].split()
with open(f) as fh: s = json.load(fh)
allow = s.setdefault("permissions", {}).setdefault("allow", [])
for p in add:
    if p not in allow: allow.append(p)
for d in drop:
    while d in allow: allow.remove(d)
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" "$add" "$drop" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, add, drop] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
s.permissions = s.permissions || {};
s.permissions.allow = s.permissions.allow || [];
for (const p of add.split(/\s+/).filter(Boolean))
  if (!s.permissions.allow.includes(p)) s.permissions.allow.push(p);
const dead = new Set(drop.split(/\s+/).filter(Boolean));
s.permissions.allow = s.permissions.allow.filter(p => !dead.has(p));
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
    ;;
   jq)
    jq --arg a "$add" --arg d "$drop" '
      .permissions.allow = (
        ((.permissions.allow // []) + ($a | split(" ") | map(select(. != ""))))
        | map(select(. as $p | ($d | split(" ") | index($p)) | not))
        | reduce .[] as $x ([]; if index($x) then . else . + [$x] end)
      )' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *)
    printf '  Could not update permissions (install python3, node, or jq).\n'
    return 1 ;;
  esac
}

# The nudges the hook's budget held back on the last tool call.
#
# The budget prints one nudge and names who else spoke; without somewhere to read
# the rest, "+ temper and cairn also had notes" would be a dead end. It also covers
# the case nothing announces: a block prints alone, and every nudge beside it is
# suppressed silently.
cmd_status_notes() {
  local f
  f=$(aether_notes_file 2>/dev/null)
  if [ -z "$f" ]; then
    printf 'No .aether/ in this project, so suppressed nudges are not recorded here.\n'
    printf '  Run `aether config set <key> <value>` or `trellis` to create one.\n'
    return 0
  fi
  if [ ! -s "$f" ]; then
    printf 'Nothing was suppressed on the last tool call.\n'
    return 0
  fi
  printf 'Suppressed on the last tool call:\n'
  # `## plugin` section headers, written by enforce-suite.sh.
  awk '/^## / { printf "%s%s\n", (n++ ? "\n" : ""), toupper(substr($0, 4)); next }
       { print "  " $0 }' "$f"
}

cmd_status() {
  printf 'aether v%s\n\n' "$VERSION"

  for plugin in $(_plugins_available); do
    local section enabled_val
    section=$(_mf "$plugin" config_section); section="${section:-$plugin}"
    enabled_val=$(_cfg_get "$section" "enabled")

    local state="enabled"
    [ "$enabled_val" = "false" ] && state="disabled"

    local extra=""
    if [ "$plugin" = "bonsai" ]; then
      local has_py has_ts
      has_py=$(grep -l "bonsai-py" "$HOME/.claude.json" 2>/dev/null | wc -l | tr -d ' ') || has_py=0
      has_ts=$(grep -l "bonsai-ts" "$HOME/.claude.json" 2>/dev/null | wc -l | tr -d ' ') || has_ts=0
      [ "$has_py" -gt 0 ] && extra="  MCP: bonsai-py"
      [ "$has_ts" -gt 0 ] && extra="${extra} bonsai-ts"
    fi

    printf '  %-12s %s%s\n' "$plugin" "$state" "$extra"
  done

  printf '\n'

  if _hook_registered; then
    local scope
    scope=$(_manifest_get "scope") || scope=""
    printf '  Suite hook: enforce-suite.sh registered (%s)\n' "${scope:-global}"
  else
    printf '  Suite hook: NOT registered — run install.sh to fix\n'
  fi

  # The gates are what enforce-suite.sh actually sources, so an empty directory
  # means the hook is registered but silent. The hook itself ignores a gate that
  # fails to parse — it must never block a tool call — so this is the only place
  # a corrupt gate is reported.
  local gates_dir gate_count bad_gates
  gates_dir=$(_manifest_get "gates") || gates_dir=""
  gates_dir="${gates_dir:-$(_gates_dir global)}"
  if [ -d "$gates_dir" ]; then
    gate_count=0; bad_gates=""
    for g in "$gates_dir"/enforce-*.sh; do
      [ -f "$g" ] || continue
      gate_count=$((gate_count + 1))
      bash -n "$g" 2>/dev/null || bad_gates="$bad_gates $(basename "$g")"
    done
    printf '  Gates:      %s loaded from %s\n' "$gate_count" "$gates_dir"
    if [ -n "$bad_gates" ]; then
      printf '              ✗ failed to parse and are being skipped:%s\n' "$bad_gates"
      printf '                re-run install.sh to restore them\n'
    fi
  else
    printf '  Gates:      none found at %s — run install.sh to fix\n' "$gates_dir"
  fi

  local repo
  repo=$(_manifest_get "repo") || repo=""
  if [ -n "$repo" ]; then
    if [ -d "$repo/.git" ]; then
      printf '  Clone:      %s\n' "$repo"
    else
      printf '  Clone:      %s (MISSING — aether update will not work)\n' "$repo"
    fi
  fi

  local manifest_version
  manifest_version=$(_manifest_get "version") || true
  [ -n "$manifest_version" ] && printf '  Installed version: %s\n' "$manifest_version"

  printf '\n'
}

# The value written is true/false — the word in the message is cosmetic. Keeping
# them one variable wrote `enabled: disable`, which is not `false`, so nothing
# was disabled and status still reported every plugin as on.
_set_enabled_all() {
  local scope="$1" value="$2" target plugin section
  target="$(_cfg_file "$scope")"
  for plugin in $(_plugins_available); do
    section=$(_mf "$plugin" config_section); section="${section:-$plugin}"
    _cfg_set "$target" "$section" "enabled" "$value" "$(_mf "$plugin" config.enabled.doc)"
    printf '  ✓ %s %s (%s)\n' "$plugin" \
      "$([ "$value" = true ] && printf enabled || printf disabled)" "$target"
  done
}

cmd_enable()  { _set_enabled_all "${1:-local}" true; }
cmd_disable() { _set_enabled_all "${1:-local}" false; }

# All four plugins now live in the aether clone, so updating is a git pull plus
# a re-run of the local installer — no per-plugin downloads, and the four
# plugins can never drift to different versions from each other.
cmd_update() {
  local repo scope scope_arg claude_md bonsai_arg
  repo=$(_manifest_get "repo") || repo=""

  if [ -z "$repo" ]; then
    printf 'Cannot locate the aether clone.\n'
    printf '  The install manifest has no repo= entry, so it predates aether 1.0.0.\n'
    printf '  Re-run install.sh from your clone once to record it.\n'
    return 1
  fi
  if [ ! -d "$repo/.git" ]; then
    printf 'The recorded clone is no longer there: %s\n' "$repo"
    printf '  Re-clone aether and run its install.sh.\n'
    return 1
  fi

  scope=$(_manifest_get "scope") || scope=""
  scope_arg=""; [ "$scope" = "global" ] && scope_arg="--global"
  claude_md=$(_manifest_get "claude_md") || claude_md=""
  [ "$claude_md" = "true" ] && claude_md="--claude-md" || claude_md=""
  bonsai_arg=""; [ "$(_manifest_get "bonsai")" = "false" ] && bonsai_arg="--no-bonsai"

  printf 'Updating aether from %s\n\n' "$repo"
  if ! git -C "$repo" pull --ff-only; then
    printf '\n  git pull failed. Resolve it in %s, then re-run aether update.\n' "$repo"
    return 1
  fi

  printf '\nRe-running the installer...\n\n'
  bash "$repo/install.sh" $scope_arg $claude_md $bonsai_arg
}

cmd_version() {
  local installed
  installed=$(_manifest_get "version") || installed=""
  printf 'aether %s (CLI)\n' "$VERSION"
  [ -n "$installed" ] && printf 'aether %s (installed)\n' "$installed"
  return 0
}

# ── aether hook enable|disable <plugin> ──────────────────────────────────────
# The suite had two disable models: `enable`/`disable` writes `enabled: false`
# to a config file the gate then reads, while bonsai's enable-hook/disable-hook
# deregistered the hook outright. Both are useful — one is a soft mute, the
# other stops the hook being invoked at all — so both exist, for every plugin.
cmd_hook() {
  local action="${1:-}" plugin="${2:-}" scope="${3:-global}"
  case "$action" in
    enable|disable) ;;
    *) printf 'Usage: aether hook enable|disable <plugin>\n'; return 1 ;;
  esac
  [ -n "$plugin" ] || { printf 'Which plugin?\n'; return 1; }
  local gates; gates=$(_gates_dir "$scope")
  local g="$gates/enforce-$plugin.sh"
  if [ "$action" = disable ]; then
    [ -f "$g" ] || { printf '  %s gate is already not installed\n' "$plugin"; return 0; }
    mv "$g" "$g.disabled" && printf '  ✓ %s gate disabled (enforce-suite.sh will skip it)\n' "$plugin"
  else
    if [ -f "$g.disabled" ]; then
      mv "$g.disabled" "$g" && printf '  ✓ %s gate re-enabled\n' "$plugin"
    else
      local repo; repo=$(_repo_root) || return 1
      _op_copy "$repo/plugins/$plugin/hooks/enforce-$plugin.sh" "$g" \
        && printf '  ✓ %s gate enabled\n' "$plugin"
    fi
  fi
}

cmd_uninstall() {
  local scope="local"
  local clean_claude_md=false
  local want=""

  for arg in "$@"; do
    case "$arg" in
      global|--global) scope="global" ;;
      --claude-md)     clean_claude_md=true ;;
      -*)              ;;
      *)               want="$want $arg" ;;
    esac
  done

  # Named plugins: remove just those, through the engine, leaving the suite in
  # place. `aether uninstall` with no plugin removes the suite itself, below.
  if [ -n "$want" ]; then
    local p
    for p in $want; do
      printf 'Removing %s (%s)...\n' "$p" "$scope"
      _engine_uninstall "$p" "$scope"
    done
    return 0
  fi

  # Every path below is derived from the scope. The hook, gates, CLI and
  # manifest paths used to be hardcoded to the global locations regardless of
  # it, so a local uninstall removed nothing it had installed — leaving
  # .claude/hooks/enforce-suite.sh, .claude/hooks/gates/ and .bin/aether behind
  # — while deleting the *global* manifest and breaking `aether update` for a
  # global install that had nothing to do with it.
  local settings_file claude_file manifest hook_file gates_dir cli_file
  if [ "$scope" = "global" ]; then
    settings_file="$(_settings global)"
    claude_file="$HOME/.claude/CLAUDE.md"
    manifest="$(_manifest_for global)"
    hook_file="$(_hook_dir global)/enforce-suite.sh"
    gates_dir="$(_gates_dir global)"
    cli_file="$HOME/.local/bin/aether"
  else
    settings_file=".claude/settings.json"
    claude_file="./CLAUDE.md"
    manifest="$(_manifest_for local)"
    hook_file="$(_hook_dir local)/enforce-suite.sh"
    gates_dir="$(_gates_dir local)"
    cli_file=".bin/aether"
  fi

  # The manifest records where the install actually put things, which beats
  # inferring it if a future install.sh changes its layout.
  if [ -f "$manifest" ]; then
    local recorded
    recorded=$(grep '^hook=' "$manifest" | sed 's/^hook=//' | head -1) || recorded=""
    [ -n "$recorded" ] && hook_file="$recorded"
    recorded=$(grep '^gates=' "$manifest" | sed 's/^gates=//' | head -1) || recorded=""
    [ -n "$recorded" ] && gates_dir="$recorded"
  fi

  # Remove the suite's own PreToolUse hook. The per-plugin PostToolUse hooks
  # (post-cairn, post-bonsai) belong to plugins that stay installed for
  # standalone use, so removing aether must not take them with it.
  if [ -f "$settings_file" ] && command -v python3 &>/dev/null; then
    cp "$settings_file" "$settings_file.bak"
    python3 - "$settings_file" <<'PYEOF' > "$settings_file.tmp" && mv "$settings_file.tmp" "$settings_file"
import json, sys
f = sys.argv[1]
with open(f) as fh: s = json.load(fh)
entries = s.get("hooks", {}).get("PreToolUse", [])
for entry in entries:
    entry["hooks"] = [
        h for h in entry.get("hooks", [])
        if "enforce-suite" not in h.get("command", "")
    ]
if "hooks" in s and "PreToolUse" in s["hooks"]:
    s["hooks"]["PreToolUse"] = [e for e in entries if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
    printf '  ✓ Removed enforce-suite.sh hook from %s\n' "$settings_file"
  fi

  # Remove aether CLI
  if [ -f "$cli_file" ]; then
    rm "$cli_file"
    printf '  ✓ Removed %s\n' "$cli_file"
  fi

  # Remove enforce-suite.sh and the gates it sources
  if [ -d "$gates_dir" ]; then
    rm -rf "$gates_dir"
    printf '  ✓ Removed %s\n' "$gates_dir"
  fi
  # The shared config reader goes with the gates: the PostToolUse hooks that
  # survive a suite uninstall do not read config, and installing any plugin
  # reinstalls it.
  local cfg_lib; cfg_lib="$(dirname "$hook_file")/aether-config.sh"
  [ -f "$cfg_lib" ] && { rm "$cfg_lib"; printf '  ✓ Removed %s\n' "$cfg_lib"; }
  if [ -f "$hook_file" ]; then
    rm "$hook_file"
    printf '  ✓ Removed %s\n' "$hook_file"
  fi

  # Tidy up directories the install created, but only if nothing else is in
  # them — a local install shares .claude/hooks/ with anything the user put there.
  # plugin-hooks/ is created by the engine, so it is removed before its parent.
  rmdir "$(_plugin_hooks "$scope")" 2>/dev/null || true
  rmdir "$(dirname "$hook_file")" 2>/dev/null || true
  [ "$scope" = "global" ] || rmdir .bin 2>/dev/null || true

  # Remove CLAUDE.md block
  if [ "$clean_claude_md" = true ] && [ -f "$claude_file" ]; then
    for marker in "aether" "cairn" "temper" "whetstone" "bonsai"; do
      if grep -q "<!-- ${marker}:start -->" "$claude_file" 2>/dev/null; then
        awk "/<!-- ${marker}:start -->/{skip=1} !skip{print} /<!-- ${marker}:end -->/{skip=0}" \
          "$claude_file" > "$claude_file.tmp" && mv "$claude_file.tmp" "$claude_file"
        printf '  ✓ Removed %s section from %s\n' "$marker" "$claude_file"
      fi
    done
  fi

  # Remove the manifest for this scope only. Removing both meant a local
  # uninstall deleted the global install's record of its clone path, after
  # which `aether update` could no longer find the repository.
  if [ -f "$manifest" ]; then
    rm "$manifest"
    printf '  ✓ Removed %s\n' "$manifest"
  fi

  printf '\nPlugins (bonsai, whetstone, temper, cairn) remain installed for standalone use.\n'
  printf 'Restart Claude Code to apply changes.\n'
}

# MCP servers go in ~/.claude.json, not settings.json. Declared flat in the
# manifest as mcp.<name>.command / .args, with ${PLUGIN_ROOT} expanded here —
# which is why moving the clone breaks bonsai and nothing else.
_json_mcp_sync() {
  local plugin="$1" proot="$2" action="$3"
  # ~/.claude.json is Claude Code's own file and is created if absent, so this
  # needs the guard even though it only ever adds keys.
  _dry && { printf '  [dry-run] would %s %s MCP servers in ~/.claude.json\n' "$action" "$plugin"; return 0; }
  command -v python3 >/dev/null 2>&1 || { printf '  ! MCP registration needs python3\n'; return 1; }
  local names spec=""
  names=$(grep -oE '^mcp\.[a-z-]+\.command:' "$proot/aether.plugin" 2>/dev/null \
          | sed 's/^mcp\.//;s/\.command:$//' | sort -u)
  [ -n "$names" ] || return 0
  local n cmd cargs
  for n in $names; do
    # `|| true`: _mf returns 1 when the clone cannot be located, and a bare
    # assignment from a failing substitution aborts the whole shell under set -e.
    # The explicit check below should be what handles this, not an exit.
    cmd=$(_mf "$plugin" "mcp.$n.command" || true)
    cargs=$(_mf "$plugin" "mcp.$n.args" 2>/dev/null | sed "s|\${PLUGIN_ROOT}|$proot|g" || true)
    # An entry with an empty command is worse in ~/.claude.json than no entry:
    # Claude Code would try to launch it. Refuse rather than write a broken one.
    if [ "$action" = add ] && [ -z "$cmd" ]; then
      printf '  ! could not resolve the command for MCP server %s — not registered\n' "$n"
      continue
    fi
    spec="$spec$n"$'\t'"$cmd"$'\t'"$cargs"$'\n'
  done
  [ -n "$spec" ] || return 0
  # The spec goes through argv, not a pipe. `python3 -` reads its program from
  # stdin, so a heredoc here claims stdin and sys.stdin.read() returns nothing —
  # which is how this silently wrote an empty mcpServers map and reported success.
  python3 - "$action" "$spec" <<'PYEOF'
import json, os, sys
action, spec = sys.argv[1], sys.argv[2]
path = os.path.expanduser("~/.claude.json")
data = {}
if os.path.exists(path):
    try:
        with open(path) as f: data = json.load(f)
    except json.JSONDecodeError:
        pass
servers = data.setdefault("mcpServers", {})
for line in spec.splitlines():
    if not line.strip(): continue
    name, cmd, args = line.split("\t", 2)
    if action == "remove":
        servers.pop(name, None)
    else:
        servers[name] = {"type": "stdio", "command": cmd, "args": args.split()}
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2); f.write("\n")
os.replace(tmp, path)
PYEOF
}

# ── aether install ───────────────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# CONFIG
#
# The schema lives in the manifests, beside the assets each plugin declares, so
# a key is documented by being declared and there is no map to keep in sync.
# Before this, the only list of keys in the suite was a hardcoded DEFAULTS map
# inside bin/cairn, and the other three plugins resolved their keys with
# hand-written one-liners.
# ═══════════════════════════════════════════════════════════════════════════

# One line per declared key: section|key|plugin
_schema_all() {
  local repo plugin f default_section section key
  repo=$(_repo_root) || return 0
  for plugin in $(_plugins_available); do
    f="$repo/plugins/$plugin/aether.plugin"
    [ -f "$f" ] || continue
    default_section=$(_mf "$plugin" config_section); default_section="${default_section:-$plugin}"
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      section=$(_mf "$plugin" "config.$key.section")
      printf '%s|%s|%s\n' "${section:-$default_section}" "$key" "$plugin"
    done <<EOSCHEMA
$(sed -n 's/^config\.\(.*\)\.doc:.*/\1/p' "$f")
EOSCHEMA
  done
}

# No `exit` in the awk: it would close the pipe while _schema_all is still
# writing, and bash on Linux reports the resulting EPIPE as
# `printf: write error: Broken pipe` on stderr — which then lands in whatever the
# caller captured. macOS dies from SIGPIPE silently, so this passed locally and
# failed in CI on both platforms' terms.
# A `[project:<path>]` area declares the same keys as `[project]`, and `check.<name>`
# is a command by construction rather than something a manifest can enumerate. Both
# normalise here so `config show` and `config doctor` see one schema, not one per area.
_schema_section() { case "$1" in project:*) printf project ;; *) printf '%s' "$1" ;; esac; }

# The schema as displayed: every `project` row repeated once per declared area, plus
# the `check.<name>` keys an area actually sets. `_schema_all` reads manifests and
# cannot know about areas, which is why this is a layer on top rather than a change
# to it — the manifests stay the single source for what a key means.
_schema_expanded() {
  local areas a section key plugin f rows checks
  areas=$(_project_areas)
  rows=$(_schema_all)
  checks=$( for f in "${AETHER_HOME:-$HOME/.aether}/config" .aether/config; do
      [ -f "$f" ] || continue
      aether_cfg_keys "$f" | awk -F'|' '$1 ~ /^project(:|$)/ && $2 ~ /^check\./ { print $1 "|" $2 }'
    done | sort -u )

  # Everything that is not a project section, unchanged.
  printf '%s\n' "$rows" | awk -F'|' '$1 != "project"'

  # Then one complete block per area, so the display groups by area rather than
  # interleaving areas within every key.
  [ -n "$areas" ] || { printf '%s\n' "$rows" | awk -F'|' '$1 == "project"'; return 0; }
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    printf '%s\n' "$rows" | awk -F'|' -v a="$a" '$1 == "project" { print a "|" $2 "|" $3 }'
    printf '%s\n' "$checks" | awk -F'|' -v a="$a" '$1 == a { print a "|" $2 "|temper" }'
  done <<EOAREAS
$areas
EOAREAS
  return 0
}

_schema_plugin_for() {   # section|key -> owning plugin
  local sec; sec=$(_schema_section "$1")
  case "$sec|$2" in project\|check.*) printf temper; return 0 ;; esac
  _schema_all | awk -F'|' -v s="$sec" -v k="$2" '$1 == s && $2 == k && !f { print $3; f = 1 }'
}

# Which layer supplied the live value: "layer|file|line", or "default||".
_cfg_origin() {
  local section="$1" key="$2" f ln
  for pair in "project|$(_cfg_file local)" "global|$(_cfg_file global)"; do
    f="${pair#*|}"; ln=$(aether_cfg_lineno "$f" "$section" "$key")
    [ -n "$ln" ] && { printf '%s|%s|%s' "${pair%%|*}" "$f" "$ln"; return 0; }
  done
  for pair in "legacy project|./$section.config" "legacy global|$HOME/.claude/$section.config"; do
    f="${pair#*|}"; ln=$(aether_cfg_lineno "$f" "" "$key")
    [ -n "$ln" ] && { printf '%s|%s|%s' "${pair%%|*}" "$f" "$ln"; return 0; }
  done
  printf 'default||'
}

# _plugin_section_for <plugin> <key> -> the [section] that plugin declares <key> under
#
# Not always the plugin's own section: cairn declares `trailers` under [git], because a
# house rule about commit text is not a cairn setting. The schema already records that
# (`config.<key>.section:`), so this is a lookup rather than a second place to encode it.
_plugin_section_for() {
  # No `exit` in the awk — see the note under _schema_plugin_for. Exiting early closes
  # the pipe while _schema_all is still writing, and bash on Linux reports the EPIPE as
  # `printf: write error: Broken pipe` into whatever the caller captured.
  local s
  s=$(_schema_all | awk -F'|' -v p="$1" -v k="$2" '$3 == p && $2 == k && !f { print $1; f = 1 }')
  [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  # Unknown key: fall back to the plugin's own section so `cmd_config set` reaches its
  # "no plugin declares this" warning instead of us inventing a section here.
  s=$(_mf "$1" config_section); printf '%s' "${s:-$1}"
}

# _is_known_section <name> -> 0 when some manifest declares keys under it
# The `exit` here is in END, after all input is read, so it cannot close the pipe early.
_is_known_section() {
  [ -n "$1" ] || return 1
  _schema_all | awk -F'|' -v s="$1" '$1 == s { found = 1 } END { exit !found }'
}

_split_key() {           # temper.auto_nudge_lines -> "temper auto_nudge_lines"
  case "$1" in
    *.*) printf '%s %s' "${1%%.*}" "${1#*.}" ;;
    *)   printf ' %s' "$1" ;;
  esac
}

_cfg_scope_from_args() { case " $* " in *" global "*|*" --global "*) printf global ;; *) printf local ;; esac; }

# Is this section wanted? `project` selects every area in the human view, because
# asking about the section should show the whole picture — but not in --raw, where
# keys from two areas would collide in a flat key: value list.
_cfg_show_wanted() {
  local want="$1" section="$2" raw="$3"
  [ -z "$want" ] && return 0
  [ "$want" = "$section" ] && return 0
  if [ "$want" = project ] && [ "$raw" != true ]; then
    case "$section" in project:*) return 0 ;; esac
  fi
  return 1
}

cmd_config_show() {
  local want="${1:-}" values=false raw=false
  case " $* " in *" --values "*) values=true ;; esac
  # --raw emits exactly the config file format, defaults applied, one key per
  # line and nothing else. The slash commands consume this: a value like
  # "red, yellow" contains spaces, so the aligned human output is ambiguous to
  # parse and this is not.
  case " $* " in *" --raw "*) raw=true; values=true ;; esac
  case "$want" in --*) want="" ;; esac

  if [ "$raw" = true ]; then
    local section key plugin val
    while IFS='|' read -r section key plugin; do
      _cfg_show_wanted "$want" "$section" "$raw" || continue
      val=$(_cfg_area "$section" "$key")
      [ -z "$val" ] && val=$(_mf "$plugin" "config.$key.default")
      [ -n "$val" ] && printf '%s: %s\n' "$key" "$val"
    done <<EORAW
$(_schema_expanded)
EORAW
    return 0
  fi

  local last="" section key plugin val def origin layer file line doc used
  while IFS='|' read -r section key plugin; do
    _cfg_show_wanted "$want" "$section" "$raw" || continue
    if [ "$section" != "$last" ]; then
      printf '\n[%s]\n' "${section:-suite}"; last="$section"
    fi
    val=$(_cfg_area "$section" "$key")
    def=$(_mf "$plugin" "config.$key.default")
    origin=$(_cfg_origin "$section" "$key")
    layer="${origin%%|*}"; file="${origin#*|}"; line="${file#*|}"; file="${file%%|*}"
    file="${file/#$HOME/~}"
    [ -z "$val" ] && { val="$def"; layer="default"; }
    [ -z "$val" ] && val="(unset)"
    if [ "$layer" = "default" ]; then
      printf '  %-20s %-22s %s\n' "$key" "$val" "default"
    else
      printf '  %-20s %-22s %s · %s:%s\n' "$key" "$val" "$layer" "$file" "$line"
    fi
    if [ "$values" = false ]; then
      doc=$(_mf "$plugin" "config.$key.doc")
      used=$(_mf "$plugin" "config.$key.used_by")
      [ -n "$doc" ] && printf '      %s\n' "$doc"
      [ -n "$used" ] && printf '      used by: %s\n' "$used"
    fi
  done <<EOSHOW
$(_schema_expanded)
EOSHOW
  printf '\n'
  [ "$values" = false ] && printf 'Edit with: aether config set <section>.<key> <value> [global]\n'
  return 0
}

cmd_config_explain() {
  local raw="$1"
  [ -n "$raw" ] || { printf 'Usage: aether config explain <section>.<key>\n'; return 1; }
  local parsed section key; parsed=$(_split_key "$raw")
  section="${parsed%% *}"; key="${parsed#* }"
  local plugin; plugin=$(_schema_plugin_for "$section" "$key")
  [ -n "$plugin" ] || { printf 'No such key: %s\n\nRun `aether config show` for the full list.\n' "$raw"; return 1; }

  printf '\n%s.%s\n\n' "$section" "$key"
  printf '  %s\n\n' "$(_mf "$plugin" "config.$key.doc")"
  printf '  %-12s %s\n' "declared by" "$plugin"
  printf '  %-12s %s\n' "type"        "$(_mf "$plugin" "config.$key.type"    || true)"
  printf '  %-12s %s\n' "default"     "$(_mf "$plugin" "config.$key.default" || true)"
  printf '  %-12s %s\n' "used by"     "$(_mf "$plugin" "config.$key.used_by" || true)"

  printf '\n  Layers, lowest priority first:\n'
  local f ln v
  for pair in "global|$(_cfg_file global)" "project|$(_cfg_file local)"; do
    f="${pair#*|}"; ln=$(aether_cfg_lineno "$f" "$section" "$key")
    if [ -n "$ln" ]; then
      v=$(aether_cfg_read "$f" "$section" "$key")
      printf '    %-8s %-20s %s:%s\n' "${pair%%|*}" "$v" "${f/#$HOME/~}" "$ln"
    else
      printf '    %-8s %-20s %s\n' "${pair%%|*}" "—" "not set"
    fi
  done
  printf '\n  Resolved: %s\n\n' "$(_cfg_get "$section" "$key")"
  return 0
}

# The mistakes hand-editing actually produces. A typo is the one worth catching
# most: today it is silently ignored, the default applies, and the setting
# simply appears to have no effect.
_doctor_config() {
  local schema resolved=0
  schema=$(_schema_all)

  local f scope pair section key known suggestion
  for pair in "global|$(_cfg_file global)" "project|$(_cfg_file local)"; do
    scope="${pair%%|*}"; f="${pair#*|}"
    [ -f "$f" ] || continue
    while IFS='|' read -r section key; do
      [ -n "$key" ] || continue
      # Reads to EOF for the same reason as _schema_plugin_for.
      known=$(printf '%s\n' "$schema" | awk -F'|' -v s="$(_schema_section "$section")" -v k="$key" \
                '$1 == s && $2 == k && !f { print 1; f = 1 }')
      case "$(_schema_section "$section")|$key" in project\|check.*) known=1 ;; esac
      if [ -n "$known" ]; then
        resolved=$((resolved + 1))
      else
        _dr_bad "$(printf '[%s] %s — unknown key  (%s:%s)' "$section" "$key" \
          "$(_dr_tilde "$f")" "$(aether_cfg_lineno "$f" "$section" "$key")")"
        # Longest shared prefix within the same section, which is what a typo
        # in a long key like auto_nudge_lines actually looks like.
        suggestion=$(printf '%s\n' "$schema" | awk -F'|' -v s="$section" -v k="$key" '
          $1 == s {
            n = 0
            while (n < length(k) && n < length($2) && substr(k, n+1, 1) == substr($2, n+1, 1)) n++
            if (n > best && n >= 4) { best = n; cand = $2 }
          }
          END { if (cand != "") print cand }')
        [ -n "$suggestion" ] && _dr_note "did you mean $suggestion?"
      fi
    done <<EOKEYS
$(aether_cfg_keys "$f")
EOKEYS
  done

  # A [project] command whose binary is absent runs as nothing at all.
  #
  # Walks every area, not just the root: in a monorepo the missing binary is usually
  # one toolchain's — `bun` on a machine that only has node — and reporting it
  # against `[project]` would name the wrong place. `check.*` is covered too, since
  # those are commands by construction.
  #
  # Every command position is checked, not just the first word. `git ls-files … |
  # xargs shellcheck` starts with `git`, which is always present, so checking only
  # the first word reported "no problems" on a machine with no shellcheck — the
  # exact silent skip this is here to catch. Runner prefixes have the same shape
  # in reverse: `uv run pytest` needs `uv`, and that *is* the first word.
  local dsec cmdkey val bin seg missing
  while IFS= read -r dsec; do
    [ -n "$dsec" ] || continue
    while IFS= read -r cmdkey; do
      [ -n "$cmdkey" ] || continue
      val=$(_cfg_area "$dsec" "$cmdkey"); [ -n "$val" ] || continue
      missing=""
      # Split on pipeline and list separators; the first word of each is a command.
      while IFS= read -r seg; do
        seg="${seg#"${seg%%[![:space:]]*}"}"        # strip leading whitespace
        bin="${seg%% *}"
        # A few wrappers put the real command in argument position, so the first
        # word is never the thing that can be missing. Only wrappers whose next word
        # must already be an executable are unwrapped — `npx tsc` and `uv run pytest`
        # are deliberately not, since those fetch or resolve it.
        while :; do
          case "$bin" in
            xargs|env|nice|nohup|sudo|time)
              seg="${seg#"$bin"}"; seg="${seg#"${seg%%[![:space:]]*}"}"
              while :; do case "$seg" in -*) seg="${seg#* }"; seg="${seg#"${seg%%[![:space:]]*}"}" ;; *) break ;; esac; done
              bin="${seg%% *}"; [ -n "$bin" ] || break ;;
            *) break ;;
          esac
        done
        case "$bin" in ''|-*|*=*|'('*) continue ;; esac
        command -v "$bin" >/dev/null 2>&1 || missing="$missing $bin"
      done <<EOSEG
$(printf '%s' "$val" | tr '|;' '\n\n' | sed 's/&&/\n/g')
EOSEG
      [ -n "$missing" ] && {
        _dr_warn "[$dsec] $cmdkey: $val"
        _dr_note "not on PATH:$missing — that step will be skipped"
      }
    done <<EOKEYS
$(_check_keys "$dsec")
EOKEYS
    # An area pointing at a directory that no longer exists can never run.
    case "$dsec" in
      project:*) [ -d "${dsec#project:}" ] || {
        _dr_warn "[$dsec] ${dsec#project:}/ does not exist"
        _dr_note "aether check will skip it"; } ;;
    esac
  done <<EODSEC
$(_project_areas)
EODSEC

  command -v aether_cfg_get >/dev/null 2>&1 \
    || _dr_bad "aether-config.sh not found — every value is falling back to its default"

  if [ -f .aether/config ] || [ -f .aether/rules.md ]; then
    case "$(aether_trust_state)" in
      nohash)
        _dr_warn "no SHA-256 on this machine — nothing can be trusted"
        _dr_note "install shasum, sha256sum or openssl" ;;
      changed)
        _dr_warn ".aether/ changed since it was trusted"
        _dr_note "[project] commands and rules.md are being ignored"
        _dr_fix "aether trust, after reviewing the change" ;;
      none)
        _dr_warn ".aether/ is untrusted"
        _dr_note "[project] commands and rules.md are being ignored"
        _dr_fix "aether trust, after reviewing it" ;;
    esac
  fi

  _dr_ok "$resolved key(s) resolved"
  return 0
}

# `aether config doctor` predates `aether doctor` by one release and is documented,
# so it stays — as the config half plus its own summary, not a second copy.
cmd_config_doctor() {
  _DR_BAD=0; _DR_WARN=0
  _doctor_config
  _doctor_trust
  printf '\n'
  if [ "$_DR_BAD" -eq 0 ] && [ "$_DR_WARN" -eq 0 ]; then printf 'No problems found.\n'; return 0; fi
  printf '%s problem(s), %s warning(s).  `aether doctor` also checks the install.\n' \
    "$_DR_BAD" "$_DR_WARN"
  [ "$_DR_BAD" -gt 0 ] && return 1
  return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# PROJECT AREAS
#
# `[project:<path>]` describes one area of a monorepo. Every real monorepo has more
# than one toolchain, and before this the only way to say so was to install aether
# inside a subfolder — which left the rest of the repo unconfigured and made the
# gates fire only when the shell happened to be in that directory.
#
# The area rules live here rather than in hooks/aether-config.sh on purpose: no gate
# needs them, and that library is sourced on every single tool call.
# ═══════════════════════════════════════════════════════════════════════════

# A key whose value is a shell command, per the schema — `config.<key>.type: command`
# is already declared for test, lint, format, typecheck, build and coverage, while
# coverage_min is `int`. Derived rather than listed, so the two cannot drift.
_cfg_is_command() {
  case "$1" in check.*) return 0 ;; esac
  local plugin; plugin=$(_schema_plugin_for project "$1")
  [ -n "$plugin" ] || return 1
  [ "$(_mf "$plugin" "config.$1.type")" = command ]
}

# Resolve a key for one area. Command keys never inherit: a command in [project] is
# written relative to the repo root, so running it inside an area would be wrong and
# running it at the root would not be inheritance. Everything else falls back.
_cfg_area() {
  local section="$1" key="$2" v
  v=$(_cfg_get "$section" "$key")
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  case "$section" in project) return 0 ;; esac
  _cfg_is_command "$key" && return 0
  _cfg_get project "$key"
}

# Every project area the config actually declares, deepest path first so a
# longest-prefix search can stop at its first hit. `project` itself sorts last.
_project_areas() {
  local f
  { for f in "${AETHER_HOME:-$HOME/.aether}/config" .aether/config; do
      [ -f "$f" ] || continue
      aether_cfg_keys "$f" | awk -F'|' '$1 ~ /^project(:|$)/ { print $1 }'
    done; } | sort -u | awk '
      { n = gsub(/\//, "/", $0); print n "\t" $0 }' | sort -rn -k1,1 | cut -f2- | awk '
      $0 == "project" { root = $0; next } { print } END { if (root != "") print root }'
}

# Which areas do these files belong to? Longest matching path prefix, the way CI's
# paths filter works. A file under no declared area belongs to `project`.
_project_sections() {
  local file area hit out="" root=""
  local areas; areas=$(_project_areas)
  [ -n "$areas" ] || { printf 'project\n'; return 0; }
  for file in "$@"; do
    file="${file#./}"
    hit=""
    while IFS= read -r area; do
      [ -n "$area" ] || continue
      [ "$area" = project ] && continue
      case "$file/" in "${area#project:}"/*) hit="$area"; break ;; esac
    done <<EOAREAS
$areas
EOAREAS
    if [ -n "$hit" ]; then
      case " $out " in *" $hit "*) ;; *) out="$out $hit" ;; esac
    else
      root=project
    fi
  done
  # Deepest first, then the root area if anything fell through to it.
  while IFS= read -r area; do
    [ -n "$area" ] || continue
    case " $out " in *" $area "*) printf '%s\n' "$area" ;; esac
  done <<EOAREAS
$areas
EOAREAS
  [ -n "$root" ] && printf 'project\n'
  return 0
}

cmd_project() {
  case "${1:-}" in
    for) shift; _project_sections "$@" ;;
    areas) _project_areas ;;
    *) printf 'Usage: aether project for <file...> | aether project areas\n'; return 1 ;;
  esac
}

# ── aether check ─────────────────────────────────────────────────────────────

_check_keys() {   # every command key an area sets, in a stable order
  local section="$1" k f
  for k in test lint format typecheck build coverage; do
    [ -n "$(_cfg_get "$section" "$k")" ] && printf '%s\n' "$k"
  done
  for f in "${AETHER_HOME:-$HOME/.aether}/config" .aether/config; do
    [ -f "$f" ] || continue
    aether_cfg_keys "$f" | awk -F'|' -v s="$section" '$1 == s && $2 ~ /^check\./ { print $2 }'
  done | sort -u
}

cmd_check() {
  local raw=false all=false want="" a
  for a in "$@"; do
    case "$a" in
      --raw) raw=true ;;
      --all) all=true ;;
      -*)    printf 'Unknown option: %s\n' "$a"; return 1 ;;
      *)     want="$want $a" ;;
    esac
  done

  # [project] holds shell commands, so this is the one command in the suite that
  # executes what a repository told it to. It refuses outright rather than falling
  # back to global, because "ran nothing" and "ran the wrong thing" look identical
  # afterwards.
  if [ -f .aether/config ] || [ -f .aether/rules.md ]; then
    case "$(aether_trust_state)" in
      ok) ;;
      changed)
        printf 'This project is untrusted: .aether/ changed since you trusted it.\n'
        printf 'Review the change, then: aether trust\n'; return 1 ;;
      *)
        printf 'This project is untrusted, so aether check will not run its commands.\n'
        printf 'Review .aether/config, then: aether trust\n'; return 1 ;;
    esac
  fi

  local sections
  if [ "$all" = true ] || [ -z "$want" ] && [ "$all" = true ]; then
    sections=$(_project_areas)
  elif [ -n "$want" ]; then
    # An argument naming a declared area selects it; anything else is treated as a
    # changed path.
    local arg matched="" paths=""
    for arg in $want; do
      arg="${arg%/}"; arg="${arg#./}"
      if _project_areas | grep -qx "project:$arg"; then matched="$matched project:$arg"
      elif [ "$arg" = project ]; then matched="$matched project"
      else paths="$paths $arg"; fi
    done
    sections="$(printf '%s\n' $matched | grep -v '^$' || true)"
    [ -n "$paths" ] && sections="$sections
$(_project_sections $paths)"
    sections=$(printf '%s\n' "$sections" | grep -v '^$' | awk '!seen[$0]++')
  else
    local changed; changed=$(_check_changed_files)
    if [ -z "$changed" ]; then
      printf 'Nothing changed against the base branch. `aether check --all` runs everything.\n'
      return 0
    fi
    sections=$(_project_sections $changed)
  fi

  [ -n "$sections" ] || { printf 'No [project] configuration. `/draft-config` writes one.\n'; return 0; }

  local ran=0 failed=0 section key cmd dir rc out started elapsed
  local selected=" $(printf '%s' "$sections" | tr '\n' ' ') "
  while IFS= read -r section; do
    [ -n "$section" ] || continue
    dir="."; case "$section" in project:*) dir="${section#project:}" ;; esac
    if [ ! -d "$dir" ]; then
      failed=$((failed + 1))
      if [ "$raw" = true ]; then printf '%s\t-\tmissing\t\n' "$section"
      else printf '  %-24s directory %s does not exist\n' "$section" "$dir"; fi
      continue
    fi
    while IFS= read -r key; do
      [ -n "$key" ] || continue
      cmd=$(_cfg_area "$section" "$key"); [ -n "$cmd" ] || continue
      started=$(date +%s)
      # `&& rc=0 || rc=$?`, not `; rc=$?`: an assignment from a failing command
      # substitution aborts the shell under `set -e`, so the first failing check
      # ended the run and every later one was never reported — on the primary path.
      out=$( cd "$dir" && eval "$cmd" 2>&1 ) && rc=0 || rc=$?
      elapsed=$(( $(date +%s) - started ))
      ran=$((ran + 1))
      [ "$rc" -eq 0 ] || failed=$((failed + 1))
      if [ "$raw" = true ]; then
        printf '%s\t%s\t%s\t%s\n' "$section" "$key" \
          "$([ "$rc" -eq 0 ] && printf ok || printf fail)" "$cmd"
      elif [ "$rc" -eq 0 ]; then
        printf '  %-24s %-16s ✓   %ss\n' "$section" "$key" "$elapsed"
      else
        printf '  %-24s %-16s ✗   %s\n' "$section" "$key" "$cmd"
        printf '%s\n' "$out" | sed -n '1,8p' | sed 's/^/        /'
      fi
    done <<EOKEYS
$(_check_keys "$section")
EOKEYS
  done <<EOSECTIONS
$sections
EOSECTIONS

  # Areas that exist but were not touched are reported, not omitted: "skipped"
  # and "absent" are different facts and a reader needs to tell them apart.
  while IFS= read -r section; do
    [ -n "$section" ] || continue
    case "$selected" in *" $section "*) continue ;; esac
    if [ "$raw" = true ]; then printf '%s\t-\tskipped\t\n' "$section"
    else printf '  %-24s not touched — skipped\n' "$section"; fi
  done <<EOALL
$(_project_areas)
EOALL

  [ "$raw" = true ] && { [ "$failed" -eq 0 ] || return 1; return 0; }
  printf '\n'
  if [ "$failed" -eq 0 ]; then printf '%s check(s) passed.\n' "$ran"; return 0; fi
  printf '%s of %s failed.\n' "$failed" "$ran"
  return 1
}

# Files changed against the base branch, for the default invocation. Reuses cairn's
# base resolution; on a detached HEAD or a repo with no base there is nothing to diff
# against, so the caller falls back to --all and says so.
_check_changed_files() {
  local base; base=$(_cfg_get cairn pr.base)
  [ -n "$base" ] && [ "$base" != auto ] || {
    base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    [ -n "$base" ] || { for b in main master; do
        git rev-parse --verify "origin/$b" >/dev/null 2>&1 && { base="$b"; break; }; done; }
  }
  [ -n "$base" ] || return 0
  { git diff --name-only "origin/$base"...HEAD 2>/dev/null
    git diff --name-only 2>/dev/null
    git diff --name-only --staged 2>/dev/null; } | sort -u
}

# ═══════════════════════════════════════════════════════════════════════════
# PLANS
#
# `aether plan status` exists because the failure this replaces was invisible: the
# gate globbed ./.claude/plans/ while plan mode wrote to ~/.claude/plans/, so it
# silently judged the wrong file — or none — for as long as that took to notice.
# "Which plan does the gate think I am working on, and does it consider it critiqued"
# should be one command away.
# ═══════════════════════════════════════════════════════════════════════════

cmd_plan() {
  local sub="${1:-status}"; shift 2>/dev/null || true
  case "$sub" in
    path) aether_plan_file; printf '\n' ;;
    hash)
      local f="${1:-$(aether_plan_file)}"
      [ -n "$f" ] || { printf 'No plan recorded.\n'; return 1; }
      aether_plan_hash "$f"; printf '\n' ;;
    status)
      local f state seen
      f=$(aether_plan_file)
      if [ -z "$f" ]; then
        printf '  no plan recorded for this project\n'
        printf '      one is recorded when a plan file is written under .claude/plans/\n'
        printf '      or ~/.claude/plans/ while working here\n'
      else
        state=$(aether_plan_state "$f")
        printf '  plan:   %s\n' "${f/#$HOME/~}"
        case "$state" in
          critiqued)   _dr_ok  "critiqued, and current" ;;
          stale)       _dr_warn "the plan changed after its last critique"
                       _dr_fix "/critique-plan" ;;
          uncritiqued) _dr_warn "no critique on record"
                       _dr_fix "/critique-plan" ;;
          *)           _dr_warn "the recorded plan file is gone" ;;
        esac
      fi
      # Whether Claude Code delivers PreToolUse for ExitPlanMode could not be
      # determined from outside the tool, so the gate records the first time it sees
      # one and this reports it rather than the design asserting either way.
      seen=".aether/out/.exitplanmode-seen"
      if [ -f "$seen" ]; then
        printf '  ExitPlanMode trigger: observed %s\n' "$(head -1 "$seen" 2>/dev/null)"
      else
        printf '  ExitPlanMode trigger: not yet observed\n'
        printf '      the nudge also fires on the first source write and at git commit\n'
      fi
      return 0 ;;
    *) printf 'Unknown: aether plan %s\n\nTry: status, path, hash\n' "$sub"; return 1 ;;
  esac
}

# ═══════════════════════════════════════════════════════════════════════════
# DOCTOR
#
# v1.1.0 fixed twelve bugs, and the ones that mattered shared a shape: the tool
# reported success and had done nothing. The engine registered no MCP servers for
# six commits. An upgrade left a PostToolUse hook pointing into a deleted
# directory. post-cairn.sh fired twice. All of it invisible from the outside — in
# a tool whose entire job is noticing problems.
#
# Every check here answers one question: does the state on disk match what the
# manifests say it should be. The manifests are the source of truth, exactly as
# they are for the engine — a second list of what aether owns would drift from the
# first.
# ═══════════════════════════════════════════════════════════════════════════

_DR_BAD=0; _DR_WARN=0; _DR_FIXABLE=""

_dr_ok()   { printf '  ✓ %s\n' "$*"; }
_dr_bad()  { _DR_BAD=$((_DR_BAD + 1));   printf '  ✗ %s\n' "$*"; }
_dr_warn() { _DR_WARN=$((_DR_WARN + 1)); printf '  ! %s\n' "$*"; }
_dr_note() { printf '      %s\n' "$*"; }
_dr_fix()  { printf '      fix: %s\n' "$*"; }

# ── install ──────────────────────────────────────────────────────────────────

_doctor_hooks() {
  local settings probe n_suite=0 dup="" seen="" missing=""
  settings=$(_settings "$1")
  probe=$(_json_probe "$settings" "$HOME/.claude.json" 2>/dev/null) || {
    _dr_warn "cannot read settings.json (needs python3, node or jq)"
    _dr_note "hook, permission and MCP checks skipped"; return 0; }

  local line phase cmd base
  while IFS=$'\t' read -r kind phase _matcher cmd; do
    [ "$kind" = hook ] || continue
    [ -n "$cmd" ] || continue
    base=$(basename "$cmd")
    case "$base" in enforce-suite.sh) n_suite=$((n_suite + 1)) ;; esac
    if [ ! -f "$cmd" ]; then
      missing="$missing$phase|$cmd
"
    elif [ ! -x "$cmd" ]; then
      _dr_bad "$phase: $(_dr_tilde "$cmd") is registered but not executable"
      _dr_fix "aether install $1"
    fi
    # Same script name at two paths means it runs twice per tool call.
    case "$seen" in *" $base "*) dup="$dup $base" ;; *) seen="$seen $base " ;; esac
  done <<EOF
$probe
EOF

  if [ -n "$missing" ]; then
    while IFS='|' read -r phase cmd; do
      [ -n "$cmd" ] || continue
      _dr_bad "$phase: $(_dr_tilde "$cmd") is registered but does not exist"
      _dr_note "Claude Code tries to run it on every matching tool call"
      _dr_fix "aether doctor --fix"
    done <<EOF
$missing
EOF
    _DR_FIXABLE="$_DR_FIXABLE missing-hooks"
  fi

  local d
  for d in $(printf '%s\n' $dup | sort -u); do
    _dr_bad "$d is registered more than once — it fires once per registration"
    while IFS=$'\t' read -r kind _phase _matcher cmd; do
      [ "$kind" = hook ] && [ "$(basename "${cmd:-x}")" = "$d" ] \
        && _dr_note "$(_dr_tilde "$cmd")$([ -f "$cmd" ] || printf '   (missing)')"
    done <<EOF
$probe
EOF
    _dr_fix "aether doctor --fix"
    _DR_FIXABLE="$_DR_FIXABLE duplicate-hooks"
  done

  case "$n_suite" in
    1) [ -z "$missing$dup" ] && _dr_ok "suite hook registered once, present and executable" ;;
    0) _dr_bad "the suite hook is not registered"; _dr_fix "aether install $1" ;;
    *) _dr_bad "the suite hook is registered $n_suite times"; _dr_fix "aether install $1" ;;
  esac
  return 0
}

_doctor_mcp() {
  local deep="$2" probe plugin names n
  probe=$(_json_probe "$(_settings "$1")" "$HOME/.claude.json" 2>/dev/null) || return 0
  for plugin in $(_plugins_available); do
    names=$(_dr_mcp_names "$plugin"); [ -n "$names" ] || continue
    # Only judge a plugin that is actually installed.
    case " $(_manifest_get plugins) " in *" $plugin "*) ;; *) continue ;; esac
    for n in $names; do
      local got cmd args
      got=$(printf '%s\n' "$probe" | awk -F'\t' -v n="$n" '$1=="mcp" && $2==n {print $3"\t"$4; exit}')
      if [ -z "$got" ]; then
        _dr_bad "MCP $n is not registered in ~/.claude.json, but $plugin is installed"
        _dr_fix "aether install $plugin $1"
        continue
      fi
      cmd="${got%%	*}"; args="${got#*	}"
      if [ -z "$cmd" ]; then
        _dr_bad "MCP $n is registered with an empty command"
        _dr_fix "aether install $plugin $1"; continue
      fi
      command -v "$cmd" >/dev/null 2>&1 \
        || { _dr_bad "MCP $n: $cmd is not on PATH"; _dr_fix "install $cmd, then aether install $plugin $1"; continue; }
      local a bad_path=""
      for a in $args; do
        case "$a" in /*) [ -e "$a" ] || bad_path="$a" ;; esac
      done
      if [ -n "$bad_path" ]; then
        _dr_bad "MCP $n: $(_dr_tilde "$bad_path") does not exist"
        _dr_note "the clone may have moved, or $plugin was never built"
        _dr_fix "aether install $plugin $1"; continue
      fi
      if [ "$deep" = true ]; then
        if _dr_handshake "$cmd" $args; then _dr_ok "MCP $n answers tools/list"
        else _dr_bad "MCP $n is registered but does not answer a handshake"
             _dr_fix "aether install $plugin $1"; fi
      else
        _dr_ok "MCP $n: $cmd, paths present"
      fi
    done
  done
  return 0
}

# Every mcp.<name>.command key a plugin declares, ignoring the mcp.published.*
# variants, which describe how the servers would be fetched rather than run.
_dr_mcp_names() {
  local repo f; repo=$(_repo_root) || return 0
  f="$repo/plugins/$1/aether.plugin"; [ -f "$f" ] || return 0
  sed -n 's/^mcp\.\([a-z0-9-]*\)\.command:.*/\1/p' "$f" | sort -u
}

_dr_handshake() {
  printf '%s\n' \
    '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"aether-doctor","version":"1"}}}' \
    '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
    '{"jsonrpc":"2.0","id":2,"method":"tools/list"}' \
  | "$@" 2>/dev/null | grep -q '"tools"'
}

_doctor_manifest() {
  local scope="$1" mf; mf=$(_manifest_for "$scope")
  [ -f "$mf" ] || { _dr_warn "no install manifest at $(_dr_tilde "$mf")"
                    _dr_fix "aether install $scope"; return 0; }
  local n=0 gone=0 c cdir; cdir=$(_commands_dir "$scope")
  for c in $(_manifest_get commands); do
    n=$((n + 1)); [ -f "$cdir/$c" ] || { gone=$((gone + 1)); _dr_bad "$c is recorded but not in $(_dr_tilde "$cdir")"; }
  done
  local rec
  for key in hook gates; do
    rec=$(_manifest_get "$key"); [ -n "$rec" ] || continue
    n=$((n + 1)); [ -e "$rec" ] || { gone=$((gone + 1)); _dr_bad "$key is recorded at $(_dr_tilde "$rec") but is not there"; }
  done
  [ "$gone" -eq 0 ] && _dr_ok "$n manifest entries all present on disk" \
                    || _dr_fix "aether install $scope"

  # A command from before the rename is not inert: it stays in the palette and
  # runs the stale copy.
  local stale="" plugin lc
  for plugin in $(_plugins_available); do
    for lc in $(_mf "$plugin" legacy_commands); do
      [ -f "$cdir/$lc" ] && stale="$stale $lc"
    done
  done
  if [ -n "$stale" ]; then
    _dr_warn "$(printf '%s' "$stale" | wc -w | tr -d ' ') command(s) from a pre-1.0 install are still in the palette"
    _dr_note "$(printf '%s' "${stale# }")"
    _dr_fix "aether install $scope"
  fi
  return 0
}

_doctor_layout() {
  local scope="$1" left=""
  [ -e "$LEGACY_HOOK_DIR" ] && left="$left $(_dr_tilde "$LEGACY_HOOK_DIR")"
  [ -f "$LEGACY_GLOBAL_MANIFEST" ] && left="$left $(_dr_tilde "$LEGACY_GLOBAL_MANIFEST")"
  local sec
  for sec in $AETHER_LEGACY_SECTIONS; do
    [ -f "$HOME/.claude/$sec.config" ] && left="$left $(_dr_tilde "$HOME/.claude/$sec.config")"
    [ -f "./$sec.config" ] && left="$left ./$sec.config"
  done
  [ -f .claude/plans/CRITIQUE.md ] && left="$left .claude/plans/CRITIQUE.md"
  [ -f .claude/plans/TEMPER.md ]   && left="$left .claude/plans/TEMPER.md"
  if [ -n "$left" ]; then
    _dr_warn "the pre-1.0 layout is still on disk"
    _dr_note "${left# }"
    _dr_fix "aether migrate"
  else
    _dr_ok "nothing left from the pre-1.0 layout"
  fi
  return 0
}

_doctor_clone() {
  local rec; rec=$(_manifest_get repo)
  if [ -z "$rec" ]; then
    _dr_warn "the manifest records no clone path"; _dr_fix "aether install $1"; return 0
  fi
  if [ -d "$rec/plugins" ]; then _dr_ok "clone present at $(_dr_tilde "$rec")"
  else
    _dr_bad "the recorded clone is gone: $(_dr_tilde "$rec")"
    _dr_note "aether update needs it, and bonsai's MCP servers point into it"
    _dr_fix "re-clone there, or run install.sh from the new location"
  fi
  return 0
}

_doctor_perms() {
  local probe want have missing="" p
  probe=$(_json_probe "$(_settings "$1")" "$HOME/.claude.json" 2>/dev/null) || return 0
  have=" $(printf '%s\n' "$probe" | awk -F'\t' '$1=="perm"{print $2}' | tr '\n' ' ')"
  want="Bash Read Write"
  for p in $(_manifest_get plugins); do want="$want $(_mf "$p" permissions)"; done
  for p in $(printf '%s\n' $want | sort -u); do
    case "$have" in *" $p "*) ;; *) missing="$missing $p" ;; esac
  done
  [ -z "$missing" ] && _dr_ok "permissions match what the installed plugins declare" \
    || { _dr_bad "permissions missing from settings.json:$missing"; _dr_fix "aether install $1"; }
  return 0
}

_doctor_gates() {
  local gates g bad="" n=0
  gates=$(_gates_dir "$1")
  [ -d "$gates" ] || { _dr_warn "no gates directory at $(_dr_tilde "$gates")"; _dr_fix "aether install $1"; return 0; }
  for g in "$gates"/enforce-*.sh; do
    [ -f "$g" ] || continue
    n=$((n + 1)); bash -n "$g" 2>/dev/null || bad="$bad $(basename "$g")"
  done
  [ "$n" -eq 0 ] && { _dr_warn "no gates installed"; _dr_fix "aether install $1"; return 0; }
  [ -z "$bad" ] && _dr_ok "$n gates parse" \
    || { _dr_bad "gates that fail to parse and are being skipped:$bad"; _dr_fix "aether install $1"; }
  return 0
}

# ── trust ────────────────────────────────────────────────────────────────────

_doctor_trust() {
  local dead="" changed="" ok=0 state path
  while IFS=$'\t' read -r state path; do
    [ -n "$path" ] || continue
    case "$state" in
      dead)    dead="$dead$path
" ;;
      changed) changed="$changed$path
" ;;
      ok)      ok=$((ok + 1)) ;;
    esac
  done <<EOF
$(aether_trust_entries)
EOF
  [ "$ok" -gt 0 ] && _dr_ok "$ok project(s) trusted and unchanged"
  if [ -n "$dead" ]; then
    _dr_warn "$(printf '%s' "$dead" | grep -c . || true) entry(ies) point at a directory that no longer exists"
    printf '%s' "$dead" | while IFS= read -r path; do [ -n "$path" ] && _dr_note "$(_dr_tilde "$path")"; done
    _dr_fix "aether trust prune"
    _DR_FIXABLE="$_DR_FIXABLE dead-trust"
  fi
  if [ -n "$changed" ]; then
    _dr_warn "$(printf '%s' "$changed" | grep -c . || true) project(s) edited since being trusted"
    printf '%s' "$changed" | while IFS= read -r path; do [ -n "$path" ] && _dr_note "$(_dr_tilde "$path")"; done
    _dr_note "their [project] commands and rules.md are being ignored"
    _dr_fix "aether trust, in that directory, after reviewing the change"
  fi
  [ -z "$dead$changed" ] && [ "$ok" -eq 0 ] && _dr_ok "no projects trusted yet"
  return 0
}

_dr_tilde() { printf '%s' "${1/#$HOME/~}"; }

# ── --fix ────────────────────────────────────────────────────────────────────
# Only where the correct action is unambiguous. A doctor that guesses is worse
# than one that reports, so everything else prints the command instead.

_doctor_fix() {
  local scope="$1" settings probe
  settings=$(_settings "$scope")
  probe=$(_json_probe "$settings" "$HOME/.claude.json" 2>/dev/null) || return 0

  # Work out everything to do BEFORE touching anything, so a run with nothing to
  # fix leaves the home directory byte-identical — including not writing a .bak.
  local drop="" kind cmd base seen="" dup="" ours
  ours=$(_hook_dir "$scope")

  while IFS=$'\t' read -r kind _phase _matcher cmd; do
    [ "$kind" = hook ] && [ -n "$cmd" ] || continue
    [ -f "$cmd" ] || drop="$drop$cmd
"
    base=$(basename "$cmd")
    case "$seen" in *" $base "*) dup="$dup $base" ;; *) seen="$seen $base " ;; esac
  done <<EOF
$probe
EOF

  # A duplicate where both files exist: keep the one under this scope's hook
  # directory, which is the one the engine installed.
  for base in $(printf '%s\n' $dup | sort -u); do
    while IFS=$'\t' read -r kind _phase _matcher cmd; do
      [ "$kind" = hook ] && [ "$(basename "${cmd:-x}")" = "$base" ] || continue
      case "$cmd" in "$ours"/*) continue ;; esac
      [ -f "$cmd" ] || continue                     # already in $drop
      case "$drop" in *"$cmd
"*) ;; *) drop="$drop$cmd
" ;; esac
    done <<EOF
$probe
EOF
  done

  local dead; dead=$(DRY_RUN=true _trust_prune_dead)

  if [ -z "$drop" ] && [ "${dead:-0}" -eq 0 ]; then
    printf '  nothing to fix automatically.\n'; return 0
  fi

  [ -n "$drop" ] && _backup "$settings" 2>/dev/null || true
  printf '%s' "$drop" | while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    if _json_drop_hooks_matching "$settings" "$cmd"; then
      if [ -f "$cmd" ]; then printf '  ✓ deregistered the duplicate %s\n' "$(_dr_tilde "$cmd")"
      else printf '  ✓ deregistered %s (the file does not exist)\n' "$(_dr_tilde "$cmd")"; fi
    fi
  done

  if [ "${dead:-0}" -gt 0 ]; then
    local n; n=$(_trust_prune_dead)
    printf '  ✓ pruned %s trust entry(ies) whose directory no longer exists\n' "$n"
  fi
  return 0
}

cmd_doctor() {
  local scope="" want=all fix=false deep=false a
  for a in "$@"; do
    case "$a" in
      --fix)      fix=true ;;
      --deep)     deep=true ;;
      --install)  want=install ;;
      --config)   want=config ;;
      global|--global) scope=global ;;
      local)      scope=local ;;
      *) printf 'Unknown option: %s\n' "$a"; return 1 ;;
    esac
  done
  # Default to whichever scope is actually installed here.
  [ -n "$scope" ] || { scope=$(_manifest_get scope); scope="${scope:-global}"; }

  _DR_BAD=0; _DR_WARN=0; _DR_FIXABLE=""

  if [ "$want" = all ] || [ "$want" = install ]; then
    printf '\ninstall (%s)\n' "$scope"
    _doctor_hooks    "$scope"
    _doctor_mcp      "$scope" "$deep"
    _doctor_manifest "$scope"
    _doctor_perms    "$scope"
    _doctor_gates    "$scope"
    _doctor_layout   "$scope"
    _doctor_clone    "$scope"
  fi
  if [ "$want" = all ] || [ "$want" = config ]; then
    printf '\nconfig\n'
    _doctor_config
    printf '\ntrust\n'
    _doctor_trust
  fi

  if [ "$fix" = true ]; then
    printf '\nfixing\n'
    _doctor_fix "$scope"
    printf '\nRe-run `aether doctor` to confirm.\n'
    return 0
  fi

  printf '\n'
  if [ "$_DR_BAD" -eq 0 ] && [ "$_DR_WARN" -eq 0 ]; then
    printf 'No problems found.\n'; return 0
  fi
  printf '%s problem(s), %s warning(s).\n' "$_DR_BAD" "$_DR_WARN"
  [ -n "$_DR_FIXABLE" ] && printf 'Some of this is repairable: aether doctor --fix\n'
  [ "$_DR_BAD" -gt 0 ] && return 1
  return 0
}

cmd_config() {
  local sub="${1:-show}"; shift 2>/dev/null || true
  case "$sub" in
    show)    cmd_config_show "$@" ;;
    explain) cmd_config_explain "$@" ;;
    doctor)  cmd_config_doctor "$@" ;;
    path)    _cfg_file "$(_cfg_scope_from_args "$@")"; printf '\n' ;;
    edit)
      local f; f=$(_cfg_file "$(_cfg_scope_from_args "$@")")
      mkdir -p "$(dirname "$f")"; [ -f "$f" ] || _seed_config "$f"
      "${EDITOR:-vi}" "$f" ;;
    get)
      # Falls back to the schema default, so this prints the value that is
      # actually in effect rather than "" for anything left unset.
      local parsed section key val plugin
      parsed=$(_split_key "${1:-}"); section="${parsed%% *}"; key="${parsed#* }"
      case "$section" in project:*) val=$(_cfg_area "$section" "$key") ;;
                         *)         val=$(_cfg_get  "$section" "$key") ;; esac
      if [ -z "$val" ]; then
        plugin=$(_schema_plugin_for "$section" "$key")
        [ -n "$plugin" ] && val=$(_mf "$plugin" "config.$key.default")
      fi
      printf '%s\n' "$val" ;;
    set)
      local raw="${1:-}" value="${2:-}"
      [ -n "$raw" ] && [ -n "$value" ] || { printf 'Usage: aether config set <section>.<key> <value> [global]\n'; return 1; }
      shift 2
      local parsed section key scope plugin
      parsed=$(_split_key "$raw"); section="${parsed%% *}"; key="${parsed#* }"
      scope=$(_cfg_scope_from_args "$@")
      plugin=$(_schema_plugin_for "$section" "$key")
      [ -n "$plugin" ] || printf 'Warning: no plugin declares %s.%s — it will be ignored.\n' "$section" "$key"
      _cfg_set "$(_cfg_file "$scope")" "$section" "$key" "$value" \
               "$([ -n "$plugin" ] && _mf "$plugin" "config.$key.doc")"
      printf '  ✓ %s.%s = %s  (%s)\n' "$section" "$key" "$value" "$(_cfg_file "$scope")"
      # You made this change through aether, so it does not cost a re-prompt.
      # Hand-editing does, which is the whole point of the hash.
      [ "$scope" = local ] && [ "$(aether_trust_state)" != none ] && _trust_record
      return 0 ;;
    unset)
      local raw="${1:-}"; [ -n "$raw" ] || { printf 'Usage: aether config unset <section>.<key> [global]\n'; return 1; }
      shift
      local parsed; parsed=$(_split_key "$raw")
      local uscope; uscope=$(_cfg_scope_from_args "$@")
      _cfg_unset "$(_cfg_file "$uscope")" "${parsed%% *}" "${parsed#* }"
      printf '  ✓ unset %s\n' "$raw"
      [ "$uscope" = local ] && [ "$(aether_trust_state)" != none ] && _trust_record
      return 0 ;;
    *) printf 'Unknown: aether config %s\n\nTry: show, explain, doctor, path, edit, get, set, unset\n' "$sub"; return 1 ;;
  esac
}

# A first config that answers "what can I put here?" without leaving the file.
# Every key is present but commented out at its default, so a commented line
# reads as a suggestion rather than a decision the user has to look up.
_seed_config() {
  local dest="$1"
  [ -f "$dest" ] && return 0
  _dry && { printf '  [dry-run] seed %s\n' "$dest"; return 0; }
  mkdir -p "$(dirname "$dest")"
  {
    printf '# aether config — every key below is commented out at its default.\n'
    printf '# Uncomment a line to change it.  `aether config show` prints what is live.\n'
    local last="" section key plugin doc def used
    while IFS='|' read -r section key plugin; do
      [ "$section" = "$last" ] || { printf '\n[%s]\n' "$section"; last="$section"; }
      doc=$(_mf "$plugin" "config.$key.doc")
      def=$(_mf "$plugin" "config.$key.default")
      used=$(_mf "$plugin" "config.$key.used_by")
      [ -n "$doc" ] && printf '# %s%s\n' "$doc" "${used:+  → $used}"
      printf '# %s: %s\n' "$key" "$def"
    done <<EOSEED
$(_schema_all)
EOSEED
  } > "$dest"
}

# ═══════════════════════════════════════════════════════════════════════════
# TRUST
# ═══════════════════════════════════════════════════════════════════════════

# _trust_record — write (or refresh) this project's hash
_trust_record() {
  local f here h tmp
  f=$(aether_trust_file); here=$(pwd -P); h=$(aether_hash_project)
  _dry && { printf '  [dry-run] would trust %s\n' "$here"; return 0; }
  mkdir -p "$(dirname "$f")"; [ -f "$f" ] || : > "$f"
  tmp="$f.tmp"
  awk -v p="$here" '{ i = index($0, " "); if (substr($0, i + 1) != p) print }' "$f" > "$tmp"
  printf '%s %s\n' "$h" "$here" >> "$tmp"
  mv "$tmp" "$f"
}

# Prints how many it removed, so the caller can stay quiet when there were none.
_trust_prune_dead() {
  local f tmp n=0 state path
  f=$(aether_trust_file); [ -f "$f" ] || { printf 0; return 0; }
  tmp="$f.tmp"; : > "$tmp"
  while IFS=$'\t' read -r state path; do
    [ -n "$path" ] || continue
    if [ "$state" = dead ]; then n=$((n + 1)); continue; fi
    grep -F -- " $path" "$f" >> "$tmp" 2>/dev/null || true
  done <<EOF
$(aether_trust_entries)
EOF
  if _dry; then rm -f "$tmp"; printf '%s' "$n"; return 0; fi
  mv "$tmp" "$f"
  printf '%s' "$n"
}

# <path> — drop one recorded project, wherever it is. _trust_forget is this for the
# current directory; the migration needs it for a subdirectory it just emptied.
_trust_forget_path() {
  local f tmp target="$1"
  [ -n "$target" ] || return 0
  f=$(aether_trust_file); [ -f "$f" ] || return 0
  _dry && return 0
  tmp="$f.tmp"
  awk -v p="$target" '{ i = index($0, " "); if (substr($0, i + 1) != p) print }' "$f" > "$tmp"
  mv "$tmp" "$f"
}

_trust_forget() {
  local f here tmp
  f=$(aether_trust_file); here=$(pwd -P)
  [ -f "$f" ] || return 0
  _dry && { printf '  [dry-run] would untrust %s\n' "$here"; return 0; }
  tmp="$f.tmp"
  awk -v p="$here" '{ i = index($0, " "); if (substr($0, i + 1) != p) print }' "$f" > "$tmp"
  mv "$tmp" "$f"
}

# What the user is consenting to, shown before they consent to it. Anything else
# would make `aether trust` a formality.
_trust_preview() {
  local any=0 v k sec
  if [ -f .aether/config ]; then
    # Every area, not just the root. In a monorepo all the commands live in
    # [project:<path>] sections, so reading only [project] showed nothing at all
    # while authorising a dozen — which turns the preview into a formality, the
    # exact thing it exists to prevent.
    while IFS= read -r sec; do
      [ -n "$sec" ] || continue
      # Keys come straight from the file, not from _check_keys — that resolves
      # through the trust gate, and during a preview the project is untrusted by
      # definition, so it would show almost nothing. Showing you the file is the point.
      while IFS= read -r k; do
        [ -n "$k" ] || continue
        _cfg_is_command "$k" || continue
        v=$(aether_cfg_read .aether/config "$sec" "$k")
        [ -n "$v" ] || continue
        [ "$any" -eq 0 ] && { printf '\n  Commands the critics would run:\n'; any=1; }
        if [ "$sec" = project ]; then printf '    %-24s %s\n' "$k" "$v"
        else printf '    %-24s %s\n' "${sec#project:}/$k" "$v"; fi
      done <<EOTK
$(aether_cfg_keys .aether/config | awk -F'|' -v s="$sec" '$1 == s { print $2 }')
EOTK
    done <<EOTS
$(_project_areas)
EOTS
  fi
  if [ -f .aether/rules.md ]; then
    printf '\n  Prose that would reach a critic (.aether/rules.md, %s line(s)):\n' \
      "$(awk 'END{print NR}' .aether/rules.md)"
    awk 'NR <= 12 { printf "    %s\n", $0 } END { if (NR > 12) printf "    … %d more line(s)\n", NR - 12 }' .aether/rules.md
    any=1
  fi
  [ "$any" -eq 0 ] && printf '\n  Nothing executable and no prose — this project only sets thresholds.\n'
  return 0
}

# ── DOCS ─────────────────────────────────────────────────────────────────────
# `aether docs` — the claims a repository's prose makes about itself, checked
# against the things that already know the answer.
#
# It exists because every defect in the 1.5.0 documentation audit was found by
# hand, and eight of the ten were mechanically detectable. The most valuable
# family is not generic markdown hygiene: it is that **`[project]` already
# declares how this repo really runs**, so prose saying otherwise is drift — and
# it is the drift that hurts most, because it is what a new joiner follows.
#
# Deliberately narrow. A doc checker that reports plausible-but-wrong findings
# gets deleted from the config within a week, so nothing here is inferred: every
# check compares a documented string against a declared or on-disk fact. Anything
# needing judgement belongs to the Docs critic in /critique-diff.

# Files to scan: [docs] paths, minus [docs] ignore. Defaults to the markdown a
# reader actually lands on rather than every .md in the tree.
_docs_files() {
  local paths ignore p f
  paths=$(_cfg_get docs paths);   paths="${paths:-*.md docs}"
  ignore=$(_cfg_get docs ignore); ignore="${ignore:-CHANGELOG.md}"
  for p in $paths; do
    if [ -d "$p" ]; then
      find "$p" -type f -name '*.md' 2>/dev/null
    else
      # Unquoted on purpose: `*.md` is a glob the caller wants expanded.
      for f in $p; do [ -f "$f" ] && printf '%s\n' "$f"; done
    fi
  done | sed 's|^\./||' | sort -u | while IFS= read -r f; do
    local skip=0 ig
    for ig in $ignore; do
      case "$f" in $ig|$ig/*|*/$ig) skip=1; break ;; esac
    done
    [ "$skip" = 0 ] && printf '%s\n' "$f"
  done
}

# The schema as the scanner needs it, plus the facts only the engine knows:
# which subcommands exist, which flags help documents, what [project] declares.
_docs_context() {
  local areas a k v subs psubs plugins help scripts targets
  # [A-Za-z] and not just [a-z]: the label is `version|--version|-V)`, and a
  # lowercase-only class silently dropped the whole line, so `aether version` was
  # reported as not a subcommand.
  subs=$(sed -n '/^case "$COMMAND" in/,/^esac/p' "$0" \
         | grep -oE '^  [A-Za-z|_-]+\)' | tr -d ' )' | tr '|' '\n' \
         | grep -v '^-' | grep -v '^$' | sort -u)
  psubs="status enable disable install uninstall update hook config help"
  plugins=$(_plugins_available)
  help=$(usage 2>/dev/null | grep -oE '\-\-[a-z][a-z-]*' | sort -u)
  scripts=$([ -f package.json ] && python3 -c 'import json,sys
try: print("\n".join(json.load(open("package.json")).get("scripts", {})))
except Exception: pass' 2>/dev/null)
  targets=$([ -f Makefile ] && sed -n 's/^\([A-Za-z0-9_.-]*\):.*/\1/p' Makefile 2>/dev/null)
  areas=$(_project_areas); areas="${areas:-project}"

  {
    printf 'root\t%s\n' "$PWD"
    _docs_files      | sed 's/^/file\t/'
    printf '%s\n' "$subs"    | sed '/^$/d;s/^/sub\t/'
    printf '%s\n' "$psubs"   | tr ' ' '\n' | sed '/^$/d;s/^/psub\t/'
    printf '%s\n' "$plugins" | sed '/^$/d;s/^/plugin\t/'
    printf '%s\n' "$help"    | sed '/^$/d;s/^/flag\t/'
    printf '%s\n' "$scripts" | sed '/^$/d;s/^/script\t/'
    printf '%s\n' "$targets" | sed '/^$/d;s/^/target\t/'
    printf 'legacy\t%s\n' whetstone.config.md
    for p in $plugins; do printf 'legacy\t%s.config\n' "$p"; done
    _schema_all | while IFS='|' read -r sec key plug; do
      [ -n "$key" ] || continue
      printf 'schema\t%s\t%s\t%s\n' "$sec" "$key" "$(_mf "$plug" "config.$key.type")"
    done
    while IFS= read -r a; do
      [ -n "$a" ] || continue
      for k in test lint format typecheck build coverage; do
        v=$(_cfg_area "$a" "$k")
        [ -n "$v" ] && printf 'area\t%s\t%s\t%s\n' "$a" "$k" "$v"
      done
    done <<EOAREAS
$areas
EOAREAS
  }
}

cmd_docs() {
  local a raw=false
  for a in "$@"; do
    case "$a" in
      --raw) raw=true ;;
      *) printf 'Unknown option: %s\n' "$a"; return 1 ;;
    esac
  done

  command -v python3 >/dev/null 2>&1 || {
    printf 'aether docs needs python3 to read markdown.\n'; return 0; }

  # An empty `[docs] paths` is how you turn this off — one concept rather than a
  # separate `enabled` key that could disagree with it.
  local n; n=$(_docs_files | grep -c . || true)
  if [ "${n:-0}" -eq 0 ]; then
    printf 'No documentation to check. Set [docs] paths, or add a README.\n'
    return 0
  fi

  local findings
  findings=$(_docs_context | python3 -c 'import os, re, sys

# Context arrives on stdin as tab-separated records, because the program itself
# comes in via -c. (`python3 - <<EOF` would claim stdin for the program and leave
# none for the data — the bug that stopped the engine registering MCP servers for
# six commits.) TSV rather than JSON so the bash side needs no encoder.
ROOT, FILES, LEGACY = ".", [], []
AREAS, SCHEMA, SECTIONS = {}, {}, set()
SUBS, PSUBS, PLUGINS, HELP, SCRIPTS, TARGETS = set(), set(), set(), set(), set(), set()

for rec in sys.stdin.read().split("\n"):
    if not rec:
        continue
    f = rec.split("\t")
    kind = f[0]
    if   kind == "root"   and len(f) > 1: ROOT = f[1]
    elif kind == "file"   and len(f) > 1: FILES.append(f[1])
    elif kind == "sub"    and len(f) > 1: SUBS.add(f[1])
    elif kind == "psub"   and len(f) > 1: PSUBS.add(f[1])
    elif kind == "plugin" and len(f) > 1: PLUGINS.add(f[1])
    elif kind == "flag"   and len(f) > 1: HELP.add(f[1])
    elif kind == "script" and len(f) > 1: SCRIPTS.add(f[1])
    elif kind == "target" and len(f) > 1: TARGETS.add(f[1])
    elif kind == "legacy" and len(f) > 1: LEGACY.append(f[1])
    elif kind == "schema" and len(f) > 3:
        SECTIONS.add(f[1]); SCHEMA[f[1] + "." + f[2]] = {"type": f[3]}
    elif kind == "area"   and len(f) > 3:
        AREAS.setdefault(f[1], {})[f[2]] = f[3]

# Keys exactly one section declares, so a section-less example can still be
# attributed without guessing.
_by_key = {}
for full_key in SCHEMA:
    sec, _, k = full_key.partition(".")
    _by_key.setdefault(k, set()).add(sec)
UNIQUE = {k: list(v)[0] for k, v in _by_key.items() if len(v) == 1}

seen, out = set(), []
def add(sev, path, line, msg, fix=None, note=None):
    k = (path, line, msg)
    if k in seen:      # one line can carry the same broken link twice
        return
    seen.add(k)
    out.append((sev, path, line, msg, fix or "", note or ""))

FENCE   = re.compile(r"^\s*(```+|~~~+)\s*([A-Za-z0-9_+-]*)")
HEADING = re.compile(r"^(#{1,6})\s+(.+?)\s*$")
LINK    = re.compile(r"\[[^\]]*\]\(\s*([^)\s]+)")
SECTION = re.compile(r"^\s*\[([A-Za-z0-9_:./-]+)\]\s*$")
KEYVAL  = re.compile(r"^\s*([A-Za-z0-9_][A-Za-z0-9_.-]*)\s*:\s*(.*?)\s*$")
RUNNERS = ("npm", "yarn", "pnpm", "bun")
# Prose that means "we are describing the old world on purpose".
MIGRATION = re.compile(r"migrat|legacy|pre-1\.|before v1|superseded|retired|used to", re.I)

def slug(text):
    """GitHub'\''s heading slug. Each space becomes one hyphen — runs are NOT
    collapsed, which is why `Monorepos — [project]` is monorepos--project."""
    t = re.sub(r"`([^`]*)`", r"\1", text)
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", t)
    t = t.strip().lower()
    t = re.sub(r"[^\w\s-]", "", t, flags=re.UNICODE)
    return t.replace(" ", "-")

def strip_comment(s):
    in_s = in_d = False
    for i, c in enumerate(s):
        if c == "\\":
            continue
        if c == "'\''" and not in_d:
            in_s = not in_s
        elif c == '\''"'\'' and not in_s:
            in_d = not in_d
        elif c == "#" and not in_s and not in_d and (i == 0 or s[i - 1].isspace()):
            return s[:i]
    return s

def segments(line):
    s = strip_comment(line).strip()
    if not s:
        return []
    return [p.strip() for p in re.split(r"&&|\|\||[;|]", s) if p.strip()]

def resolves(rel, full, cwd):
    """Does this relative path exist from any base a reader could plausibly be at?

    A fenced block often opens with `git clone … && cd aether/plugins/bonsai`, so
    `bash scripts/setup.sh` is correct from there and nonsense from the repo root.
    Reporting it would be exactly the false alarm that gets a doc check switched
    off, so try every base the block makes plausible and only complain if none
    of them has the file."""
    bases = [ROOT, os.path.dirname(full) or ROOT]
    if cwd:
        bases += [os.path.join(ROOT, cwd), os.path.join(os.path.dirname(full) or ROOT, cwd)]
        # `cd aether/plugins/bonsai` right after a clone: the first segment is the
        # clone directory, which is this repo.
        tail = cwd.split("/", 1)
        if len(tail) == 2:
            bases.append(os.path.join(ROOT, tail[1]))
    return any(os.path.exists(os.path.normpath(os.path.join(b, rel))) for b in bases)

def toks(seg):
    try:
        import shlex
        return shlex.split(seg)
    except Exception:
        return seg.split()

for path in FILES:
    full = os.path.join(ROOT, path)
    try:
        lines = open(full, encoding="utf-8", errors="replace").read().split("\n")
    except OSError:
        continue

    # Pass 1: fence extents, and whether a fence shows a prompt. A block with
    # `$ cmd` lines is a transcript: everything else in it is *output*, not a
    # command. Treating output as commands reported `aether v1.5.0` as an
    # unknown subcommand — noise that would get this whole check switched off.
    blocks, open_at, lang = [], None, ""
    for i, ln in enumerate(lines):
        m = FENCE.match(ln)
        if not m:
            continue
        if open_at is None:
            open_at, lang = i, (m.group(2) or "").lower()
        else:
            body = lines[open_at + 1:i]
            blocks.append((open_at, i, lang,
                           any(re.match(r"^\s*\$ ", b) for b in body)))
            open_at = None
    fenced = {}
    for a, b, lg, prompted in blocks:
        for i in range(a, b + 1):
            fenced[i] = (lg, prompted, i == a or i == b)

    slugs = set()
    for i, ln in enumerate(lines):
        if i in fenced:
            continue
        h = HEADING.match(ln)
        if h:
            slugs.add(slug(h.group(2)))

    cfg_section, cwd = None, ""
    for i, raw in enumerate(lines):
        n = i + 1
        info = fenced.get(i)

        if info is None:
            cfg_section = None
            for target in LINK.findall(raw):
                t = target.strip().strip("<>")
                if t.startswith(("http://", "https://", "mailto:", "tel:", "data:", "ftp:")):
                    continue
                if t.startswith("#"):
                    if slug(t[1:]) not in slugs:
                        add("bad", path, n, "link to %s — no heading with that anchor" % t)
                    continue
                filepart = t.split("#", 1)[0]
                if not filepart:
                    continue
                cand = os.path.normpath(os.path.join(os.path.dirname(full), filepart))
                if not os.path.exists(cand):
                    add("bad", path, n, "link to %s — no such file" % filepart)
            continue

        lang, prompted, is_delim = info
        if is_delim:
            cfg_section = None
            if raw.strip().startswith(("```", "~~~")) and i in fenced and fenced[i][2]:
                cwd = ""          # a new block starts wherever the reader is
            continue

        sm = SECTION.match(raw)
        if sm:
            cfg_section = sm.group(1)
            continue
        if lang in ("", "ini", "toml", "conf", "text"):
            kv = KEYVAL.match(raw)
            if kv and not raw.lstrip().startswith("#"):
                key, val = kv.group(1), strip_comment(kv.group(2)).strip()
                base = None
                if cfg_section:
                    base = "project" if cfg_section.startswith("project:") else cfg_section
                elif key in UNIQUE:
                    # A section-less block — the pre-1.1 config format, and still how
                    # a lot of prose shows settings. Only keys that exactly one section
                    # declares are safe to attribute: `critical_paths` is temper'\''s alone,
                    # while `enabled` belongs to all five and could be anything.
                    base = UNIQUE[key]
                if base and base in SECTIONS and not key.startswith("check."):
                    spec = SCHEMA.get(base + "." + key)
                    if spec is None:
                        add("bad", path, n, "[%s] %s — no plugin declares this key" % (base, key),
                            fix="aether config show %s" % base)
                    elif val:
                        t = spec.get("type", "")
                        if t == "patternlist" and "|" not in val and re.search(r"[, ]", val):
                            add("bad", path, n,
                                "[%s] %s is pipe-separated; this example is %s-separated and matches nothing"
                                % (base, key, "comma" if "," in val else "space"),
                                fix="join the patterns with |")
                        elif t == "bool" and val not in ("true", "false"):
                            add("bad", path, n, "[%s] %s must be true or false, not %r" % (base, key, val))
                        elif t.startswith("enum:") and val not in [x.strip() for x in t[5:].split(",")]:
                            add("bad", path, n, "[%s] %s must be one of %s, not %r"
                                % (base, key, t[5:], val))
            continue

        if lang not in ("", "bash", "sh", "shell", "console", "zsh"):
            continue
        cmdline = raw
        if prompted:
            m = re.match(r"^\s*\$ (.*)$", raw)
            if not m:
                continue          # output, not a command
            cmdline = m.group(1)

        for seg in segments(cmdline):
            tk = toks(seg)
            if not tk:
                continue
            head = tk[0]

            if head == "cd" and len(tk) > 1:
                cwd = tk[1] if not cwd else os.path.normpath(os.path.join(cwd, tk[1]))
                continue

            if head == "aether" and len(tk) > 1 and not tk[1].startswith("-"):
                if tk[1] in PLUGINS:
                    if len(tk) > 2 and not tk[2].startswith("-") and tk[2] not in PSUBS:
                        add("bad", path, n, "aether %s %s — not a plugin subcommand" % (tk[1], tk[2]))
                elif tk[1] not in SUBS:
                    add("bad", path, n, "aether %s — not a subcommand" % tk[1], fix="aether help")
            elif head in PLUGINS and len(tk) > 1 and not tk[1].startswith("-") and tk[1] not in PSUBS:
                add("bad", path, n, "%s %s — not a plugin subcommand" % (head, tk[1]))

            if (head == "aether" or head in PLUGINS) and HELP:
                for t in tk[1:]:
                    if t.startswith("--") and len(t) > 2:
                        flag = t.split("=", 1)[0]
                        if flag not in HELP:
                            add("bad", path, n, "%s is not a flag %s accepts" % (flag, head), fix="aether help")

            if head in RUNNERS:
                name = None
                if len(tk) > 2 and tk[1] == "run":
                    name = tk[2]
                elif head in ("yarn", "pnpm") and len(tk) > 1 and tk[1] not in ("run", "install", "add", "why", "dlx"):
                    name = tk[1]
                if name and SCRIPTS and name not in SCRIPTS:
                    add("bad", path, n, "%s run %s — package.json has no %r script" % (head, name, name))
            elif head == "make" and len(tk) > 1 and not tk[1].startswith("-"):
                if TARGETS and tk[1] not in TARGETS:
                    add("bad", path, n, "make %s — no such target in the Makefile" % tk[1])
            elif head in ("bash", "sh") and len(tk) > 1 and not tk[1].startswith("-"):
                if "/" in tk[1] and not resolves(tk[1], full, cwd):
                    add("bad", path, n, "%s %s — no such file" % (head, tk[1]))
            elif head.startswith("./") and not resolves(head, full, cwd):
                add("bad", path, n, "%s — no such file" % head)

            for area, keys in AREAS.items():
                for key, declared in keys.items():
                    if not declared:
                        continue
                    dtk = toks(declared)
                    if not dtk or tk == dtk:
                        continue
                    where = "[%s] %s" % (area, key)
                    if len(tk) < len(dtk) and dtk[-len(tk):] == tk:
                        add("warn", path, n, "%s runs this as `%s`" % (where, declared),
                            note="the doc omits the wrapper, so following it skips what the wrapper does")
                    elif head in RUNNERS and dtk[0] in RUNNERS and head != dtk[0]:
                        add("warn", path, n, "%s uses %s, this says %s" % (where, dtk[0], head),
                            fix="aether config explain %s.%s" % (area, key))

    # Legacy paths. A migration note is the one place they belong, so look at the
    # surrounding lines and the enclosing heading before reporting.
    heading_ctx = ""
    for i, raw in enumerate(lines):
        h = HEADING.match(raw)
        if h and i not in fenced:
            heading_ctx = h.group(2)
        window = "\n".join(lines[max(0, i - 3):i + 2])
        if MIGRATION.search(window) or MIGRATION.search(heading_ctx) or MIGRATION.search(raw):
            continue
        for legacy in LEGACY:
            if legacy in raw:
                add("warn", path, i + 1, "%s was replaced by .aether/config in 1.1" % legacy,
                    fix="aether migrate")
                break

# \x1f, not tab: tab is an IFS whitespace character, so bash `read` collapses a run
# of them and an empty field silently shifts every later one left. That put the note
# where the fix belonged and printed it as "fix:".
for sev, path, line, msg, fix, note in sorted(out, key=lambda r: (r[1], r[2])):
    print("\x1f".join((sev, path, str(line), msg, fix, note)))
') || {
    printf 'aether docs: could not scan (see above).\n'; return 0; }

  # The repo's own rule: a check that ran with less context than the config implies
  # has to say so. [project] commands are ignored until `aether trust`, so without it
  # the family that compares prose against the declared commands cannot run at all.
  if [ -f .aether/config ] && grep -q '^\[project' .aether/config 2>/dev/null \
     && [ "$(aether_trust_state)" != ok ]; then
    printf 'Note: this project is not trusted, so [project] commands are not read.\n'
    printf '      Prose contradicting your real test/lint/build commands is not checked.\n'
    printf '      fix: aether trust\n\n'
  fi

  local bad=0 warn=0 cur="" sev fpath fline msg fix note
  # $'\x1f' rather than a tab: tab is IFS whitespace, so `read` collapses runs of
  # them and an empty field shifts every later one left.
  while IFS=$'\x1f' read -r sev fpath fline msg fix note; do
    [ -n "$sev" ] || continue
    [ "$fpath" = "$cur" ] || { cur="$fpath"; printf '%s\n' "$cur"; }
    if [ "$sev" = bad ]; then bad=$((bad + 1)); printf '  ✗ %s:%s  %s\n' "$fpath" "$fline" "$msg"
    else                      warn=$((warn + 1)); printf '  ! %s:%s  %s\n' "$fpath" "$fline" "$msg"; fi
    [ -n "$note" ] && printf '      %s\n' "$note"
    [ -n "$fix" ]  && printf '      fix: %s\n' "$fix"
  done <<EOF
$findings
EOF

  printf '\n'
  if [ "$bad" -eq 0 ] && [ "$warn" -eq 0 ]; then
    printf '%s file(s) checked, nothing to report.\n' "$n"
    return 0
  fi
  printf '%s problem(s), %s warning(s) across %s file(s).\n' "$bad" "$warn" "$n"
  [ "$bad" -gt 0 ] && return 1
  return 0
}

cmd_trust() {
  local sub="${1:-set}"
  case "$sub" in
    list)
      local state path any=""
      while IFS=$'\t' read -r state path; do
        [ -n "$path" ] || continue
        any=1; printf '  %-8s %s\n' "$state" "${path/#$HOME/~}"
      done <<EOF
$(aether_trust_entries)
EOF
      [ -n "$any" ] || printf '  no projects trusted yet\n'
      return 0 ;;
    prune)
      local n; n=$(_trust_prune_dead)
      [ "${n:-0}" -gt 0 ] && printf '  ✓ removed %s entry(ies) whose directory no longer exists\n' "$n" \
                          || printf '  nothing to prune\n'
      return 0 ;;
    --forget|forget|remove)
      _trust_forget; printf '  ✓ %s is no longer trusted\n' "$(pwd -P)" ;;
    status)
      local st; st=$(aether_trust_state)
      printf '  %s: %s\n' "$(pwd -P)" "$st"
      case "$st" in
        ok)      printf '  [project] commands and rules.md are in use.\n' ;;
        changed) printf '  Edited since it was trusted — both are being IGNORED.\n' ;;
        nohash)  printf '  No SHA-256 available (shasum, sha256sum or openssl).\n'
                 printf '  Trust cannot be verified, so nothing is trusted.\n' ;;
        *)       printf '  Untrusted — [project] commands and rules.md are being ignored.\n' ;;
      esac ;;
    *)
      [ -f .aether/config ] || [ -f .aether/rules.md ] || {
        printf 'Nothing to trust: this project has no .aether/config or .aether/rules.md.\n'; return 1; }
      [ "$(aether_trust_state)" = nohash ] && {
        printf 'Cannot trust: no SHA-256 available (shasum, sha256sum or openssl).\n'
        printf 'Trust is a content hash, and a weaker one would not be trust.\n'; return 1; }
      printf 'Trusting %s\n' "$(pwd -P)"
      _trust_preview
      printf '\n'
      _trust_record
      printf '  ✓ trusted. Re-run `aether trust` after editing either file by hand;\n'
      printf '    changes made with `aether config set` re-hash automatically.\n' ;;
  esac
}

# ═══════════════════════════════════════════════════════════════════════════
# MIGRATION  (pre-1.0 layout → <root>)
#
# Idempotent, so an interrupted run finishes on the next attempt, and running
# it on an already-migrated machine is a no-op. Where both old and new exist,
# NEW WINS — the old file is copied to .bak and removed, never merged over the
# top of a value the user has already set in the new place.
# ═══════════════════════════════════════════════════════════════════════════

_retire() {                       # back up, then remove
  local f="$1"
  [ -e "$f" ] || return 0
  _dry && { printf '    would retire %s (backup at %s.bak)\n' "$f" "$f"; return 0; }
  cp -R "$f" "$f.bak" 2>/dev/null || true
  rm -rf "$f"
}

# Old <plugin>.config → one [section] in <root>/config
_migrate_configs() {
  local scope="$1" dest old plugin section key val moved=0
  dest="$(_cfg_file "$scope")"
  for plugin in $(_plugins_available); do
    section=$(_mf "$plugin" config_section); section="${section:-$plugin}"
    [ "$scope" = global ] && old="$HOME/.claude/${section}.config" || old="./${section}.config"
    [ -f "$old" ] || continue
    while IFS= read -r line; do
      case "$line" in ''|'#'*) continue ;; esac
      key="${line%%:*}"; val="${line#*:}"
      # Strip surrounding whitespace without invoking sed per line.
      key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
      val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
      [ -n "$key" ] || continue
      # New wins: only carry a key the new file does not already define.
      [ -n "$(_cfg_read "$dest" "$section" "$key")" ] && continue
      _cfg_set "$dest" "$section" "$key" "$val" "$(_mf "$plugin" "config.$key.doc")"
    done < "$old"
    _retire "$old"; moved=$((moved + 1))
  done
  [ "$moved" -gt 0 ] && printf '    %s config file(s) → %s\n' "$moved" "$dest"
  return 0
}

# Append a section to rules.md unless it is already there. Prose concatenates
# rather than overriding, so re-running must not duplicate a block.
# Returns 1 when there was nothing to do, so the caller stays quiet on a
# re-run instead of reporting an import it did not perform.
_rules_append() {
  local dest="$1" section="$2" src="$3"
  [ -f "$src" ] || return 1
  if [ -f "$dest" ] && grep -q "^\[$section\]$" "$dest"; then return 1; fi
  _dry && { printf '    would import %s → %s [%s]\n' "$src" "$dest" "$section"; return 0; }
  mkdir -p "$(dirname "$dest")"
  [ -s "$dest" ] && printf '\n' >> "$dest"
  printf '[%s]\n' "$section" >> "$dest"
  cat "$src" >> "$dest"
}

# The two prose mechanisms that existed before rules.md, plus cairn's template
# pointer. cairn's pr.rules_file is why one user's rules ended up at
# ~/.cairn/pr-rules.md — a path the suite never defined but happily followed.
_migrate_rules() {
  local scope="$1" dest rules_src tmpl_src
  dest="$(_rules_file "$scope")"

  if [ "$scope" = local ] && [ -f "./whetstone.config.md" ]; then
    _rules_append "$dest" "critique-plan" "./whetstone.config.md"
    _retire "./whetstone.config.md"
    printf '    whetstone.config.md → %s [critique-plan]\n' "$dest"
  fi

  # Read from THIS scope only. Resolving normally would pull a global
  # pr.rules_file into every project's rules.md, turning one setting into a
  # copy in every repo the user migrates.
  rules_src=$(_scoped_cfg "$scope" cairn pr.rules_file)
  rules_src="${rules_src/#\~/$HOME}"
  if [ -n "$rules_src" ] && [ -f "$rules_src" ] \
     && _rules_append "$dest" "draft-pr" "$rules_src"; then
    printf '    %s → %s [draft-pr]\n' "$rules_src" "$dest"
  fi

  tmpl_src=$(_scoped_cfg "$scope" cairn pr.template_file)
  tmpl_src="${tmpl_src/#\~/$HOME}"
  if [ -n "$tmpl_src" ] && [ -f "$tmpl_src" ] \
     && [ ! -f "$(_root "$scope")/templates/pr.md" ]; then
    _op_copy "$tmpl_src" "$(_root "$scope")/templates/pr.md" >/dev/null 2>&1 || true
    printf '    %s → %s/templates/pr.md\n' "$tmpl_src" "$(_root "$scope")"
  fi
  return 0
}

# One scope, new file then old, with no cross-scope fallback.
_scoped_cfg() {
  local scope="$1" section="$2" key="$3" v old
  v=$(aether_cfg_read "$(_cfg_file "$scope")" "$section" "$key")
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  [ "$scope" = global ] && old="$HOME/.claude/$section.config" || old="./$section.config"
  aether_cfg_read "$old" "" "$key"
}

# Generated output leaves .claude/plans/, which is plan mode's directory, not
# ours. Plan files themselves stay — the user wrote those.
_migrate_out() {
  local scope="$1" out src
  [ "$scope" = local ] || return 0
  out="$(_out_dir "$scope")"
  for src in .claude/plans/CRITIQUE.md .claude/plans/TEMPER.md; do
    [ -f "$src" ] || continue
    [ -f "$out/$(basename "$src")" ] || _op_copy "$src" "$out/$(basename "$src")" >/dev/null 2>&1
    _retire "$src"
    printf '    %s → %s/\n' "$src" "$out"
  done
  if [ -f .claude/plans/.whetstone-nudged ]; then
    _dry || { mkdir -p "$out"; : > "$out/.nudged"; }
    _retire .claude/plans/.whetstone-nudged
  fi
  return 0
}

_migrate_manifest() {
  local scope="$1" old new
  [ "$scope" = global ] && old="$LEGACY_GLOBAL_MANIFEST" || old="$LEGACY_LOCAL_MANIFEST"
  new="$(_manifest_for "$scope")"
  [ -f "$old" ] || return 0
  [ -f "$new" ] || _op_copy "$old" "$new" >/dev/null 2>&1
  _retire "$old"
  printf '    %s → %s\n' "$old" "$new"
  return 0
}

# A nested install becomes an area of its parent.
#
# Before `[project:<path>]` existed, the only way to give a subfolder its own
# toolchain was to run `aether install` inside it — which is what pimento did for
# backend/. That leaves the rest of the repo unconfigured and makes the gates fire
# only when the shell happens to be in that directory.
#
# Conservative on two counts. It only touches a directory in the *same git work
# tree*, because a vendored repository in a subdirectory is not an area of a
# monorepo. And it moves `[project]` keys only: any other section is reported and
# left alone, because the parent may already set the same key differently and
# guessing which wins is worse than saying so.
_migrate_nested() {
  local parent_cfg top nested dir sub key val pval moved=0
  [ "$1" = local ] || return 0
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ "$top" = "$(pwd -P)" ] || return 0
  parent_cfg=$(_cfg_file local)

  while IFS= read -r nested; do
    [ -n "$nested" ] || continue
    dir=$(dirname "$(dirname "$nested")")          # foo/.aether/config -> foo
    dir="${dir#./}"
    [ "$dir" = "." ] && continue
    [ "$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" = "$top" ] || {
      printf '    %s/.aether/ is a separate git work tree — left alone\n' "$dir"; continue; }
    sub="project:$dir"

    while IFS='|' read -r nsec nkey; do
      [ -n "$nkey" ] || continue
      val=$(aether_cfg_read "$nested" "$nsec" "$nkey")
      if [ "$nsec" = project ]; then
        if [ -n "$(aether_cfg_read "$parent_cfg" "$sub" "$nkey")" ]; then
          printf '    [%s] %s already set in the parent — nested value not used\n' "$sub" "$nkey"
        else
          _cfg_set "$parent_cfg" "$sub" "$nkey" "$val" \
                   "$(_mf temper "config.$nkey.doc")"
        fi
      else
        pval=$(aether_cfg_read "$parent_cfg" "$nsec" "$nkey")
        if [ -z "$pval" ]; then
          _cfg_set "$parent_cfg" "$nsec" "$nkey" "$val"
        elif [ "$pval" != "$val" ]; then
          printf '    [%s] %s differs — kept the parent\n' "$nsec" "$nkey"
          printf '      parent: %s\n      %s: %s\n' "$pval" "$dir" "$val"
        fi
      fi
    done <<EONK
$(aether_cfg_keys "$nested")
EONK

    if [ -f "$dir/.aether/rules.md" ] && [ ! -f "$(_rules_file local)" ]; then
      _op_copy "$dir/.aether/rules.md" "$(_rules_file local)" >/dev/null 2>&1 || true
      printf '    %s/.aether/rules.md → %s\n' "$dir" "$(_rules_file local)"
    fi
    _retire "$dir/.aether"
    # The nested path may have been trusted in its own right. Its config is gone now,
    # so the entry can never match again and `aether doctor` would report it as
    # `changed` for ever — a permanent warning in the one tool whose job is
    # signalling, which teaches people to ignore it.
    _trust_forget_path "$(cd "$dir" 2>/dev/null && pwd -P)"
    printf '    %s/.aether/ → [%s]  (backup at %s/.aether.bak)\n' "$dir" "$sub" "$dir"
    moved=$((moved + 1))
  done <<EONESTED
$(find . -mindepth 3 -maxdepth 4 -type f -path '*/.aether/config' 2>/dev/null | sort)
EONESTED
  [ "$moved" -gt 0 ] && printf '    %s nested install(s) folded in. Re-run `aether trust`.\n' "$moved"
  return 0
}

_migrate_layout() {
  local scope="$1" any=""
  # Cheap check first: say nothing at all on a machine with nothing to move.
  if [ "$scope" = global ]; then
    [ -e "$LEGACY_HOOK_DIR" ] || [ -f "$LEGACY_GLOBAL_MANIFEST" ] && any=1
  else
    [ -e "$LEGACY_LOCAL_HOOKS/enforce-suite.sh" ] || [ -f "$LEGACY_LOCAL_MANIFEST" ] && any=1
  fi
  for plugin in $(_plugins_available); do
    local sec; sec=$(_mf "$plugin" config_section); sec="${sec:-$plugin}"
    [ "$scope" = global ] && [ -f "$HOME/.claude/${sec}.config" ] && any=1
    [ "$scope" = local  ] && [ -f "./${sec}.config" ] && any=1
  done
  [ "$scope" = local ] && { [ -f ./whetstone.config.md ] || [ -f .claude/plans/CRITIQUE.md ] \
    || [ -f .claude/plans/TEMPER.md ]; } && any=1
  [ "$scope" = local ] && [ -n "$(find . -mindepth 3 -maxdepth 4 -type f -path '*/.aether/config' 2>/dev/null)" ] && any=1
  [ -n "$any" ] || return 0

  printf '  Migrating to %s/\n' "$(_root "$scope")"
  _migrate_rules    "$scope"   # before configs: it reads pr.rules_file from them
  _migrate_configs  "$scope"
  _migrate_out      "$scope"
  _migrate_nested   "$scope"
  _migrate_manifest "$scope"
  return 0
}

# Runs only once the new hook is registered, so an interrupted upgrade can
# never leave a machine with no gate at all.
_retire_legacy_hooks() {
  local scope="$1" newhook
  newhook="$(_hook_dir "$scope")/enforce-suite.sh"
  [ -f "$newhook" ] || return 0
  if [ "$scope" = global ]; then
    [ -e "$LEGACY_HOOK_DIR" ] && { _retire "$LEGACY_HOOK_DIR"
      printf '    retired %s\n' "$LEGACY_HOOK_DIR"; }
  else
    local f
    for f in "$LEGACY_LOCAL_HOOKS/enforce-suite.sh" "$LEGACY_LOCAL_HOOKS/gates" \
             "$LEGACY_LOCAL_HOOKS/plugin-hooks"; do
      [ -e "$f" ] && _retire "$f"
    done
    # Only if we are the last thing in it — a user may keep their own hooks here.
    rmdir "$LEGACY_LOCAL_HOOKS" 2>/dev/null || true
  fi
  return 0
}

cmd_install() {
  local scope="local" want=""
  WITH_CLAUDE_MD=false
  local no_bonsai=false
  for arg in "$@"; do
    case "$arg" in
      global|--global) scope="global" ;;
      --claude-md)     WITH_CLAUDE_MD=true ;;
      --no-bonsai)     no_bonsai=true ;;
      --dry-run)       DRY_RUN=true ;;
      -*)              printf 'Unknown option: %s\n' "$arg"; return 1 ;;
      *)               want="$want $arg" ;;
    esac
  done

  local repo; repo=$(_repo_root) || { printf 'Cannot locate the aether clone.\n'; return 1; }
  _dry && printf '\n[dry-run] nothing below is written.\n'
  local targets; targets=$(_plugins_available)
  [ -n "$want" ] && targets="$want"

  local settings; settings=$(_settings "$scope")
  if ! _dry; then
    mkdir -p "$(dirname "$settings")"
    [ -f "$settings" ] || printf '{}\n' > "$settings"
    _backup "$settings"
  fi

  # Per-plugin PreToolUse hooks are superseded by enforce-suite.sh.
  _json_remove_stale_hooks "$settings" || true

  # Before anything is written, so the install lands on the new layout rather
  # than beside a half-migrated old one.
  _migrate_layout "$scope"

  printf '\nInstalling from %s ...\n' "$repo"
  local installed="" failed=0 p
  for p in $targets; do
    [ "$p" = bonsai ] && [ "$no_bonsai" = true ] && { printf '  bonsai: skipped (--no-bonsai)\n'; continue; }
    if _engine_install "$p" "$scope" 1; then
      installed="$installed $p"
      [ -n "$(_mf "$p" mcp.bonsai-py.command)" ] && _json_mcp_sync "$p" "$repo/plugins/$p" add || true
    else
      # 2 means "prerequisites missing, skipped" — not a failure.
      [ $? -eq 2 ] || failed=1
    fi
  done
  _json_remove_stale_hooks "$settings" || true

  # Suite hook and the gates it sources.
  printf '\nInstalling suite hook...\n'
  local hookdir; hookdir=$(_hook_dir "$scope")
  local gates;   gates=$(_gates_dir "$scope")
  _dry || mkdir -p "$hookdir" "$gates"
  _op_copy "$repo/hooks/enforce-suite.sh" "$hookdir/enforce-suite.sh"
  rm -f "$gates"/enforce-*.sh 2>/dev/null || true
  for p in $installed; do
    local g="$repo/plugins/$p/hooks/enforce-$p.sh"
    [ -f "$g" ] && _op_copy "$g" "$gates/enforce-$p.sh"
  done
  local _n=0 _g
  for _g in "$gates"/enforce-*.sh; do [ -f "$_g" ] && _n=$((_n + 1)); done
  _ok "$(printf '%s gates installed' "$_n")"
  _json_register_suite_hook "$settings" "$hookdir/enforce-suite.sh" \
    && _ok 'PreToolUse hook registered'
  # Now, and only now, is it safe to delete the hook the old layout was using.
  _retire_legacy_hooks "$scope"
  # …and to deregister anything still pointing at it, in either phase.
  if [ "$scope" = global ]; then
    _json_drop_hooks_matching "$settings" "$LEGACY_HOOK_DIR/" || true
  else
    _json_drop_hooks_matching "$settings" "$LEGACY_LOCAL_HOOKS/" || true
  fi

  # The config reader the gates source. They run from <root>/hooks/gates/ and
  # cannot reach into the clone, so the reader is installed beside them —
  # the same reason the gates themselves are copied rather than sourced in place.
  _op_copy "$repo/hooks/aether-config.sh" "$hookdir/aether-config.sh"

  # Permissions, aggregated from the manifests of what actually installed.
  local add="Bash Read Write" drop=""
  for p in $installed; do add="$add $(_mf "$p" permissions)"; done
  # Cleanup is unconditional: a stale permission outlives the plugin that wrote
  # it, so scoping this to what installed *this run* would strand it forever.
  for p in $(_plugins_available); do drop="$drop $(_mf "$p" legacy_permissions)"; done
  _json_sync_perms "$settings" "$add" "$drop" && _ok 'permissions synced'

  _op_copy "$repo/bin/aether" "$(_cli_dir "$scope")/aether"
  _ok 'aether CLI installed'

  # A first config with every key present but commented out at its default, so
  # "what can I put here?" is answered by the file itself. Never overwrites one.
  if [ ! -f "$(_cfg_file "$scope")" ]; then
    _seed_config "$(_cfg_file "$scope")"
    _dry || printf '  ✓ starter config written to %s\n' "$(_cfg_file "$scope")"
  fi

  if [ "$WITH_CLAUDE_MD" = true ]; then
    _backup "$(_claude_md "$scope")"
    for p in $(_plugins_available); do
      _op_unsplice "$(_claude_md "$scope")" "$(_mf "$p" template.sentinel)" >/dev/null 2>&1 || true
    done
    _op_splice "$(_claude_md "$scope")" aether "$repo/templates/CLAUDE.md" nowrap
    _ok 'aether CLAUDE.md block written'
  fi

  local shipped=""
  for p in $installed; do shipped="$shipped $(_mf "$p" commands)"; done
  local mf; mf=$(_manifest_for "$scope")
  if _dry; then
    printf '\n[dry-run] complete. Run without --dry-run to apply.\n'; return 0
  fi
  mkdir -p "$(dirname "$mf")"
  cat > "$mf" <<MEOF
version=$VERSION
scope=$scope
hook=$hookdir/enforce-suite.sh
gates=$gates
repo=$repo
claude_md=$WITH_CLAUDE_MD
plugins=$(echo $installed)
commands=$(echo $shipped)
MEOF
  printf '\n  ✓ manifest written to %s\n' "$mf"
  [ "$failed" -eq 0 ] || { printf '\naether installed with errors.\n'; return 1; }
  printf '\naether v%s installed (%s). Restart Claude Code to activate.\n' "$VERSION" "$scope"
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  install)   cmd_install "$@" ;;
  status)    case "${1:-}" in
               --notes) cmd_status_notes ;;
               *)       cmd_status ;;
             esac ;;
  hook)      cmd_hook "$@" ;;
  enable)    cmd_enable "$@" ;;
  disable)   cmd_disable "$@" ;;
  config)    cmd_config "$@" ;;
  doctor)    cmd_doctor "$@" ;;
  docs)      cmd_docs "$@" ;;
  check)     cmd_check "$@" ;;
  plan)      cmd_plan "$@" ;;
  project)   cmd_project "$@" ;;
  trust)     cmd_trust "$@" ;;
  rules)     aether_rules ;;
  migrate)   for _s in global local; do _migrate_layout "$_s"; _retire_legacy_hooks "$_s"; done
             printf 'Migration complete.\n' ;;
  update)    cmd_update ;;
  version|--version|-V) cmd_version ;;
  uninstall) cmd_uninstall "$@" ;;
  help|--help|-h) usage ;;
  *)
    # `aether cairn status` — the shims exec this, so one implementation serves
    # both `cairn status` and `aether cairn status`.
    if _plugins_available 2>/dev/null | grep -qx "$COMMAND"; then
      _PLUGIN="$COMMAND"; sub="${1:-status}"; shift || true
      case "$sub" in
        status)    cmd_status "$_PLUGIN" ;;
        enable)    cmd_enable "$@" ;;
        disable)   cmd_disable "$@" ;;
        install)   cmd_install "$_PLUGIN" "$@" ;;
        uninstall) cmd_uninstall "$_PLUGIN" "$@" ;;
        # Updating one plugin means reinstalling it from the clone, which also
        # prunes any command file it no longer ships. `aether update` (no
        # plugin) is the suite-level git pull.
        #
        # The recorded scope is passed explicitly. Defaulting to local meant
        # `cairn update` run from any directory quietly performed a *local*
        # install there — the same scope-inheritance bug that hit
        # `aether uninstall` and the three plugin updates before it.
        update)    cmd_install "$_PLUGIN" "$(_manifest_get scope)" "$@" ;;
        hook)      cmd_hook "$@" "$_PLUGIN" ;;
        # `temper config set auto_nudge_lines 300` used to reach `cmd_config show` with
        # the rest as trailing arguments, which ignores them — so it printed the config
        # and exited 0 having changed nothing. Forward the subcommand instead, and
        # namespace the key, since the shim exists precisely so you do not have to know
        # which section a key lives in.
        config)
          _csub="${1:-show}"
          case "$_csub" in
            show|'')
              shift 2>/dev/null || true
              cmd_config show "$(_mf "$_PLUGIN" config_section || printf '%s' "$_PLUGIN")" "$@" ;;
            doctor|path|edit)
              # Not section-scoped — these answer for the whole config file.
              shift; cmd_config "$_csub" "$@" ;;
            get|explain|set|unset)
              shift
              _ckey="${1:-}"
              if [ -z "$_ckey" ]; then
                printf 'Usage: %s config %s <key> %s\n' "$_PLUGIN" "$_csub" \
                  "$([ "$_csub" = set ] && printf '<value> ' )[global]"
                exit 1
              fi
              shift
              # A key given fully qualified is passed through: prefixing again would
              # write temper.temper.auto_nudge_lines.
              if _is_known_section "$(_split_key "$_ckey" | cut -d' ' -f1)"; then
                cmd_config "$_csub" "$_ckey" "$@"
              else
                cmd_config "$_csub" "$(_plugin_section_for "$_PLUGIN" "$_ckey").$_ckey" "$@"
              fi ;;
            *)
              printf 'Unknown %s config subcommand: %s\n\n' "$_PLUGIN" "$_csub"
              printf 'Try: show, get, set, unset, explain, doctor, path, edit\n'
              exit 1 ;;
          esac ;;
        help|--help|-h) usage ;;
        *) printf 'Unknown %s subcommand: %s\n' "$_PLUGIN" "$sub"; exit 1 ;;
      esac
      exit $?
    fi
    printf 'Unknown command: %s\n\n' "$COMMAND"; usage; exit 1 ;;
esac
