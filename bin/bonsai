#!/usr/bin/env bash
set -e

# Resolve symlinks to find the actual repo root.
SELF="${BASH_SOURCE[0]}"
if [ -L "$SELF" ]; then
  SELF="$(readlink "$SELF")"
fi
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

NUDGE_PROMPT="$(cat "$REPO_ROOT/templates/bash_nudge_prompt.txt")"

usage() {
  cat <<EOF
Usage: bonsai <command> [options]

Commands:
  install    [--claude-md] [--published]   Install bonsai MCP servers and hooks
  uninstall  [--claude-md]                 Remove bonsai installation
  status                                   Show installation status
  enable-hook                              Enable the Bash nudge hook
  disable-hook                             Disable the Bash nudge hook
  update     [--claude-md] [--published]   Rebuild servers and reinstall
  help                                     Show this help message

Options:
  --claude-md   Inject/remove bonsai guidance in ~/.claude/CLAUDE.md
  --published   Use published packages (uvx bonsai-py / npx bonsai-ts)
                instead of local build — use this once packages are on PyPI/npm
EOF
}

cmd_status() {
  echo "Bonsai installation status"
  echo ""

  python3 - <<'PYEOF'
import json, os

RESET = "\033[0m"
GREEN = "\033[32m"
RED   = "\033[31m"
DIM   = "\033[2m"

def ok(msg):   print(f"  {GREEN}✓{RESET} {msg}")
def fail(msg): print(f"  {RED}✗{RESET} {msg}")
def dim(msg):  print(f"  {DIM}-{RESET} {msg}")

# ~/.claude.json MCP servers
claude_json_path = os.path.expanduser("~/.claude.json")
data = {}
if os.path.exists(claude_json_path):
    try:
        with open(claude_json_path) as f:
            data = json.load(f)
    except json.JSONDecodeError:
        pass

servers = data.get("mcpServers", {})
for key in ["bonsai-py", "bonsai-ts"]:
    if key in servers:
        ok(f"MCP server registered: {key}")
    else:
        fail(f"MCP server not registered: {key}  (run: bonsai install)")

# ~/.claude/settings.json permissions + hooks
settings_path = os.path.expanduser("~/.claude/settings.json")
settings = {}
if os.path.exists(settings_path):
    try:
        with open(settings_path) as f:
            settings = json.load(f)
    except json.JSONDecodeError:
        pass

allow = settings.get("permissions", {}).get("allow", [])
for perm in ["mcp__bonsai_py__*", "mcp__bonsai_ts__*"]:
    if perm in allow:
        ok(f"Permission granted: {perm}")
    else:
        fail(f"Permission missing: {perm}  (run: bonsai install)")

pre = settings.get("hooks", {}).get("PreToolUse", [])
has_hook = any(
    h.get("matcher") == "Bash" and
    any("bonsai AST tool" in hook.get("prompt", "") for hook in h.get("hooks", []))
    for h in pre
)
if has_hook:
    ok("Bash nudge hook  [enabled]   (run: bonsai disable-hook to turn off)")
else:
    dim("Bash nudge hook  [disabled]  (run: bonsai enable-hook to turn on)")

# Skills
skills_dir = os.path.expanduser("~/.claude/skills/bonsai-first")
if os.path.isdir(skills_dir):
    ok("Skill installed: bonsai-first")
else:
    fail("Skill not installed: bonsai-first  (run: bonsai install)")

# CLI binary
cli_path = os.path.expanduser("~/.local/bin/bonsai")
if os.path.exists(cli_path):
    ok(f"CLI binary: {cli_path}")
else:
    fail(f"CLI binary not found: {cli_path}  (run: bonsai install)")

# CLAUDE.md section
claude_md_path = os.path.expanduser("~/.claude/CLAUDE.md")
if os.path.exists(claude_md_path) and "<!-- bonsai:start -->" in open(claude_md_path).read():
    ok("~/.claude/CLAUDE.md section present")
else:
    dim("~/.claude/CLAUDE.md section absent  (run: bonsai install --claude-md)")
PYEOF
}

cmd_enable() {
  python3 - "$NUDGE_PROMPT" <<'PYEOF'
import json, os, sys

nudge = sys.argv[1]
settings_path = os.path.expanduser("~/.claude/settings.json")
settings = {}
if os.path.exists(settings_path):
    try:
        with open(settings_path) as f:
            settings = json.load(f)
    except json.JSONDecodeError:
        pass

pre = settings.setdefault("hooks", {}).setdefault("PreToolUse", [])
already = any(
    h.get("matcher") == "Bash" and
    any("bonsai AST tool" in hook.get("prompt", "") for hook in h.get("hooks", []))
    for h in pre
)
if already:
    print("Bash nudge hook is already enabled.")
else:
    pre.append({"matcher": "Bash", "hooks": [{"type": "prompt", "prompt": nudge}]})
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    tmp = settings_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    os.replace(tmp, settings_path)
    print("✓ Bash nudge hook enabled. Restart Claude Code to apply.")
PYEOF
}

cmd_disable() {
  python3 - <<'PYEOF'
import json, os

settings_path = os.path.expanduser("~/.claude/settings.json")
if not os.path.exists(settings_path):
    print("~/.claude/settings.json not found — nothing to disable.")
    exit(0)

try:
    with open(settings_path) as f:
        settings = json.load(f)
except json.JSONDecodeError:
    print("~/.claude/settings.json unreadable — skipping.")
    exit(0)

pre = settings.get("hooks", {}).get("PreToolUse", [])
before = len(pre)
settings.setdefault("hooks", {})["PreToolUse"] = [
    h for h in pre
    if not (
        h.get("matcher") == "Bash" and
        any("bonsai AST tool" in hook.get("prompt", "") for hook in h.get("hooks", []))
    )
]
removed = before - len(settings["hooks"]["PreToolUse"])

tmp = settings_path + ".tmp"
with open(tmp, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
os.replace(tmp, settings_path)

if removed:
    print("✓ Bash nudge hook disabled. Restart Claude Code to apply.")
else:
    print("Bash nudge hook was not enabled.")
PYEOF
}

case "${1:-help}" in
  install)
    exec "$REPO_ROOT/install.sh" "${@:2}"
    ;;
  uninstall)
    exec "$REPO_ROOT/uninstall.sh" "${@:2}"
    ;;
  status)
    cmd_status
    ;;
  enable-hook)
    cmd_enable
    ;;
  disable-hook)
    cmd_disable
    ;;
  update)
    echo "==> Rebuilding and reinstalling bonsai"
    exec "$REPO_ROOT/install.sh" "${@:2}"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $1"
    echo ""
    usage
    exit 1
    ;;
esac
