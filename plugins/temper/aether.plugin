# temper — plugin manifest.  See plugins/cairn/aether.plugin for the format.

name: temper
description: Critiques diffs and PRs before they land — five critics, severity-rated
stage: review
scopes: local global
config_section: temper

# ── Skills ───────────────────────────────────────────────────────────────────
skills: sync-docs

commands: critique-diff.md critique-pr.md
legacy_commands: temper.md

# temper has no PostToolUse hook. Its gate is inserted at the front of the
# PreToolUse list so it fires before cairn's on a git commit.
hook.1: PreToolUse | Bash | hooks/enforce-temper.sh | suite_owned prepend

cli: temper
cli.strategy: copy
cli.scopes: global

permissions: Read Write Bash

template: templates/CLAUDE.md
template.sentinel: temper
template.has_own_sentinels: true

# ── Config schema ────────────────────────────────────────────────────────────

config.enabled.default: true
config.enabled.type: bool
config.enabled.doc: Whether temper's gate and commands run at all
config.enabled.used_by: /critique-diff /critique-pr

config.critics.default: correctness, design, risk, coverage, docs
config.critics.doc: Which critics run by default — correctness, design, risk, coverage, docs
config.critics.used_by: /critique-diff /critique-pr

config.skip.default:
config.skip.doc: Critics to omit from the default set
config.skip.used_by: /critique-diff /critique-pr

config.severity.default: red, yellow, green
config.severity.doc: Which severities get reported
config.severity.used_by: /critique-diff /critique-pr

config.diff.default: staged
config.diff.type: enum:staged,unstaged,all
config.diff.doc: What /critique-diff reviews when no --diff flag is given
config.diff.used_by: /critique-diff

config.auto_nudge_lines.default: 200
config.auto_nudge_lines.type: int
config.auto_nudge_lines.doc: Nudge before a commit whose staged diff exceeds this many lines
config.auto_nudge_lines.used_by: enforce-temper.sh

config.auto_nudge_files.default: 10
config.auto_nudge_files.type: int
config.auto_nudge_files.doc: Same, for number of files changed
config.auto_nudge_files.used_by: enforce-temper.sh

config.critical_paths.default: *auth*|*permission*|*token*|migrations/|*alembic*|\.sql|*schema*|*secret*|*credential*|\.env
config.strict.default: off
config.strict.type: enum:off,blocks
config.strict.doc: Escalate temper's blocking verdicts to a permission prompt the agent cannot answer — read from ~/.aether/config only
config.strict.used_by: enforce-suite.sh

config.critical_paths.type: patternlist
config.critical_paths.doc: Pipe-separated patterns that always trigger a review nudge, whatever the diff size
config.critical_paths.used_by: enforce-temper.sh

# ── [project] — commands the critics execute ────────────────────────────────
# Declared here rather than in a suite-wide schema file because temper's critics
# are what run them. `section:` puts the key in [project] instead of [temper].
# Nothing here runs until the project is trusted.
#
# A monorepo declares one `[project:<path>]` area per toolchain, and every key below
# applies to an area exactly as it does to the root. Command keys — everything with
# `type: command` — are NOT inherited from `[project]` by an area, because a command
# written for the repo root has no correct meaning inside a subdirectory. Non-command
# keys such as coverage_min do inherit.
#
# `check.<name>` is an additional command key an area may set for a project-specific
# invariant that fits none of the six below — a lockfile check, a single-migration-head
# check. It has no declaration here because the name is the user's; `aether check`
# runs it and reports it under that name.

config.test.section: project
config.test.default:
config.test.type: command
config.test.doc: Shell command that runs the test suite — lets Coverage report real failures instead of inferring from the diff
config.test.used_by: /critique-diff /critique-pr

config.lint.section: project
config.lint.default:
config.lint.type: command
config.lint.doc: Linter command — lets Correctness report actual violations rather than eyeballing style
config.lint.used_by: /critique-diff /critique-pr

config.format.section: project
config.format.default:
config.format.type: command
config.format.doc: Formatter check command, e.g. `ruff format --check`
config.format.used_by: /critique-diff /critique-pr

config.typecheck.section: project
config.typecheck.default:
config.typecheck.type: command
config.typecheck.doc: Type checker command, run against the changed files
config.typecheck.used_by: /critique-diff /critique-pr

config.build.section: project
config.build.default:
config.build.type: command
config.build.doc: Build command — lets /critique-pr confirm the branch still builds
config.build.used_by: /critique-pr

config.coverage.section: project
config.coverage.default:
config.coverage.type: command
config.coverage.doc: Command printing a coverage percentage
config.coverage.used_by: /critique-diff /critique-pr

config.coverage_min.section: project
config.coverage_min.default:
config.coverage_min.type: int
config.coverage_min.doc: Fail Coverage below this percentage, instead of leaving it to judgement
config.coverage_min.used_by: /critique-diff /critique-pr

# ── [docs] — what `aether docs` reads ────────────────────────────────────────
# Its own section rather than keys under [temper], the same way cairn declares
# [git]: these describe the repository's documentation, not temper's behaviour,
# and `aether docs` is an engine command that runs with or without temper's gate.

# No `enabled` key here: the manifest format identifies a key by name alone, so a
# second `config.enabled.*` would collide with temper's own and win at random.
# Setting `paths:` to nothing is how you turn the check off, which is one concept
# rather than two that can disagree.

config.paths.section: docs
config.paths.default: *.md docs
config.paths.type: pathlist
config.paths.doc: Space-separated files, globs and directories to check — directories are searched for *.md
config.paths.used_by: aether docs

config.ignore.section: docs
config.ignore.default: CHANGELOG.md
config.ignore.type: pathlist
config.ignore.doc: Paths to skip — a changelog is supposed to describe old behaviour, so it is excluded by default
config.ignore.used_by: aether docs

# ── Critics ──────────────────────────────────────────────────────────────────
