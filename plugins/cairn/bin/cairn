#!/bin/bash
# cairn — thin shim over the aether CLI.
#
# Every subcommand this used to implement (status, enable, disable, config,
# update, uninstall) now lives once in bin/aether. The four plugin CLIs were
# near-identical: cmd_enable, cmd_disable, cmd_config_reset and cmd_update were
# byte-identical across three of them, and config_get differed only by a missing
# `| head -1` in two — so a duplicated config key resolved to a multi-line
# value in cairn and whetstone but a single line in temper.
set -e
_here="$(cd "$(dirname "$0")" && pwd -P)"

# Resolution order matters. Installed, aether sits beside this shim; run out of
# the clone, it is at the repo root. Only then fall back to PATH — otherwise a
# shim executed from a checkout would defer to whatever version happens to be
# installed globally, which is how this shim silently did nothing under test.
for _a in "$_here/aether" "$_here/../../../bin/aether"; do
  [ -x "$_a" ] && exec "$_a" cairn "$@"
done
command -v aether >/dev/null 2>&1 && exec aether cairn "$@"

printf 'aether is not installed, but %s needs it.\n' "cairn" >&2
printf '  Re-run:  bash <your-aether-clone>/install.sh --global\n' >&2
exit 1
