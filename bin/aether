#!/bin/bash
set -e

VERSION="1.0.0"

GLOBAL_HOOK_DIR="$HOME/.local/share/aether"
GLOBAL_HOOK="$GLOBAL_HOOK_DIR/enforce-suite.sh"
GLOBAL_GATES="$GLOBAL_HOOK_DIR/gates"
GLOBAL_SETTINGS="$HOME/.claude/settings.json"
GLOBAL_MANIFEST="$HOME/.claude/aether.manifest"
LOCAL_MANIFEST=".claude/aether.manifest"

# Fallback only. The live list comes from _plugins_available(), which reads the
# manifests, so a new plugin appears in `aether status` by existing.
PLUGINS="bonsai whetstone temper cairn"

usage() {
  cat << 'EOF'
aether — manage your aether suite install

Usage:
  aether install [plugin...] [global] [--claude-md] [--no-bonsai]
                                        Install the suite, or named plugins
  aether status                         Show install state for all plugins
  aether enable  [local|global]         Enable all plugins (default: local)
  aether disable [local|global]         Disable all plugins
  aether update                         git pull the clone and re-run its installer
  aether version                        Print the installed version
  aether uninstall [global] [--claude-md]  Remove suite hook, CLI, optional CLAUDE.md block
  aether help                           Show this message

Examples:
  aether status
  aether disable global
  aether enable local
  aether uninstall global --claude-md
EOF
}

_config_get() {
  local file="$1" key="$2"
  [ -f "$file" ] && grep "^$key:" "$file" | sed "s/^$key: *//" | head -1 || true
}

_config_set() {
  local file="$1" key="$2" value="$3"
  if [ -f "$file" ] && grep -q "^$key:" "$file"; then
    awk -v k="$key" -v v="$value" '$0 ~ "^"k":" {print k": "v; next} {print}' \
      "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  else
    mkdir -p "$(dirname "$file")"
    printf '%s: %s\n' "$key" "$value" >> "$file"
  fi
}

_hook_registered() {
  [ -f "$GLOBAL_SETTINGS" ] && grep -q "enforce-suite" "$GLOBAL_SETTINGS" 2>/dev/null
}

_manifest_get() {
  local key="$1"
  local manifest=""
  [ -f "$GLOBAL_MANIFEST" ] && manifest="$GLOBAL_MANIFEST"
  [ -f "$LOCAL_MANIFEST"  ] && manifest="$LOCAL_MANIFEST"
  [ -z "$manifest" ] && return 0
  grep "^$key=" "$manifest" | sed "s/^$key=//" | head -1 || true
}

# ═══════════════════════════════════════════════════════════════════════════
# ENGINE
#
# One implementation of install and uninstall, driven by plugins/<name>/
# aether.plugin. Replaces five installers and five uninstallers that expressed
# the same five operations — copy a file, copy a tree, symlink, upsert a JSON
# key, splice a sentinel block — over per-plugin data.
#
# Uninstall reads the same manifest in reverse, which is what makes the
# install/uninstall asymmetries structurally impossible rather than merely
# fixed. Four had drifted: temper's uninstaller never removed its commands,
# cairn's never removed its permissions.
# ═══════════════════════════════════════════════════════════════════════════

# ── Where the clone is ───────────────────────────────────────────────────────
# Running from the clone (install.sh execs us) the repo is two levels up.
# Running installed, the manifest recorded it.
_repo_root() {
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  if [ -d "$here/../plugins" ]; then
    (cd "$here/.." && pwd -P); return 0
  fi
  local recorded; recorded=$(_manifest_get "repo") || recorded=""
  [ -n "$recorded" ] && [ -d "$recorded/plugins" ] && { printf '%s' "$recorded"; return 0; }
  return 1
}

# ── Manifest reader ──────────────────────────────────────────────────────────
# Plain grep/sed, deliberately: no python3, node or jq is needed to work out
# what to install. Only the settings.json steps need an interpreter, which is
# the same degradation the hand-written installers had.
_mf() {
  local plugin="$1" key="$2" repo
  repo=$(_repo_root) || return 1
  local f="$repo/plugins/$plugin/aether.plugin"
  [ -f "$f" ] || return 1
  grep "^$key:" "$f" | head -1 | sed "s/^$key: *//" || true
}

# Every plugin with a manifest in the clone. Replaces the hardcoded
# PLUGINS="bonsai whetstone temper cairn", so a new plugin appears in
# `aether status` by existing.
_plugins_available() {
  local repo; repo=$(_repo_root) || return 0
  local d
  for d in "$repo"/plugins/*/aether.plugin; do
    [ -f "$d" ] || continue
    basename "$(dirname "$d")"
  done
}

# ── Scope resolver ───────────────────────────────────────────────────────────
# The single place a scope becomes a path. Scope handling was got wrong twice
# in the previous release — `aether uninstall` and all three plugin `update`s —
# because every call site re-derived these by hand.
_root()         { [ "$1" = global ] && printf '%s' "${AETHER_HOME:-$HOME/.local/share/aether}" || printf '.claude/hooks'; }
_claude_dir()   { [ "$1" = global ] && printf '%s' "$HOME/.claude"        || printf '.claude'; }
_commands_dir() { printf '%s/commands' "$(_claude_dir "$1")"; }
_settings()     { printf '%s/settings.json' "$(_claude_dir "$1")"; }
_claude_md()    { [ "$1" = global ] && printf '%s' "$HOME/.claude/CLAUDE.md" || printf './CLAUDE.md'; }
_cli_dir()      { [ "$1" = global ] && printf '%s' "$HOME/.local/bin"     || printf '.bin'; }
_manifest_for() { [ "$1" = global ] && printf '%s' "$GLOBAL_MANIFEST"     || printf '%s' "$LOCAL_MANIFEST"; }
_gates_dir()    { printf '%s/gates' "$(_root "$1")"; }

# ── Primitives ───────────────────────────────────────────────────────────────
# Non-fatal by design. These run under `set -e`, partway through an install; a
# single unwritable file must not abort and leave a half-configured machine.

_op_copy() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")" 2>/dev/null || true
  if cp "$src" "$dst" 2>/dev/null; then
    [ -x "$src" ] && chmod +x "$dst" 2>/dev/null || true
    return 0
  fi
  printf '  ! could not write %s\n' "$dst"; return 1
}

_op_copy_tree() {
  local src="$1" dst="$2"
  mkdir -p "$dst" 2>/dev/null || true
  if command -v rsync >/dev/null 2>&1; then
    rsync -r "$src/" "$dst/" 2>/dev/null && return 0
  else
    cp -R "$src/." "$dst/" 2>/dev/null && return 0
  fi
  printf '  ! could not copy tree to %s\n' "$dst"; return 1
}

_op_link() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")" 2>/dev/null || true
  ln -sf "$src" "$dst" 2>/dev/null && return 0
  printf '  ! could not link %s\n' "$dst"; return 1
}

_op_rm() {
  local target="$1"
  [ -e "$target" ] || return 0
  rm -rf "$target" 2>/dev/null && { printf '  ✓ removed %s\n' "$target"; return 0; }
  printf '  ! could not remove %s\n' "$target"; return 1
}

# Splice a sentinel-delimited block into a markdown file, replacing any existing
# one. Replacing rather than skipping is what lets a template change reach an
# existing install — skipping froze the block at whatever version wrote it first.
_op_splice() {
  local file="$1" marker="$2" content_file="$3" wrap="$4"
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  [ -f "$file" ] || : > "$file"
  if grep -q "<!-- ${marker}:start -->" "$file" 2>/dev/null; then
    awk "/<!-- ${marker}:start -->/{skip=1} !skip{print} /<!-- ${marker}:end -->/{skip=0}" \
      "$file" > "$file.tmp" 2>/dev/null && mv "$file.tmp" "$file"
  fi
  {
    printf '\n'
    if [ "$wrap" = wrap ]; then
      printf '<!-- %s:start -->\n' "$marker"
      cat "$content_file"
      printf '<!-- %s:end -->\n' "$marker"
    else
      cat "$content_file"
    fi
  } >> "$file"
}

_op_unsplice() {
  local file="$1" marker="$2"
  [ -f "$file" ] || return 0
  grep -q "<!-- ${marker}:start -->" "$file" 2>/dev/null || return 0
  awk "/<!-- ${marker}:start -->/{skip=1} !skip{print} /<!-- ${marker}:end -->/{skip=0}" \
    "$file" > "$file.tmp" 2>/dev/null && mv "$file.tmp" "$file"
  printf '  ✓ removed %s block from %s\n' "$marker" "$file"
}

# ── Hook registration ────────────────────────────────────────────────────────
# Generalised from _json_register_suite_hook: any phase, any matcher. The old
# installers each had their own variant with the phase and matcher hardcoded,
# which is how cairn ended up with a python3-only _json_add_post_hook that
# silently never fired on a node-or-jq-only machine.
_json_register_hook() {
  local file="$1" phase="$2" matcher="$3" path="$4" prepend="${5:-}"
  command -v python3 >/dev/null 2>&1 || { command -v node >/dev/null 2>&1 || return 1; }
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$phase" "$matcher" "$path" "$prepend" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, phase, matcher, path, prepend = sys.argv[1:6]
with open(f) as fh: s = json.load(fh)
lst = s.setdefault("hooks", {}).setdefault(phase, [])
# Drop any previous registration of this exact script, whatever its matcher —
# a plugin that changes its matcher must not leave the old entry behind.
for e in lst:
    e["hooks"] = [h for h in e.get("hooks", []) if h.get("command") != path]
lst[:] = [e for e in lst if e.get("hooks")]
entry = next((e for e in lst if e.get("matcher") == matcher), None)
if entry is None:
    entry = {"matcher": matcher, "hooks": []}
    lst.insert(0, entry) if prepend else lst.append(entry)
entry["hooks"].append({"type": "command", "command": path})
print(json.dumps(s, indent=2))
PYEOF
  else
    node - "$file" "$phase" "$matcher" "$path" "$prepend" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, phase, matcher, path, prepend] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
s.hooks = s.hooks || {}; const lst = s.hooks[phase] = s.hooks[phase] || [];
for (const e of lst) e.hooks = (e.hooks || []).filter(h => h.command !== path);
s.hooks[phase] = lst.filter(e => e.hooks.length);
let entry = s.hooks[phase].find(e => e.matcher === matcher);
if (!entry) { entry = { matcher, hooks: [] }; prepend ? s.hooks[phase].unshift(entry) : s.hooks[phase].push(entry); }
entry.hooks.push({ type: "command", command: path });
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
  fi
}

_json_deregister_hook() {
  local file="$1" needle="$2"
  [ -f "$file" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$file" "$needle" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, needle = sys.argv[1], sys.argv[2]
with open(f) as fh: s = json.load(fh)
for phase in ("PreToolUse", "PostToolUse"):
    lst = s.get("hooks", {}).get(phase, [])
    for e in lst:
        e["hooks"] = [h for h in e.get("hooks", []) if needle not in h.get("command", "")]
    if phase in s.get("hooks", {}):
        s["hooks"][phase] = [e for e in lst if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
}

# Install and register every hook a manifest declares.
# A suite_owned hook is skipped under the suite: enforce-suite.sh sources that
# gate instead, so registering it too would double-fire every check.
_engine_hooks() {
  local plugin="$1" scope="$2" suite_mode="$3" proot="$4"
  local settings; settings=$(_settings "$scope")
  local hookdir;  hookdir="$(_root "$scope")/plugin-hooks"
  local strategy; strategy=$(_mf "$plugin" hooks.strategy); strategy="${strategy:-copy}"
  local n line
  for n in 1 2 3 4; do
    line=$(_mf "$plugin" "hook.$n") || true
    [ -n "$line" ] || continue
    # Split on " | ". The separator is a bracket expression, not \| — BSD awk
    # reads a backslash-escaped pipe in -F as alternation and returns five
    # fields instead of three. Spacing is variable in the manifests, so the
    # separator requires at least one space on each side: a matcher's escaped
    # pipes (Bash\|Write) have none, so they survive. The matcher keeps them until
    # the sed below unescapes them.
    local phase matcher script flags _fs=' +[|] +'
    phase=$(printf   '%s' "$line" | awk -v FS="$_fs" '{print $1}')
    matcher=$(printf '%s' "$line" | awk -v FS="$_fs" '{print $2}' | sed 's/\\|/|/g')
    script=$(printf  '%s' "$line" | awk -v FS="$_fs" '{print $3}')
    flags=$(printf   '%s' "$line" | awk -v FS="$_fs" '{print $4}')
    case " $flags " in *" suite_owned "*) [ "$suite_mode" = 1 ] && continue ;; esac
    local target
    if [ "$strategy" = link ]; then
      target="$proot/$script"
      chmod +x "$target" 2>/dev/null || true
    else
      target="$hookdir/$(basename "$script")"
      _op_copy "$proot/$script" "$target" || continue
    fi
    local prepend=""; case " $flags " in *" prepend "*) prepend=1 ;; esac
    _json_register_hook "$settings" "$phase" "$matcher" "$target" "$prepend" \
      && printf '  ✓ %s %s hook registered\n' "$plugin" "$phase"
  done
}

# ── Per-plugin install ───────────────────────────────────────────────────────
# suite_mode=1 means enforce-suite.sh will source this plugin's gate, so its own
# PreToolUse registration and its own CLAUDE.md block are both skipped.
_engine_install() {
  local plugin="$1" scope="$2" suite_mode="${3:-0}" repo
  repo=$(_repo_root) || { printf '  ✗ cannot locate the aether clone\n'; return 1; }
  local proot="$repo/plugins/$plugin"

  # Scope support — bonsai is global-only; every path it writes is $HOME-rooted.
  local scopes; scopes=$(_mf "$plugin" scopes)
  case " $scopes " in *" $scope "*) ;; *)
    printf '  %s: skipped — no %s scope\n' "$plugin" "$scope"; return 0 ;;
  esac

  # Prerequisites, before anything is written.
  local req; req=$(_mf "$plugin" requires)
  local missing=""
  for r in $req; do command -v "$r" >/dev/null 2>&1 || missing="$missing $r"; done
  if [ -n "$missing" ]; then
    printf '  %s: skipped — needs%s\n' "$plugin" "$missing"
    printf '          install them, then: aether install %s\n' "$plugin"
    return 2
  fi

  # Build.
  local build; build=$(_mf "$plugin" build)
  if [ -n "$build" ] && [ -f "$proot/$build" ]; then
    printf '  %s: building, this takes a minute...\n' "$plugin"
    bash "$proot/$build" >/dev/null 2>&1 || { printf '  ✗ %s build failed\n' "$plugin"; return 1; }
  fi

  local cdir; cdir=$(_commands_dir "$scope")
  local asset_failed=0

  # Commands, and the ones this plugin used to ship. An orphaned command file is
  # not inert: it stays in the palette and still runs the stale copy.
  local c
  for c in $(_mf "$plugin" legacy_commands); do
    [ -f "$cdir/$c" ] || continue
    cp "$cdir/$c" "$cdir/$c.bak" 2>/dev/null && _op_rm "$cdir/$c" >/dev/null \
      && printf '  ✓ removed superseded %s (kept a .bak)\n' "$cdir/$c" \
      || printf '  ! Could not remove superseded %s\n' "$cdir/$c"
  done
  for c in $(_mf "$plugin" commands); do
    _op_copy "$proot/.claude/commands/$c" "$cdir/$c" || asset_failed=1
  done

  # Skills.
  local s
  for s in $(_mf "$plugin" skills); do
    _op_copy_tree "$proot/skills/$s" "$(_claude_dir "$scope")/skills/$s" || true
  done

  # CLI.
  local cli; cli=$(_mf "$plugin" cli)
  if [ -n "$cli" ]; then
    local cli_scopes; cli_scopes=$(_mf "$plugin" cli.scopes); cli_scopes="${cli_scopes:-local global}"
    case " $cli_scopes " in *" $scope "*)
      if [ "$(_mf "$plugin" cli.strategy)" = link ]; then
        _op_link "$proot/bin/$cli" "$(_cli_dir "$scope")/$cli" || asset_failed=1
      else
        _op_copy "$proot/bin/$cli" "$(_cli_dir "$scope")/$cli" || asset_failed=1
      fi ;;
    esac
  fi

  # CLAUDE.md — skipped under the suite, whose unified block supersedes it.
  if [ "$suite_mode" = 0 ] && [ "${WITH_CLAUDE_MD:-false}" = true ]; then
    local tpl; tpl=$(_mf "$plugin" template)
    if [ -n "$tpl" ] && [ -f "$proot/$tpl" ]; then
      local wrap=nowrap
      [ "$(_mf "$plugin" template.has_own_sentinels)" = false ] && wrap=wrap
      _op_splice "$(_claude_md "$scope")" "$(_mf "$plugin" template.sentinel)" "$proot/$tpl" "$wrap"
      printf '  ✓ %s CLAUDE.md block written\n' "$plugin"
    fi
  fi

  _engine_hooks "$plugin" "$scope" "$suite_mode" "$proot"

  # A missing command file or CLI is a real failure, not a warning. The old
  # installers reported success unconditionally, which is how a total failure
  # still printed a green tick.
  if [ "$asset_failed" -ne 0 ]; then
    printf '  ✗ %s failed to install — an asset could not be written\n' "$plugin"
    return 1
  fi
  printf '  ✓ %s installed\n' "$plugin"
  return 0
}

# ── Per-plugin uninstall ─────────────────────────────────────────────────────
# Same manifest, read in reverse.
_engine_uninstall() {
  local plugin="$1" scope="$2" repo
  repo=$(_repo_root) || return 1
  local cdir; cdir=$(_commands_dir "$scope")
  local c

  for c in $(_mf "$plugin" commands) $(_mf "$plugin" legacy_commands); do
    _op_rm "$cdir/$c" >/dev/null 2>&1 && printf '  ✓ removed %s\n' "$cdir/$c"
  done
  for s in $(_mf "$plugin" skills); do
    _op_rm "$(_claude_dir "$scope")/skills/$s"
  done
  local cli; cli=$(_mf "$plugin" cli)
  [ -n "$cli" ] && _op_rm "$(_cli_dir "$scope")/$cli"
  _json_deregister_hook "$(_settings "$scope")" "enforce-$plugin.sh" 2>/dev/null || true
  _json_deregister_hook "$(_settings "$scope")" "post-$plugin.sh" 2>/dev/null || true
  _op_rm "$(_root "$scope")/plugin-hooks/enforce-$plugin.sh" >/dev/null 2>&1 || true
  _op_rm "$(_root "$scope")/plugin-hooks/post-$plugin.sh" >/dev/null 2>&1 || true

  local sentinel; sentinel=$(_mf "$plugin" template.sentinel)
  [ -n "$sentinel" ] && _op_unsplice "$(_claude_md "$scope")" "$sentinel"
  for sentinel in $(_mf "$plugin" template.legacy_sentinels); do
    _op_unsplice "$(_claude_md "$scope")" "$sentinel"
  done
  return 0
}

# ── settings.json helpers ────────────────────────────────────────────────────
# Ported verbatim from install.sh. _json_backend / AETHER_JSON_BACKEND is the
# only 3-interpreter chain in the suite with test coverage — the per-plugin
# installers each had their own, and cairn's was python3-only, so its
# PostToolUse hook silently never registered on a node-or-jq-only machine.

_backup() {
  local file="$1"
  [ -f "$file" ] || return 0
  cp "$file" "$file.bak"
}

_json_backend() {
  if [ -n "${AETHER_JSON_BACKEND:-}" ]; then printf '%s' "$AETHER_JSON_BACKEND"; return 0; fi
  if   command -v python3 &>/dev/null; then printf 'python3'
  elif command -v node    &>/dev/null; then printf 'node'
  elif command -v jq      &>/dev/null; then printf 'jq'
  else printf 'none'; fi
}

_json_remove_stale_hooks() {
  local file="$1"
  case "$(_json_backend)" in
   python3)
    python3 - "$file" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f = sys.argv[1]
with open(f) as fh: s = json.load(fh)
STALE = ["enforce-cairn", "enforce-temper", "enforce-whetstone",
         "enforce-bonsai", "enforce-suite"]
entries = s.get("hooks", {}).get("PreToolUse", [])
for entry in entries:
    entry["hooks"] = [
        h for h in entry.get("hooks", [])
        if not any(kw in h.get("command", "") for kw in STALE)
    ]
if "hooks" in s and "PreToolUse" in s["hooks"]:
    s["hooks"]["PreToolUse"] = [e for e in entries if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const f = process.argv[2];
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
const STALE = ["enforce-cairn", "enforce-temper", "enforce-whetstone",
               "enforce-bonsai", "enforce-suite"];
if (s.hooks && s.hooks.PreToolUse) {
  s.hooks.PreToolUse = s.hooks.PreToolUse
    .map(e => ({ ...e, hooks: (e.hooks || []).filter(
      h => !STALE.some(kw => (h.command || "").includes(kw))) }))
    .filter(e => e.hooks.length);
}
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
    ;;
   jq)
    jq '
      def stale: ["enforce-cairn","enforce-temper","enforce-whetstone","enforce-bonsai","enforce-suite"];
      if (.hooks.PreToolUse | type) == "array" then
        .hooks.PreToolUse |= (
          map(.hooks |= (map(select(.command as $c | (stale | any(. as $k | $c | contains($k))) | not))))
          | map(select((.hooks | length) > 0))
        )
      else . end
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *)
    printf '  Could not clean stale hooks (install python3, node, or jq).\n'
    return 1
    ;;
  esac
}

_json_register_suite_hook() {
  local file="$1" hook_path="$2"
  local matcher="Bash|Write|Edit|MultiEdit"
  case "$(_json_backend)" in
   python3)
    python3 - "$file" "$hook_path" "$matcher" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, hook_path, matcher = sys.argv[1], sys.argv[2], sys.argv[3]
with open(f) as fh: s = json.load(fh)
hooks = s.setdefault("hooks", {})
pre = hooks.setdefault("PreToolUse", [])
entry = next((e for e in pre if e.get("matcher") == matcher), None)
if entry is None:
    entry = {"matcher": matcher, "hooks": []}
    pre.append(entry)
if not any(h.get("command") == hook_path for h in entry["hooks"]):
    entry["hooks"].append({"type": "command", "command": hook_path})
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" "$hook_path" "$matcher" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, hookPath, matcher] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
s.hooks = s.hooks || {};
s.hooks.PreToolUse = s.hooks.PreToolUse || [];
let entry = s.hooks.PreToolUse.find(e => e.matcher === matcher);
if (!entry) { entry = { matcher, hooks: [] }; s.hooks.PreToolUse.push(entry); }
entry.hooks = entry.hooks || [];
if (!entry.hooks.some(h => h.command === hookPath)) {
    entry.hooks.push({ type: "command", command: hookPath });
}
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
    ;;
   jq)
    jq --arg p "$hook_path" --arg m "$matcher" '
      .hooks.PreToolUse |= (
        if . == null then [{"matcher":$m,"hooks":[{"type":"command","command":$p}]}]
        else
          if any(.[]; .matcher == $m) then
            map(if .matcher == $m then
              .hooks |= if any(.[]; .command == $p) then . else . + [{"type":"command","command":$p}] end
            else . end)
          else . + [{"matcher":$m,"hooks":[{"type":"command","command":$p}]}]
          end
        end
      )' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *)
    printf '  Could not register hook (install python3, node, or jq).\n'
    printf '  Add a PreToolUse hook pointing to %s manually.\n' "$hook_path"
    return 1
    ;;
  esac
}

# Permissions, aggregated from the manifests of the plugins actually installed,
# plus the suite's own. legacy_permissions are removed — bonsai's underscore
# spelling matched no tool, so the permission it granted was inert.
_json_sync_perms() {
  local file="$1" add="$2" drop="$3"
  case "$(_json_backend)" in
   python3)
    python3 - "$file" "$add" "$drop" <<'PYEOF' > "$file.tmp" && mv "$file.tmp" "$file"
import json, sys
f, add, drop = sys.argv[1], sys.argv[2].split(), sys.argv[3].split()
with open(f) as fh: s = json.load(fh)
allow = s.setdefault("permissions", {}).setdefault("allow", [])
for p in add:
    if p not in allow: allow.append(p)
for d in drop:
    while d in allow: allow.remove(d)
print(json.dumps(s, indent=2))
PYEOF
    ;;
   node)
    node - "$file" "$add" "$drop" <<'JSEOF' > "$file.tmp" && mv "$file.tmp" "$file"
const [f, add, drop] = process.argv.slice(2);
const s = JSON.parse(require("fs").readFileSync(f, "utf8"));
s.permissions = s.permissions || {};
s.permissions.allow = s.permissions.allow || [];
for (const p of add.split(/\s+/).filter(Boolean))
  if (!s.permissions.allow.includes(p)) s.permissions.allow.push(p);
const dead = new Set(drop.split(/\s+/).filter(Boolean));
s.permissions.allow = s.permissions.allow.filter(p => !dead.has(p));
process.stdout.write(JSON.stringify(s, null, 2) + "\n");
JSEOF
    ;;
   jq)
    jq --arg a "$add" --arg d "$drop" '
      .permissions.allow = (
        ((.permissions.allow // []) + ($a | split(" ") | map(select(. != ""))))
        | map(select(. as $p | ($d | split(" ") | index($p)) | not))
        | reduce .[] as $x ([]; if index($x) then . else . + [$x] end)
      )' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    ;;
   *)
    printf '  Could not update permissions (install python3, node, or jq).\n'
    return 1 ;;
  esac
}

cmd_status() {
  printf 'aether v%s\n\n' "$VERSION"

  for plugin in $PLUGINS; do
    local global_cfg="$HOME/.claude/${plugin}.config"
    local local_cfg="./${plugin}.config"
    local enabled_val=""

    [ -f "$global_cfg" ] && enabled_val=$(_config_get "$global_cfg" "enabled") || true
    [ -f "$local_cfg"  ] && {
      local lv; lv=$(_config_get "$local_cfg" "enabled")
      [ -n "$lv" ] && enabled_val="$lv"
    } || true

    local state="enabled"
    [ "$enabled_val" = "false" ] && state="disabled"

    local extra=""
    if [ "$plugin" = "bonsai" ]; then
      local has_py has_ts
      has_py=$(grep -l "bonsai-py" "$HOME/.claude.json" 2>/dev/null | wc -l | tr -d ' ') || has_py=0
      has_ts=$(grep -l "bonsai-ts" "$HOME/.claude.json" 2>/dev/null | wc -l | tr -d ' ') || has_ts=0
      [ "$has_py" -gt 0 ] && extra="  MCP: bonsai-py"
      [ "$has_ts" -gt 0 ] && extra="${extra} bonsai-ts"
    fi

    printf '  %-12s %s%s\n' "$plugin" "$state" "$extra"
  done

  printf '\n'

  if _hook_registered; then
    local scope
    scope=$(_manifest_get "scope") || scope=""
    printf '  Suite hook: enforce-suite.sh registered (%s)\n' "${scope:-global}"
  else
    printf '  Suite hook: NOT registered — run install.sh to fix\n'
  fi

  # The gates are what enforce-suite.sh actually sources, so an empty directory
  # means the hook is registered but silent. The hook itself ignores a gate that
  # fails to parse — it must never block a tool call — so this is the only place
  # a corrupt gate is reported.
  local gates_dir gate_count bad_gates
  gates_dir=$(_manifest_get "gates") || gates_dir=""
  gates_dir="${gates_dir:-$GLOBAL_GATES}"
  if [ -d "$gates_dir" ]; then
    gate_count=0; bad_gates=""
    for g in "$gates_dir"/enforce-*.sh; do
      [ -f "$g" ] || continue
      gate_count=$((gate_count + 1))
      bash -n "$g" 2>/dev/null || bad_gates="$bad_gates $(basename "$g")"
    done
    printf '  Gates:      %s loaded from %s\n' "$gate_count" "$gates_dir"
    if [ -n "$bad_gates" ]; then
      printf '              ✗ failed to parse and are being skipped:%s\n' "$bad_gates"
      printf '                re-run install.sh to restore them\n'
    fi
  else
    printf '  Gates:      none found at %s — run install.sh to fix\n' "$gates_dir"
  fi

  local repo
  repo=$(_manifest_get "repo") || repo=""
  if [ -n "$repo" ]; then
    if [ -d "$repo/.git" ]; then
      printf '  Clone:      %s\n' "$repo"
    else
      printf '  Clone:      %s (MISSING — aether update will not work)\n' "$repo"
    fi
  fi

  local manifest_version
  manifest_version=$(_manifest_get "version") || true
  [ -n "$manifest_version" ] && printf '  Installed version: %s\n' "$manifest_version"

  printf '\n'
}

cmd_enable() {
  local scope="${1:-local}"
  for plugin in $PLUGINS; do
    local target
    if [ "$scope" = "global" ]; then
      target="$HOME/.claude/${plugin}.config"
    else
      target="./${plugin}.config"
    fi
    _config_set "$target" "enabled" "true"
    printf '  ✓ %s enabled (%s)\n' "$plugin" "$target"
  done
}

cmd_disable() {
  local scope="${1:-local}"
  for plugin in $PLUGINS; do
    local target
    if [ "$scope" = "global" ]; then
      target="$HOME/.claude/${plugin}.config"
    else
      target="./${plugin}.config"
    fi
    _config_set "$target" "enabled" "false"
    printf '  ✓ %s disabled (%s)\n' "$plugin" "$target"
  done
}

# All four plugins now live in the aether clone, so updating is a git pull plus
# a re-run of the local installer — no per-plugin downloads, and the four
# plugins can never drift to different versions from each other.
cmd_update() {
  local repo scope scope_arg claude_md bonsai_arg
  repo=$(_manifest_get "repo") || repo=""

  if [ -z "$repo" ]; then
    printf 'Cannot locate the aether clone.\n'
    printf '  The install manifest has no repo= entry, so it predates aether 1.0.0.\n'
    printf '  Re-run install.sh from your clone once to record it.\n'
    return 1
  fi
  if [ ! -d "$repo/.git" ]; then
    printf 'The recorded clone is no longer there: %s\n' "$repo"
    printf '  Re-clone aether and run its install.sh.\n'
    return 1
  fi

  scope=$(_manifest_get "scope") || scope=""
  scope_arg=""; [ "$scope" = "global" ] && scope_arg="--global"
  claude_md=$(_manifest_get "claude_md") || claude_md=""
  [ "$claude_md" = "true" ] && claude_md="--claude-md" || claude_md=""
  bonsai_arg=""; [ "$(_manifest_get "bonsai")" = "false" ] && bonsai_arg="--no-bonsai"

  printf 'Updating aether from %s\n\n' "$repo"
  if ! git -C "$repo" pull --ff-only; then
    printf '\n  git pull failed. Resolve it in %s, then re-run aether update.\n' "$repo"
    return 1
  fi

  printf '\nRe-running the installer...\n\n'
  bash "$repo/install.sh" $scope_arg $claude_md $bonsai_arg
}

cmd_version() {
  local installed
  installed=$(_manifest_get "version") || installed=""
  printf 'aether %s (CLI)\n' "$VERSION"
  [ -n "$installed" ] && printf 'aether %s (installed)\n' "$installed"
  return 0
}

# ── aether hook enable|disable <plugin> ──────────────────────────────────────
# The suite had two disable models: `enable`/`disable` writes `enabled: false`
# to a config file the gate then reads, while bonsai's enable-hook/disable-hook
# deregistered the hook outright. Both are useful — one is a soft mute, the
# other stops the hook being invoked at all — so both exist, for every plugin.
cmd_hook() {
  local action="${1:-}" plugin="${2:-}" scope="${3:-global}"
  case "$action" in
    enable|disable) ;;
    *) printf 'Usage: aether hook enable|disable <plugin>\n'; return 1 ;;
  esac
  [ -n "$plugin" ] || { printf 'Which plugin?\n'; return 1; }
  local gates; gates=$(_gates_dir "$scope")
  local g="$gates/enforce-$plugin.sh"
  if [ "$action" = disable ]; then
    [ -f "$g" ] || { printf '  %s gate is already not installed\n' "$plugin"; return 0; }
    mv "$g" "$g.disabled" && printf '  ✓ %s gate disabled (enforce-suite.sh will skip it)\n' "$plugin"
  else
    if [ -f "$g.disabled" ]; then
      mv "$g.disabled" "$g" && printf '  ✓ %s gate re-enabled\n' "$plugin"
    else
      local repo; repo=$(_repo_root) || return 1
      _op_copy "$repo/plugins/$plugin/hooks/enforce-$plugin.sh" "$g" \
        && printf '  ✓ %s gate enabled\n' "$plugin"
    fi
  fi
}

cmd_uninstall() {
  local scope="local"
  local clean_claude_md=false
  local want=""

  for arg in "$@"; do
    case "$arg" in
      global|--global) scope="global" ;;
      --claude-md)     clean_claude_md=true ;;
      -*)              ;;
      *)               want="$want $arg" ;;
    esac
  done

  # Named plugins: remove just those, through the engine, leaving the suite in
  # place. `aether uninstall` with no plugin removes the suite itself, below.
  if [ -n "$want" ]; then
    local p
    for p in $want; do
      printf 'Removing %s (%s)...\n' "$p" "$scope"
      _engine_uninstall "$p" "$scope"
    done
    return 0
  fi

  # Every path below is derived from the scope. The hook, gates, CLI and
  # manifest paths used to be hardcoded to the global locations regardless of
  # it, so a local uninstall removed nothing it had installed — leaving
  # .claude/hooks/enforce-suite.sh, .claude/hooks/gates/ and .bin/aether behind
  # — while deleting the *global* manifest and breaking `aether update` for a
  # global install that had nothing to do with it.
  local settings_file claude_file manifest hook_file gates_dir cli_file
  if [ "$scope" = "global" ]; then
    settings_file="$GLOBAL_SETTINGS"
    claude_file="$HOME/.claude/CLAUDE.md"
    manifest="$GLOBAL_MANIFEST"
    hook_file="$GLOBAL_HOOK"
    gates_dir="$GLOBAL_GATES"
    cli_file="$HOME/.local/bin/aether"
  else
    settings_file=".claude/settings.json"
    claude_file="./CLAUDE.md"
    manifest="$LOCAL_MANIFEST"
    hook_file=".claude/hooks/enforce-suite.sh"
    gates_dir=".claude/hooks/gates"
    cli_file=".bin/aether"
  fi

  # The manifest records where the install actually put things, which beats
  # inferring it if a future install.sh changes its layout.
  if [ -f "$manifest" ]; then
    local recorded
    recorded=$(grep '^hook=' "$manifest" | sed 's/^hook=//' | head -1) || recorded=""
    [ -n "$recorded" ] && hook_file="$recorded"
    recorded=$(grep '^gates=' "$manifest" | sed 's/^gates=//' | head -1) || recorded=""
    [ -n "$recorded" ] && gates_dir="$recorded"
  fi

  # Remove the suite's own PreToolUse hook. The per-plugin PostToolUse hooks
  # (post-cairn, post-bonsai) belong to plugins that stay installed for
  # standalone use, so removing aether must not take them with it.
  if [ -f "$settings_file" ] && command -v python3 &>/dev/null; then
    cp "$settings_file" "$settings_file.bak"
    python3 - "$settings_file" <<'PYEOF' > "$settings_file.tmp" && mv "$settings_file.tmp" "$settings_file"
import json, sys
f = sys.argv[1]
with open(f) as fh: s = json.load(fh)
entries = s.get("hooks", {}).get("PreToolUse", [])
for entry in entries:
    entry["hooks"] = [
        h for h in entry.get("hooks", [])
        if "enforce-suite" not in h.get("command", "")
    ]
if "hooks" in s and "PreToolUse" in s["hooks"]:
    s["hooks"]["PreToolUse"] = [e for e in entries if e.get("hooks")]
print(json.dumps(s, indent=2))
PYEOF
    printf '  ✓ Removed enforce-suite.sh hook from %s\n' "$settings_file"
  fi

  # Remove aether CLI
  if [ -f "$cli_file" ]; then
    rm "$cli_file"
    printf '  ✓ Removed %s\n' "$cli_file"
  fi

  # Remove enforce-suite.sh and the gates it sources
  if [ -d "$gates_dir" ]; then
    rm -rf "$gates_dir"
    printf '  ✓ Removed %s\n' "$gates_dir"
  fi
  if [ -f "$hook_file" ]; then
    rm "$hook_file"
    printf '  ✓ Removed %s\n' "$hook_file"
  fi

  # Tidy up directories the install created, but only if nothing else is in
  # them — a local install shares .claude/hooks/ with anything the user put there.
  # plugin-hooks/ is created by the engine, so it is removed before its parent.
  rmdir "$(_root "$scope")/plugin-hooks" 2>/dev/null || true
  rmdir "$(dirname "$hook_file")" 2>/dev/null || true
  [ "$scope" = "global" ] || rmdir .bin 2>/dev/null || true

  # Remove CLAUDE.md block
  if [ "$clean_claude_md" = true ] && [ -f "$claude_file" ]; then
    for marker in "aether" "cairn" "temper" "whetstone" "bonsai"; do
      if grep -q "<!-- ${marker}:start -->" "$claude_file" 2>/dev/null; then
        awk "/<!-- ${marker}:start -->/{skip=1} !skip{print} /<!-- ${marker}:end -->/{skip=0}" \
          "$claude_file" > "$claude_file.tmp" && mv "$claude_file.tmp" "$claude_file"
        printf '  ✓ Removed %s section from %s\n' "$marker" "$claude_file"
      fi
    done
  fi

  # Remove the manifest for this scope only. Removing both meant a local
  # uninstall deleted the global install's record of its clone path, after
  # which `aether update` could no longer find the repository.
  if [ -f "$manifest" ]; then
    rm "$manifest"
    printf '  ✓ Removed %s\n' "$manifest"
  fi

  printf '\nPlugins (bonsai, whetstone, temper, cairn) remain installed for standalone use.\n'
  printf 'Restart Claude Code to apply changes.\n'
}

# MCP servers go in ~/.claude.json, not settings.json. Declared flat in the
# manifest as mcp.<name>.command / .args, with ${PLUGIN_ROOT} expanded here —
# which is why moving the clone breaks bonsai and nothing else.
_json_mcp_sync() {
  local plugin="$1" proot="$2" action="$3"
  command -v python3 >/dev/null 2>&1 || { printf '  ! MCP registration needs python3\n'; return 1; }
  local names spec=""
  names=$(grep -oE '^mcp\.[a-z-]+\.command:' "$proot/aether.plugin" 2>/dev/null \
          | sed 's/^mcp\.//;s/\.command:$//' | sort -u)
  [ -n "$names" ] || return 0
  local n
  for n in $names; do
    spec="$spec$n"$'\t'"$(_mf "$plugin" "mcp.$n.command")"$'\t'"$(_mf "$plugin" "mcp.$n.args" | sed "s|\${PLUGIN_ROOT}|$proot|g")"$'\n'
  done
  printf '%s' "$spec" | python3 - "$action" <<'PYEOF'
import json, os, sys
action = sys.argv[1]
path = os.path.expanduser("~/.claude.json")
data = {}
if os.path.exists(path):
    try:
        with open(path) as f: data = json.load(f)
    except json.JSONDecodeError:
        pass
servers = data.setdefault("mcpServers", {})
for line in sys.stdin.read().splitlines():
    if not line.strip(): continue
    name, cmd, args = line.split("\t", 2)
    if action == "remove":
        servers.pop(name, None)
    else:
        servers[name] = {"type": "stdio", "command": cmd, "args": args.split()}
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2); f.write("\n")
os.replace(tmp, path)
PYEOF
}

# ── aether install ───────────────────────────────────────────────────────────
cmd_install() {
  local scope="local" want=""
  WITH_CLAUDE_MD=false
  local no_bonsai=false
  for arg in "$@"; do
    case "$arg" in
      global|--global) scope="global" ;;
      --claude-md)     WITH_CLAUDE_MD=true ;;
      --no-bonsai)     no_bonsai=true ;;
      -*)              printf 'Unknown option: %s\n' "$arg"; return 1 ;;
      *)               want="$want $arg" ;;
    esac
  done

  local repo; repo=$(_repo_root) || { printf 'Cannot locate the aether clone.\n'; return 1; }
  local targets; targets=$(_plugins_available)
  [ -n "$want" ] && targets="$want"

  local settings; settings=$(_settings "$scope")
  mkdir -p "$(dirname "$settings")"
  [ -f "$settings" ] || printf '{}\n' > "$settings"
  _backup "$settings"

  # Per-plugin PreToolUse hooks are superseded by enforce-suite.sh.
  _json_remove_stale_hooks "$settings" || true

  printf '\nInstalling from %s ...\n' "$repo"
  local installed="" failed=0 p
  for p in $targets; do
    [ "$p" = bonsai ] && [ "$no_bonsai" = true ] && { printf '  bonsai: skipped (--no-bonsai)\n'; continue; }
    if _engine_install "$p" "$scope" 1; then
      installed="$installed $p"
      [ -n "$(_mf "$p" mcp.bonsai-py.command)" ] && _json_mcp_sync "$p" "$repo/plugins/$p" add || true
    else
      # 2 means "prerequisites missing, skipped" — not a failure.
      [ $? -eq 2 ] || failed=1
    fi
  done
  _json_remove_stale_hooks "$settings" || true

  # Suite hook and the gates it sources.
  printf '\nInstalling suite hook...\n'
  local hookdir; hookdir=$(_root "$scope")
  local gates;   gates=$(_gates_dir "$scope")
  mkdir -p "$hookdir" "$gates"
  _op_copy "$repo/hooks/enforce-suite.sh" "$hookdir/enforce-suite.sh"
  rm -f "$gates"/enforce-*.sh 2>/dev/null || true
  for p in $installed; do
    local g="$repo/plugins/$p/hooks/enforce-$p.sh"
    [ -f "$g" ] && _op_copy "$g" "$gates/enforce-$p.sh"
  done
  printf '  ✓ %s gates installed\n' "$(ls "$gates" 2>/dev/null | wc -l | tr -d ' ')"
  _json_register_suite_hook "$settings" "$hookdir/enforce-suite.sh" \
    && printf '  ✓ PreToolUse hook registered\n'

  # Permissions, aggregated from the manifests of what actually installed.
  local add="Bash Read Write" drop=""
  for p in $installed; do add="$add $(_mf "$p" permissions)"; done
  # Cleanup is unconditional: a stale permission outlives the plugin that wrote
  # it, so scoping this to what installed *this run* would strand it forever.
  for p in $(_plugins_available); do drop="$drop $(_mf "$p" legacy_permissions)"; done
  _json_sync_perms "$settings" "$add" "$drop" && printf '  ✓ permissions synced\n'

  _op_copy "$repo/bin/aether" "$(_cli_dir "$scope")/aether"
  printf '  ✓ aether CLI installed\n'

  if [ "$WITH_CLAUDE_MD" = true ]; then
    _backup "$(_claude_md "$scope")"
    for p in $(_plugins_available); do
      _op_unsplice "$(_claude_md "$scope")" "$(_mf "$p" template.sentinel)" >/dev/null 2>&1 || true
    done
    _op_splice "$(_claude_md "$scope")" aether "$repo/templates/CLAUDE.md" nowrap
    printf '  ✓ aether CLAUDE.md block written\n'
  fi

  local shipped=""
  for p in $installed; do shipped="$shipped $(_mf "$p" commands)"; done
  local mf; mf=$(_manifest_for "$scope"); mkdir -p "$(dirname "$mf")"
  cat > "$mf" <<MEOF
version=$VERSION
scope=$scope
hook=$hookdir/enforce-suite.sh
gates=$gates
repo=$repo
claude_md=$WITH_CLAUDE_MD
plugins=$(echo $installed)
commands=$(echo $shipped)
MEOF
  printf '\n  ✓ manifest written to %s\n' "$mf"
  [ "$failed" -eq 0 ] || { printf '\naether installed with errors.\n'; return 1; }
  printf '\naether v%s installed (%s). Restart Claude Code to activate.\n' "$VERSION" "$scope"
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  install)   cmd_install "$@" ;;
  status)    cmd_status ;;
  hook)      cmd_hook "$@" ;;
  enable)    cmd_enable "$@" ;;
  disable)   cmd_disable "$@" ;;
  update)    cmd_update ;;
  version|--version|-V) cmd_version ;;
  uninstall) cmd_uninstall "$@" ;;
  help|--help|-h) usage ;;
  *)
    # `aether cairn status` — the shims exec this, so one implementation serves
    # both `cairn status` and `aether cairn status`.
    if _plugins_available 2>/dev/null | grep -qx "$COMMAND"; then
      _PLUGIN="$COMMAND"; sub="${1:-status}"; shift || true
      case "$sub" in
        status)    cmd_status "$_PLUGIN" ;;
        enable)    cmd_enable "$@" ;;
        disable)   cmd_disable "$@" ;;
        install)   cmd_install "$_PLUGIN" "$@" ;;
        uninstall) cmd_uninstall "$_PLUGIN" "$@" ;;
        # Updating one plugin means reinstalling it from the clone, which also
        # prunes any command file it no longer ships. `aether update` (no
        # plugin) is the suite-level git pull.
        #
        # The recorded scope is passed explicitly. Defaulting to local meant
        # `cairn update` run from any directory quietly performed a *local*
        # install there — the same scope-inheritance bug that hit
        # `aether uninstall` and the three plugin updates before it.
        update)    cmd_install "$_PLUGIN" "$(_manifest_get scope)" "$@" ;;
        hook)      cmd_hook "$@" "$_PLUGIN" ;;
        help|--help|-h) usage ;;
        *) printf 'Unknown %s subcommand: %s\n' "$_PLUGIN" "$sub"; exit 1 ;;
      esac
      exit $?
    fi
    printf 'Unknown command: %s\n\n' "$COMMAND"; usage; exit 1 ;;
esac
